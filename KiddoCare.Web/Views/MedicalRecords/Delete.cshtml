@model KiddoCare.ViewModels.MedicalRecords.MedicalRecordDeleteViewModel

@{
    ViewData["Title"] = T["Delete Medical Record"];

    var cancelUrl = Url.Action(
        "Details",
        "MedicalRecords",
        new
        {
            childId = Model.ChildId,
            returnUrl = Model.ReturnUrl
        });
}

<section class="delete-page">
    <div class="delete-card">
        <div class="delete-kicker">@T["Permanent action"]</div>
        <h1>@T["Delete Medical Record"]</h1>
        <p>
            @T["Are you sure you want to delete the medical record for this child? This action cannot be undone."]
        </p>

        <dl class="info-list delete-info-list">
            <div>
                <dt>@T["Child"]</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-action-row justify-content-center">
            <input asp-for="Id" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />

            <button type="submit" class="btn btn-danger">@T["Delete"]</button>
            <a href="@cancelUrl" class="btn btn-secondary">@T["Cancel"]</a>
        </form>
    </div>
</section>
