@model KiddoCare.ViewModels.MedicalRecords.MedicalRecordDetailsViewModel

@{
    ViewData["Title"] = "Medical Record";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? Url.Action("Details", "Children", new { id = Model.ChildId });
}

<div class="page-header">
    <div>
        <div class="page-kicker">Health records</div>
        <h1 class="page-title">Medical Record</h1>
        <p class="page-subtitle">
            Health summary and emergency information for @Model.ChildFullName.
        </p>
    </div>

    <div class="page-actions">
        @if (Model.CanManage)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@backUrl"
               class="btn btn-outline-danger">
                Delete
            </a>
        }

        <a href="@backUrl" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Health Summary</h2>
                <p>Main medical information for this child.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Child</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>Allergies</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Allergies) ? "No allergies recorded" : Model.Allergies)</dd>
            </div>
            <div>
                <dt>Chronic Conditions</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.ChronicConditions) ? "No chronic conditions recorded" : Model.ChronicConditions)</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Emergency Contacts</h2>
                <p>Who to contact if immediate support is needed.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Doctor Name</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.DoctorName) ? "Not specified" : Model.DoctorName)</dd>
            </div>
            <div>
                <dt>Doctor Phone</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.DoctorPhone) ? "Not specified" : Model.DoctorPhone)</dd>
            </div>
            <div>
                <dt>Emergency Contact</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.EmergencyContactName) ? "Not specified" : Model.EmergencyContactName)</dd>
            </div>
            <div>
                <dt>Emergency Phone</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.EmergencyContactPhone) ? "Not specified" : Model.EmergencyContactPhone)</dd>
            </div>
        </dl>
    </section>
</div>

<section class="info-panel mt-3">
    <div class="section-heading-row">
        <div>
            <h2>Medical Notes</h2>
            <p>Additional information useful for teachers and staff.</p>
        </div>
    </div>

    <p class="mb-0" style="white-space: pre-line">
        @(string.IsNullOrWhiteSpace(Model.Notes) ? "No additional notes." : Model.Notes)
    </p>
</section>