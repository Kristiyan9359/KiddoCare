@model KiddoCare.ViewModels.MedicalRecords.MedicalRecordCreateViewModel

@{
    ViewData["Title"] = T["Create Medical Record"];
    var backUrl = Model.ReturnUrl ?? Url.Action("Index", "Children");
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Health records"]</div>
        <h1 class="page-title">@T["Create Medical Record"]</h1>
        <p class="page-subtitle">
            @T["Add important health information, emergency contacts and doctor details."]
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Create" method="post">
        <input asp-for="ReturnUrl" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="ChildId" class="form-label">@T["Child"]</label>
                <select asp-for="ChildId" asp-items="Model.Children" class="form-select">
                    <option value="">@T["Select child..."]</option>
                </select>
                <span asp-validation-for="ChildId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DoctorName" class="form-label">@T["Doctor Name"]</label>
                <input asp-for="DoctorName" class="form-control" />
                <span asp-validation-for="DoctorName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DoctorPhone" class="form-label">@T["Doctor Phone"]</label>
                <input asp-for="DoctorPhone" class="form-control" />
                <span asp-validation-for="DoctorPhone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EmergencyContactName" class="form-label">@T["Emergency Contact Name"]</label>
                <input asp-for="EmergencyContactName" class="form-control" />
                <span asp-validation-for="EmergencyContactName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EmergencyContactPhone" class="form-label">@T["Emergency Contact Phone"]</label>
                <input asp-for="EmergencyContactPhone" class="form-control" />
                <span asp-validation-for="EmergencyContactPhone" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Allergies" class="form-label">@T["Allergies"]</label>
            <textarea asp-for="Allergies" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Allergies" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ChronicConditions" class="form-label">@T["Chronic Conditions"]</label>
            <textarea asp-for="ChronicConditions" class="form-control" rows="3"></textarea>
            <span asp-validation-for="ChronicConditions" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label">@T["Medical Notes"]</label>
            <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">@T["Create"]</button>
            <a href="@backUrl" class="btn btn-secondary">@T["Cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
