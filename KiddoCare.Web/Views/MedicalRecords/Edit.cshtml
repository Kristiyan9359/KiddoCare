@model KiddoCare.ViewModels.MedicalRecords.MedicalRecordEditViewModel

@{
    ViewData["Title"] = "Edit Medical Record";
    var backUrl = Model.ReturnUrl ?? Url.Action("Details", "MedicalRecords", new { childId = Model.ChildId });
}

<div class="page-header">
    <div>
        <div class="page-kicker">Health records</div>
        <h1 class="page-title">Edit Medical Record</h1>
        <p class="page-subtitle">
            Update health details for @Model.ChildFullName.
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <input asp-for="ChildId" type="hidden" />
        <input asp-for="ChildFullName" type="hidden" />
        <input asp-for="ReturnUrl" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="DoctorName" class="form-label">Doctor Name</label>
                <input asp-for="DoctorName" class="form-control" />
                <span asp-validation-for="DoctorName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DoctorPhone" class="form-label">Doctor Phone</label>
                <input asp-for="DoctorPhone" class="form-control" />
                <span asp-validation-for="DoctorPhone" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EmergencyContactName" class="form-label">Emergency Contact Name</label>
                <input asp-for="EmergencyContactName" class="form-control" />
                <span asp-validation-for="EmergencyContactName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EmergencyContactPhone" class="form-label">Emergency Contact Phone</label>
                <input asp-for="EmergencyContactPhone" class="form-control" />
                <span asp-validation-for="EmergencyContactPhone" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Allergies" class="form-label">Allergies</label>
            <textarea asp-for="Allergies" class="form-control" rows="3"></textarea>
            <span asp-validation-for="Allergies" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ChronicConditions" class="form-label">Chronic Conditions</label>
            <textarea asp-for="ChronicConditions" class="form-control" rows="3"></textarea>
            <span asp-validation-for="ChronicConditions" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Notes" class="form-label">Medical Notes</label>
            <textarea asp-for="Notes" class="form-control" rows="4"></textarea>
            <span asp-validation-for="Notes" class="text-danger"></span>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="@backUrl" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}