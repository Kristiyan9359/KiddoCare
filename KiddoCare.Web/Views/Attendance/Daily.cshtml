@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.Attendance.AttendanceDailyViewModel

@{
    ViewData["Title"] = "Daily Attendance";
}

<h1>Daily Attendance</h1>

<form asp-action="Daily" method="get" class="row g-3 mb-4">
    <div class="col-md-4">
        <label asp-for="Date" class="form-label"></label>
        <input asp-for="Date" type="date" class="form-control" />
    </div>

    <div class="col-md-4">
        <label asp-for="GroupId" class="form-label">Group</label>
        <select asp-for="GroupId" asp-items="Model.Groups" class="form-select">
            <option value="">All groups</option>
        </select>
    </div>

    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary">Load</button>
    </div>
</form>

<form asp-action="Daily" method="post">
    <input asp-for="Date" type="hidden" />
    <input asp-for="GroupId" type="hidden" />

    <table class="table table-striped">
        <thead>
            <tr>
                <th>Child</th>
                <th>Status</th>
                <th>Note</th>
            </tr>
        </thead>

        <tbody>

            @for (var i = 0; i < Model.Children.Count; i++)
            {
                <tr>
                    <td>
                        @Model.Children[i].FullName
                        <input asp-for="Children[i].ChildId" type="hidden" />
                        <input asp-for="Children[i].FullName" type="hidden" />
                    </td>
                    <td>
                        <select asp-for="Children[i].Status"
                                asp-items="Html.GetEnumSelectList<AttendanceStatus>()"
                                class="form-select">
                        </select>
                    </td>
                    <td>
                        <input asp-for="Children[i].Note" class="form-control" />
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <button type="submit" class="btn btn-success">Save Attendance</button>
</form>