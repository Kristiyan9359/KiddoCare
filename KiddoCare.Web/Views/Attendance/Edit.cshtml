@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.Attendance.AttendanceEditViewModel

@{
    ViewData["Title"] = "Edit Attendance";
    var backUrl = Model.ReturnUrl ?? Url.Action("History");
}

<div class="page-header">
    <div>
        <div class="page-kicker">Attendance</div>
        <h1 class="page-title">Edit Attendance</h1>
        <p class="page-subtitle">
            Update an existing attendance record.
        </p>
    </div>
</div>

<section class="section-panel">
    <div class="section-panel-header">
        <div>
            <h2 class="section-panel-title">@Model.ChildName</h2>
            <p class="section-panel-subtitle">
                @Model.GroupName · @Model.Date.ToString("dd MMM yyyy")
            </p>
        </div>
    </div>

    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />
        <input asp-for="ReturnUrl" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="Status" class="form-label">Status</label>
                <select asp-for="Status"
                        asp-items="Html.GetEnumSelectList<AttendanceStatus>()"
                        class="form-select">
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Note" class="form-label">Note</label>
                <input asp-for="Note" class="form-control" placeholder="Optional note..." />
                <span asp-validation-for="Note" class="text-danger"></span>
            </div>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="@backUrl" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}