@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.DailyReports.DailyReportCreateViewModel

@{
    ViewData["Title"] = T["Create Daily Report"];
    var maxReportDate = DateTime.Today.ToString("yyyy-MM-dd");
    var moodOptions = Html.GetEnumSelectList<ChildMood>()
        .Where(m => m.Value != "0");
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Daily care"]</div>
        <h1 class="page-title">@T["Create Daily Report"]</h1>
        <p class="page-subtitle">
            @T["Capture the child's day with quick ratings and one clear teacher note."]
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Create" method="post">
        <input asp-for="ReturnUrl" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="ChildId" class="form-label">@T["Child"]</label>
                <select asp-for="ChildId" asp-items="Model.Children" class="form-select">
                    <option value="">@T["Select a child..."]</option>
                </select>
                <span asp-validation-for="ChildId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReportDate" class="form-label">@T["Report Date"]</label>
                <input asp-for="ReportDate"
                       type="date"
                       max="@maxReportDate"
                       class="form-control" />
                <span asp-validation-for="ReportDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Mood" class="form-label">@T["Mood"]</label>
                <select asp-for="Mood"
                        asp-items="moodOptions"
                        class="form-select">
                    <option value="0">@T["Select mood..."]</option>
                </select>
                <span asp-validation-for="Mood" class="text-danger"></span>
            </div>
        </div>

        <div class="rating-grid">
            <div class="rating-card">
                <div>
                    <label asp-for="MealRating" class="form-label">@T["Meal Rating"]</label>
                    <p class="form-help">@T["How well did the child eat today?"]</p>
                </div>

                <div class="rating-selector">
                    @for (int rating = 1; rating <= 5; rating++)
                    {
                        <input asp-for="MealRating"
                               type="radio"
                               value="@rating"
                               id="MealRating_@rating"
                               class="rating-input" />
                        <label for="MealRating_@rating" class="rating-option" title='@T["{0} out of 5", rating]'>
                            @rating
                        </label>
                    }
                </div>

                <span asp-validation-for="MealRating" class="text-danger"></span>
            </div>

            <div class="rating-card">
                <div>
                    <label asp-for="SleepRating" class="form-label">@T["Sleep Rating"]</label>
                    <p class="form-help">@T["How restful was nap or quiet time?"]</p>
                </div>

                <div class="rating-selector">
                    @for (int rating = 1; rating <= 5; rating++)
                    {
                        <input asp-for="SleepRating"
                               type="radio"
                               value="@rating"
                               id="SleepRating_@rating"
                               class="rating-input" />
                        <label for="SleepRating_@rating" class="rating-option" title='@T["{0} out of 5", rating]'>
                            @rating
                        </label>
                    }
                </div>

                <span asp-validation-for="SleepRating" class="text-danger"></span>
            </div>

            <div class="rating-card">
                <div>
                    <label asp-for="ActivityRating" class="form-label">@T["Activity Rating"]</label>
                    <p class="form-help">@T["How engaged was the child in activities?"]</p>
                </div>

                <div class="rating-selector">
                    @for (int rating = 1; rating <= 5; rating++)
                    {
                        <input asp-for="ActivityRating"
                               type="radio"
                               value="@rating"
                               id="ActivityRating_@rating"
                               class="rating-input" />
                        <label for="ActivityRating_@rating" class="rating-option" title='@T["{0} out of 5", rating]'>
                            @rating
                        </label>
                    }
                </div>

                <span asp-validation-for="ActivityRating" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="TeacherNote" class="form-label">@T["Teacher Note"]</label>
            <textarea asp-for="TeacherNote"
                      class="form-control"
                      rows="5"
                      placeholder='@T["Optional note for the parent."]'></textarea>
            <span asp-validation-for="TeacherNote" class="text-danger"></span>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">@T["Create"]</button>
            <a href="@backUrl" class="btn btn-secondary">@T["Cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
