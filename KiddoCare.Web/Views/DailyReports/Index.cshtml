@using static KiddoCare.Common.RoleConstants
@model KiddoCare.ViewModels.DailyReports.DailyReportListViewModel

@{
    ViewData["Title"] = T["Daily Reports"];
    bool canCreate = User.IsInRole(Admin) || User.IsInRole(Teacher);
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

@functions {
    private static string Stars(int rating)
    {
        rating = Math.Clamp(rating, 1, 5);

        return string.Concat(Enumerable.Repeat("&#9733;", rating)) +
               string.Concat(Enumerable.Repeat("&#9734;", 5 - rating));
    }
}

<div class="list-page-header">
    <div>
        <div class="page-kicker">@T["Daily care"]</div>
        <h1 class="page-title">@T["Daily Reports"]</h1>
        <p class="page-subtitle">
            @T["Follow each child's day through mood, meals, sleep, activities and teacher notes."]
        </p>
    </div>

    <div class="page-actions">
        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
        {
            <a href="@Model.ReturnUrl" class="btn btn-secondary">@T["Back"]</a>
        }

        @if (canCreate)
        {
            <a asp-action="Create"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-primary">
                @T["Create Daily Report"]
            </a>
        }
    </div>
</div>

<section id="daily-reports-list" class="section-panel">
    <div class="section-panel-header">
        <div>
            <h2 class="section-panel-title">@T["Report Records"]</h2>
            <p class="section-panel-subtitle">
                @T["{0} daily reports found.", Model.TotalDailyReports]
            </p>
        </div>

        <div class="records-toolbar">
            <div class="records-page-size">
                <label for="dailyReportsPageSizeSelect" class="form-label mb-0">@T["Show"]</label>
                <select id="dailyReportsPageSizeSelect" class="form-select form-select-sm">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="15" selected="@(Model.PageSize == 15)">15</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                </select>
            </div>

            @if (Model.TotalPages > 0)
            {
                <div class="text-muted">
                    @T["Page {0} of {1}", Model.Page, Model.TotalPages]
                </div>
            }
        </div>
    </div>

    <form id="dailyReportsFilterForm" asp-action="Index" method="get" class="filter-form mb-3">
        <input type="hidden" name="page" value="1" />
        <input asp-for="PageSize" type="hidden" id="dailyReportsPageSizeHidden" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

        <div class="form-grid align-items-end">
            <div class="mb-3 search-suggest-wrapper">
                <label asp-for="SearchTerm" class="form-label">@T["Search"]</label>
                <input asp-for="SearchTerm"
                       id="dailyReportsSearchInput"
                       class="form-control"
                       autocomplete="off"
                       placeholder='@T["Search by child, group or mood..."]' />

                <div id="dailyReportsSearchSuggestions"
                     class="search-suggestions"
                     hidden>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">@T["Search"]</button>
                <a asp-action="Index"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="btn btn-secondary">
                    @T["Clear"]
                </a>
            </div>
        </div>
    </form>

    @if (!Model.DailyReports.Any())
    {
        <section class="empty-state compact-empty-state">
            <h2>@T["No daily reports found"]</h2>
            <p>@T["Try changing the search, or create a report to share today's care summary with the parent."]</p>

            @if (canCreate)
            {
                <a asp-action="Create"
                   asp-route-returnUrl="@currentUrl"
                   class="btn btn-primary">
                    @T["Create Daily Report"]
                </a>
            }
        </section>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0 mobile-card-table">
                <thead>
                    <tr>
                        <th>@T["Child"]</th>
                        <th>@T["Group"]</th>
                        <th>@T["Date"]</th>
                        <th>@T["Mood"]</th>
                        <th>@T["Meals"]</th>
                        <th>@T["Sleep"]</th>
                        <th>@T["Activities"]</th>
                        <th class="text-end">@T["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var report in Model.DailyReports)
                    {
                        <tr>
                            <td data-label='@T["Child"]'><div class="fw-bold">@report.ChildFullName</div></td>
                            <td data-label='@T["Group"]'>@report.GroupName</td>
                            <td data-label='@T["Date"]'>@report.ReportDate.ToString("dd MMM yyyy")</td>
                            <td data-label='@T["Mood"]'>@T[report.Mood.ToString()]</td>
                            <td data-label='@T["Meals"]'><span class="rating-stars">@Html.Raw(Stars(report.MealRating))</span></td>
                            <td data-label='@T["Sleep"]'><span class="rating-stars">@Html.Raw(Stars(report.SleepRating))</span></td>
                            <td data-label='@T["Activities"]'><span class="rating-stars">@Html.Raw(Stars(report.ActivityRating))</span></td>
                            <td class="text-end" data-label='@T["Actions"]'>
                                <div class="action-buttons">
                                    <a asp-action="Details"
                                       asp-route-id="@report.Id"
                                       asp-route-returnUrl="@currentUrl"
                                       class="btn btn-sm btn-outline-secondary">
                                        @T["Details"]
                                    </a>

                                    @if (report.CanManage)
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@report.Id"
                                           asp-route-returnUrl="@currentUrl"
                                           class="btn btn-sm btn-outline-primary">
                                            @T["Edit"]
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@report.Id"
                                           asp-route-returnUrl="@currentUrl"
                                           class="btn btn-sm btn-outline-danger">
                                            @T["Delete"]
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="attendance-pager" aria-label='@T["Daily report pages"]'>
                <a class="attendance-page-link @(Model.HasPreviousPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="daily-reports-list">
                    @T["Previous"]
                </a>

                <div class="attendance-page-numbers">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <a class="attendance-page-number @(pageNumber == Model.Page ? "active" : string.Empty)"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           asp-route-page="@pageNumber"
                           asp-route-pageSize="@Model.PageSize"
                           asp-fragment="daily-reports-list">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="attendance-page-link @(Model.HasNextPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="daily-reports-list">
                    @T["Next"]
                </a>
            </nav>
        }
    }
</section>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('dailyReportsFilterForm');
            const searchInput = document.getElementById('dailyReportsSearchInput');
            const pageSizeSelect = document.getElementById('dailyReportsPageSizeSelect');
            const pageSizeHidden = document.getElementById('dailyReportsPageSizeHidden');
            const suggestionsBox = document.getElementById('dailyReportsSearchSuggestions');

            if (!form || !searchInput || !pageSizeSelect || !pageSizeHidden || !suggestionsBox) {
                return;
            }

            let suggestionsTimeout;
            let activeSuggestionIndex = -1;

            const hideSuggestions = () => {
                suggestionsBox.hidden = true;
                suggestionsBox.innerHTML = '';
                activeSuggestionIndex = -1;
            };

            const getSuggestionButtons = () => {
                return Array.from(suggestionsBox.querySelectorAll('button'));
            };

            const setActiveSuggestion = (index) => {
                const buttons = getSuggestionButtons();

                buttons.forEach(button => button.classList.remove('active'));

                if (index >= 0 && index < buttons.length) {
                    buttons[index].classList.add('active');
                    buttons[index].scrollIntoView({ block: 'nearest' });
                }

                activeSuggestionIndex = index;
            };

            const renderSuggestions = (items) => {
                suggestionsBox.innerHTML = '';

                if (!items.length) {
                    hideSuggestions();
                    return;
                }

                items.forEach(item => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'search-suggestion-item';
                    button.textContent = item;

                    button.addEventListener('click', () => {
                        searchInput.value = item;
                        hideSuggestions();
                        form.submit();
                    });

                    suggestionsBox.appendChild(button);
                });

                suggestionsBox.hidden = false;
                activeSuggestionIndex = -1;
            };

            searchInput.addEventListener('input', () => {
                clearTimeout(suggestionsTimeout);

                const term = searchInput.value.trim();

                if (term.length < 2) {
                    hideSuggestions();
                    return;
                }

                suggestionsTimeout = setTimeout(async () => {
                    const response = await fetch(`/DailyReports/Suggestions?term=${encodeURIComponent(term)}`);

                    if (!response.ok) {
                        hideSuggestions();
                        return;
                    }

                    const items = await response.json();
                    renderSuggestions(items);
                }, 250);
            });

            searchInput.addEventListener('keydown', (event) => {
                const buttons = getSuggestionButtons();

                if (event.key === 'Escape') {
                    hideSuggestions();
                    return;
                }

                if (suggestionsBox.hidden || !buttons.length) {
                    return;
                }

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    setActiveSuggestion((activeSuggestionIndex + 1) % buttons.length);
                }

                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    setActiveSuggestion(activeSuggestionIndex <= 0 ? buttons.length - 1 : activeSuggestionIndex - 1);
                }

                if (event.key === 'Enter' && activeSuggestionIndex >= 0) {
                    event.preventDefault();
                    buttons[activeSuggestionIndex].click();
                }
            });

            pageSizeSelect.addEventListener('change', () => {
                pageSizeHidden.value = pageSizeSelect.value;
                form.submit();
            });

            document.addEventListener('click', (event) => {
                if (!suggestionsBox.contains(event.target) && event.target !== searchInput) {
                    hideSuggestions();
                }
            });
        })();
    </script>
}
