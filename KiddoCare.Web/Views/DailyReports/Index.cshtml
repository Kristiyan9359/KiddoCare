@model IEnumerable<KiddoCare.ViewModels.DailyReports.DailyReportIndexViewModel>

@{
    ViewData["Title"] = "Daily Reports";
    bool canCreate = User.IsInRole("Admin") || User.IsInRole("Teacher");
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Daily Reports</h1>

    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-primary">Create Daily Report</a>
    }
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No daily reports found.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Child</th>
                <th>Date</th>
                <th>Mood</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model)
            {
                <tr>
                    <td>@report.ChildFullName</td>
                    <td>@report.ReportDate.ToString("dd MMM yyyy")</td>
                    <td>@report.Mood</td>
                    <td class="text-end">
                        <a asp-action="Details"
                           asp-route-id="@report.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>

                        @if (report.CanManage)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@report.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <a asp-action="Delete"
                               asp-route-id="@report.Id"
                               class="btn btn-sm btn-outline-danger">
                                Delete
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}