@model KiddoCare.ViewModels.DailyReports.DailyReportDetailsViewModel

@{
    ViewData["Title"] = T["Daily Report Details"];
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

@functions {
    private static string Stars(int rating)
    {
        return new string('★', rating) + new string('☆', 5 - rating);
    }
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Daily care"]</div>
        <h1 class="page-title">@T["Daily Report"]</h1>
        <p class="page-subtitle">
            @T["{0} on {1}", Model.ChildFullName, Model.ReportDate.ToString("dd MMM yyyy")]
        </p>
    </div>

    <div class="page-actions">
        @if (Model.CanManage)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-primary">
                @T["Edit"]
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@backUrl"
               class="btn btn-outline-danger">
                @T["Delete"]
            </a>
        }

        <a href="@backUrl" class="btn btn-secondary">@T["Back"]</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Report Summary"]</h2>
                <p>@T["Mood and report metadata."]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Child"]</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>@T["Report Date"]</dt>
                <dd>@Model.ReportDate.ToString("dd MMM yyyy")</dd>
            </div>
            <div>
                <dt>@T["Mood"]</dt>
                <dd>@T[Model.Mood.ToString()]</dd>
            </div>
            <div>
                <dt>@T["Created On"]</dt>
                <dd>@Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Care Ratings"]</h2>
                <p>@T["Quick view of the child's day."]</p>
            </div>
        </div>

        <div class="rating-summary-list">
            <div>
                <span>@T["Meals"]</span>
                <strong class="rating-stars">@Stars(Model.MealRating)</strong>
            </div>
            <div>
                <span>@T["Sleep"]</span>
                <strong class="rating-stars">@Stars(Model.SleepRating)</strong>
            </div>
            <div>
                <span>@T["Activities"]</span>
                <strong class="rating-stars">@Stars(Model.ActivityRating)</strong>
            </div>
        </div>
    </section>
</div>

<section class="info-panel mt-3">
    <div class="section-heading-row">
        <div>
            <h2>@T["Teacher Note"]</h2>
            <p>@T["Additional context for the parent."]</p>
        </div>
    </div>

    <p class="announcement-message">
        @(Model.TeacherNote ?? T["No additional note"].Value)
    </p>
</section>
