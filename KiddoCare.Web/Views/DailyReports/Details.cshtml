@model KiddoCare.ViewModels.DailyReports.DailyReportDetailsViewModel

@{
    ViewData["Title"] = "Daily Report Details";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

@functions {
    private static string Stars(int rating)
    {
        return new string('★', rating) + new string('☆', 5 - rating);
    }
}

<div class="page-header">
    <div>
        <div class="page-kicker">Daily care</div>
        <h1 class="page-title">Daily Report</h1>
        <p class="page-subtitle">
            @Model.ChildFullName on @Model.ReportDate.ToString("dd MMM yyyy")
        </p>
    </div>

    <div class="page-actions">
        @if (Model.CanManage)
        {
            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-primary">
                Edit
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-outline-danger">
                Delete
            </a>
        }

        <a href="@backUrl" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Report Summary</h2>
                <p>Mood and report metadata.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Child</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>Report Date</dt>
                <dd>@Model.ReportDate.ToString("dd MMM yyyy")</dd>
            </div>
            <div>
                <dt>Mood</dt>
                <dd>@Model.Mood</dd>
            </div>
            <div>
                <dt>Created On</dt>
                <dd>@Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Care Ratings</h2>
                <p>Quick view of the child's day.</p>
            </div>
        </div>

        <div class="rating-summary-list">
            <div>
                <span>Meals</span>
                <strong class="rating-stars">@Stars(Model.MealRating)</strong>
            </div>
            <div>
                <span>Sleep</span>
                <strong class="rating-stars">@Stars(Model.SleepRating)</strong>
            </div>
            <div>
                <span>Activities</span>
                <strong class="rating-stars">@Stars(Model.ActivityRating)</strong>
            </div>
        </div>
    </section>
</div>

<section class="info-panel mt-3">
    <div class="section-heading-row">
        <div>
            <h2>Teacher Note</h2>
            <p>Additional context for the parent.</p>
        </div>
    </div>

    <p class="announcement-message">
        @(Model.TeacherNote ?? "No additional note.")
    </p>
</section>
