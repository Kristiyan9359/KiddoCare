@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.DailyReports.DailyReportEditViewModel

@{
    ViewData["Title"] = "Edit Daily Report";

    var maxReportDate = DateTime.Today.ToString("yyyy-MM-dd");
    var moodOptions = Html.GetEnumSelectList<ChildMood>()
        .Where(m => m.Value != "0");
}

<h1>Edit Daily Report</h1>

<p>
    <strong>Child:</strong> @Model.ChildFullName
</p>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="ChildFullName" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ReportDate" class="form-label"></label>
        <input asp-for="ReportDate"
               type="date"
               max="@maxReportDate"
               class="form-control" />
        <span asp-validation-for="ReportDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Mood" class="form-label"></label>
        <select asp-for="Mood"
                asp-items="moodOptions"
                class="form-select">
            <option value="0">Select mood</option>
        </select>
        <span asp-validation-for="Mood" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Meals" class="form-label"></label>
        <textarea asp-for="Meals" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Meals" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Sleep" class="form-label"></label>
        <textarea asp-for="Sleep" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Sleep" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Activities" class="form-label"></label>
        <textarea asp-for="Activities" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Activities" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="TeacherNote" class="form-label"></label>
        <textarea asp-for="TeacherNote" class="form-control" rows="4"></textarea>
        <span asp-validation-for="TeacherNote" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}