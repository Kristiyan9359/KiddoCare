@model KiddoCare.ViewModels.DailyReports.DailyReportDeleteViewModel

@{
    ViewData["Title"] = "Delete Daily Report";
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<section class="delete-page">
    <div class="delete-card">
        <div class="delete-kicker">Permanent action</div>
        <h1>Delete Daily Report</h1>
        <p>
            Are you sure you want to delete this daily report? This action cannot be undone.
        </p>

        <dl class="info-list delete-info-list">
            <div>
                <dt>Child</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>Report Date</dt>
                <dd>@Model.ReportDate.ToString("dd MMM yyyy")</dd>
            </div>
            <div>
                <dt>Mood</dt>
                <dd>@Model.Mood</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-action-row justify-content-center">
            <input asp-for="Id" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a href="@backUrl" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</section>
