@model KiddoCare.ViewModels.DailyReports.DailyReportDeleteViewModel

@{
    ViewData["Title"] = "Delete Daily Report";
}

<h1>Delete Daily Report</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this daily report?
</div>

<dl class="row">
    <dt class="col-sm-3">Child</dt>
    <dd class="col-sm-9">@Model.ChildFullName</dd>

    <dt class="col-sm-3">Report Date</dt>
    <dd class="col-sm-9">@Model.ReportDate.ToString("dd MMM yyyy")</dd>

    <dt class="col-sm-3">Mood</dt>
    <dd class="col-sm-9">@Model.Mood</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>