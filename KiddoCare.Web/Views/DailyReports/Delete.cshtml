@model KiddoCare.ViewModels.DailyReports.DailyReportDeleteViewModel

@{
    ViewData["Title"] = T["Delete Daily Report"];
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<section class="delete-page">
    <div class="delete-card">
        <div class="delete-kicker">@T["Permanent action"]</div>
        <h1>@T["Delete Daily Report"]</h1>
        <p>
            @T["Are you sure you want to delete this daily report? This action cannot be undone."]
        </p>

        <dl class="info-list delete-info-list">
            <div>
                <dt>@T["Child"]</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>@T["Report Date"]</dt>
                <dd>@Model.ReportDate.ToString("dd MMM yyyy")</dd>
            </div>
            <div>
                <dt>@T["Mood"]</dt>
                <dd>@T[Model.Mood.ToString()]</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-action-row justify-content-center">
            <input asp-for="Id" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />

            <button type="submit" class="btn btn-danger">@T["Delete"]</button>
            <a href="@backUrl" class="btn btn-secondary">@T["Cancel"]</a>
        </form>
    </div>
</section>
