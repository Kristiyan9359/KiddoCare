@model ErrorViewModel

@{
    ViewData["Title"] = "Error";
}

<section class="error-page">
    <div class="error-card">
        <div class="error-code">500</div>
        <h1>Something went wrong</h1>
        <p>An unexpected error occurred while processing your request.</p>

        @if (Model.ShowRequestId)
        {
            <p class="error-request-id">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }

        <div class="error-actions">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">Go to Dashboard</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Home</a>
        </div>
    </div>
</section>