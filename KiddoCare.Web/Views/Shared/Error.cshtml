@model ErrorViewModel

@{
    ViewData["Title"] = T["Error"];
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<section class="error-page">
    <div class="error-card">
        <div class="error-code">500</div>
        <h1>@T["Something went wrong"]</h1>
        <p>@T["An unexpected error occurred while processing your request."]</p>

        @if (Model.ShowRequestId)
        {
            <p class="error-request-id">
                @T["Request ID"]: <code>@Model.RequestId</code>
            </p>
        }

        <div class="error-actions">
            @if (isAuthenticated)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">@T["Go to Dashboard"]</a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">@T["Login"]</a>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">@T["Home"]</a>
        </div>
    </div>
</section>
