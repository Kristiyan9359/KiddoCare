@using static KiddoCare.Common.RoleConstants
@using System.Globalization
@using System.Security.Claims
@inject KiddoCare.Services.Core.Contracts.IMessageService MessageService

@{
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
    bool isAdmin = User.IsInRole(Admin);
    bool isTeacher = User.IsInRole(Teacher);
    bool isParent = User.IsInRole(Parent);
    bool isStaff = isAdmin || isTeacher;
    string currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    string returnUrl = string.Concat(Context.Request.PathBase, Context.Request.Path, Context.Request.QueryString);
    int unreadMessagesCount = 0;

    if (isAuthenticated)
    {
        string? userId = User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrWhiteSpace(userId))
        {
            unreadMessagesCount = await MessageService.GetUnreadMessagesCountAsync(userId, isAdmin, isTeacher, isParent);
        }
    }
}

<!DOCTYPE html>
<html lang="@currentCulture">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@T[ViewData["Title"]?.ToString() ?? "KiddoCare"] - KiddoCare</title>
    <script type="importmap"></script>
    <script>
            (() => {
                const storedTheme = localStorage.getItem("kiddocare-theme");
                const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
                const theme = storedTheme === "dark" || storedTheme === "light"
                    ? storedTheme
                    : prefersDark ? "dark" : "light";

                document.documentElement.dataset.theme = theme;
                document.documentElement.dataset.bsTheme = theme;
            })();
    </script>
    <link rel="icon" type="image/png" href="~/images/favicons/kiddocare-favicon-k.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.ico" asp-append-version="true" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/KiddoCare.styles.css" asp-append-version="true" />
</head>
<body class="app-shell">
    <header class="app-header">
        <nav class="navbar navbar-expand-xxl app-navbar mb-4">
            <div class="container app-navbar-inner">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">KiddoCare</a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="@T["Toggle navigation"]">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div id="mainNavbar" class="collapse navbar-collapse">
                    <ul class="navbar-nav me-auto mb-2 mb-xl-0">
                        @if (!isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">@T["Home"]</a>
                            </li>
                        }

                        @if (isAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Dashboard" asp-action="Index">@T["Dashboard"]</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-link-with-badge" asp-controller="Messages" asp-action="Index">
                                    <span>@T["Messages"]</span>
                                    @if (unreadMessagesCount > 0)
                                    {
                                        <span class="nav-unread-badge" aria-label="@T["Unread messages"]">
                                            @(unreadMessagesCount > 99 ? "99+" : unreadMessagesCount)
                                        </span>
                                    }
                                </a>
                            </li>

                            @if (isStaff)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Children" asp-action="Index">@T["Children"]</a>
                                </li>

                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        @T["Attendance"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Attendance" asp-action="Daily">
                                                @T["Manage Attendance"]
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Attendance" asp-action="History">
                                                @T["Attendance History"]
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="DailyReports" asp-action="Index">
                                                @T["Daily Reports"]
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                            }

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle"
                                   href="#"
                                   role="button"
                                   data-bs-toggle="dropdown"
                                   aria-expanded="false">
                                    @T["Requests"]
                                </a>
                                <ul class="dropdown-menu">
                                    <li>
                                        <a class="dropdown-item" asp-controller="AbsenceRequests" asp-action="Index">
                                            @T["Absence Notices"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ConsentRequests" asp-action="Index">
                                            @T["Consent Requests"]
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="ChildDocuments" asp-action="Index">
                                            @T["Child Documents"]
                                        </a>
                                    </li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Events" asp-action="Index">@T["Events"]</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Announcements" asp-action="Index">@T["Announcements"]</a>
                            </li>

                            @if (isAdmin)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle"
                                       href="#"
                                       role="button"
                                       data-bs-toggle="dropdown"
                                       aria-expanded="false">
                                        @T["Admin"]
                                    </a>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Groups" asp-action="Index">@T["Groups"]</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Parents" asp-action="Index">@T["Parents"]</a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Teachers" asp-action="Index">@T["Teachers"]</a>
                                        </li>
                                    </ul>
                                </li>
                            }
                        }

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">@T["Privacy"]</a>
                        </li>
                    </ul>

                    <div class="app-login">
                        <form class="language-switcher"
                              asp-controller="Home"
                              asp-action="SetLanguage"
                              method="post">
                            <input type="hidden" name="returnUrl" value="@returnUrl" />
                            <button type="submit"
                                    name="culture"
                                    value="en"
                                    class="language-option @(currentCulture == "en" ? "active" : string.Empty)"
                                    aria-label="@T["Switch to English"]"
                                    aria-pressed="@(currentCulture == "en")">
                                EN
                            </button>
                            <span aria-hidden="true"></span>
                            <button type="submit"
                                    name="culture"
                                    value="bg"
                                    class="language-option @(currentCulture == "bg" ? "active" : string.Empty)"
                                    aria-label="@T["Switch to Bulgarian"]"
                                    aria-pressed="@(currentCulture == "bg")">
                                BG
                            </button>
                        </form>

                        <button type="button"
                                class="theme-toggle"
                                id="themeToggle"
                                aria-label="@T["Toggle color theme"]"
                                aria-pressed="false"
                                data-light-label="@T["Light"]"
                                data-dark-label="@T["Dark"]"
                                data-switch-to-light-title="@T["Switch to light theme"]"
                                data-switch-to-dark-title="@T["Switch to dark theme"]">
                            <span class="theme-toggle-icon" aria-hidden="true"></span>
                            <span class="theme-toggle-label">@T["Theme"]</span>
                        </button>

                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            <partial name="_FlashMessages" />
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - KiddoCare - <a asp-area="" asp-controller="Home" asp-action="Privacy">@T["Privacy"]</a>
        </div>
    </footer>

    <div class="modal fade confirm-modal"
         id="confirmActionModal"
         tabindex="-1"
         aria-labelledby="confirmActionModalTitle"
         data-default-confirm-message="@T["Are you sure you want to continue?"]"
         aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <div>
                        <div class="modal-kicker">@T["Please confirm"]</div>
                        <h5 class="modal-title" id="confirmActionModalTitle">@T["Delete item"]</h5>
                    </div>
                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="@T["Close"]"></button>
                </div>
                <div class="modal-body">
                    <p id="confirmActionModalMessage" class="mb-0">
                        @T["Are you sure you want to continue?"]
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">
                        @T["Cancel"]
                    </button>
                    <button type="button"
                            id="confirmActionModalButton"
                            class="btn btn-danger">
                        @T["Delete"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
