@{
    ViewData["Title"] = T["Privacy"];
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Privacy and data care"]</div>
        <h1 class="page-title">@T["Privacy Policy"]</h1>
        <p class="page-subtitle">
            @T["KiddoCare handles child, parent and kindergarten information with clear role-based access and careful file storage."]
        </p>
    </div>
</div>

<section class="section-panel privacy-panel">
    <h2>@T["Information Stored"]</h2>
    <p>
        @T["The application stores child profiles, parent and teacher contact details, attendance records, daily reports, medical notes, absence notices, consent requests, announcements, events and uploaded child documents."]
    </p>
</section>

<section class="section-panel privacy-panel">
    <h2>@T["Access Control"]</h2>
    <p>
        @T["Access is role-based. Administrators manage kindergarten data, teachers work with their assigned group, and parents can view information connected to their own children."]
    </p>
</section>

<section class="section-panel privacy-panel">
    <h2>@T["Uploaded Files"]</h2>
    <p>
        @T["Uploaded photos and documents are stored outside the public Git repository. Local development files are kept under protected application storage and should be moved to a dedicated cloud storage provider before production deployment."]
    </p>
</section>

<section class="section-panel privacy-panel">
    <h2>@T["Demo Data"]</h2>
    <p>
        @T["Development demo data is fictional and exists only to test the application workflow. Real child photos, personal documents and production passwords should never be committed to source control."]
    </p>
</section>
