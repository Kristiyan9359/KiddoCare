@{
    ViewData["Title"] = T["Access Denied"];
}

<section class="error-page">
    <div class="error-card">
        <div class="error-code">403</div>
        <h1>@T["Access Denied"]</h1>
        <p>@T["You do not have permission to access this page."]</p>

        <div class="error-actions">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">@T["Go to Dashboard"]</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">@T["Home"]</a>
        </div>
    </div>
</section>
