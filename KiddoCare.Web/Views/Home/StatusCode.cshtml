@{
    ViewData["Title"] = ViewBag.Title;
}

<section class="error-page">
    <div class="error-card">
        <div class="error-code">@ViewBag.StatusCode</div>
        <h1>@ViewBag.Title</h1>
        <p>@ViewBag.Message</p>

        <div class="error-actions">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">@T["Go to Dashboard"]</a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">@T["Home"]</a>
        </div>
    </div>
</section>
