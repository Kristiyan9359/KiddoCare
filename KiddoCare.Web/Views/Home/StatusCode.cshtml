@{
    ViewData["Title"] = ViewBag.Title;
    bool isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<section class="error-page">
    <div class="error-card">
        <div class="error-code">@ViewBag.StatusCode</div>
        <h1>@ViewBag.Title</h1>
        <p>@ViewBag.Message</p>

        <div class="error-actions">
            @if (isAuthenticated)
            {
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">@T["Go to Dashboard"]</a>
            }
            else
            {
                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-primary">@T["Login"]</a>
            }
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">@T["Home"]</a>
        </div>
    </div>
</section>
