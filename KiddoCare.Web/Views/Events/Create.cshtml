@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.Events.EventCreateViewModel

@{
    ViewData["Title"] = T["Create Event"];
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Calendar"]</div>
        <h1 class="page-title">@T["Create Event"]</h1>
        <p class="page-subtitle">
            @T["Add a trip, celebration, holiday or classroom activity."]
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="Title" class="form-label">@T["Title"]</label>
                <input asp-for="Title" class="form-control" placeholder='@T["Example: Zoo trip"]' />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label">@T["Type"]</label>
                <select asp-for="Type" asp-items="Html.GetLocalizedEnumSelectList<EventType>(T)" class="form-select"></select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartDateTime" class="form-label">@T["Starts On"]</label>
                <input asp-for="StartDateTime" type="datetime-local" class="form-control" />
                <span asp-validation-for="StartDateTime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndDateTime" class="form-label">@T["Ends On"]</label>
                <input asp-for="EndDateTime" type="datetime-local" class="form-control" />
                <span asp-validation-for="EndDateTime" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Location" class="form-label">@T["Location"]</label>
                <input asp-for="Location" class="form-control" placeholder='@T["Optional location"]' />
                <span asp-validation-for="Location" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GroupId" class="form-label">@T["Group"]</label>
                <select asp-for="GroupId" asp-items="Model.Groups" class="form-select">
                    <option value="">@T["All groups"]</option>
                </select>
                <span asp-validation-for="GroupId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">@T["Description"]</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="4"
                      placeholder='@T["Optional details for teachers and parents."]'></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsPublic" class="form-check-input" />
            <label asp-for="IsPublic" class="form-check-label">@T["Visible to parents"]</label>
            <div class="form-text">
                @T["When enabled, parents can see this event in their dashboard."]
            </div>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">@T["Create"]</button>
            <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
