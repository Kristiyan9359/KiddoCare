@model KiddoCare.ViewModels.Events.EventDetailsViewModel

@{
    ViewData["Title"] = "Event Details";
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">Calendar</div>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-subtitle">
            Event details, schedule and audience.
        </p>
    </div>

    <div class="page-actions">
        <a href="@backUrl" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Event Summary</h2>
                <p>@Model.Type event for @Model.GroupName.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Title</dt>
                <dd>@Model.Title</dd>
            </div>
            <div>
                <dt>Type</dt>
                <dd>@Model.Type</dd>
            </div>
            <div>
                <dt>Group</dt>
                <dd>@Model.GroupName</dd>
            </div>
            <div>
                <dt>Visibility</dt>
                <dd>@(Model.IsPublic ? "Visible to parents" : "Staff only")</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Schedule</h2>
                <p>When and where the event takes place.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Starts On</dt>
                <dd>@Model.StartDateTime.ToString("dd MMM yyyy HH:mm")</dd>
            </div>
            <div>
                <dt>Ends On</dt>
                <dd>@(Model.EndDateTime.HasValue ? Model.EndDateTime.Value.ToString("dd MMM yyyy HH:mm") : "Not specified")</dd>
            </div>
            <div>
                <dt>Location</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Location) ? "Not specified" : Model.Location)</dd>
            </div>
        </dl>
    </section>
</div>

<section class="info-panel mt-3">
    <div class="section-heading-row">
        <div>
            <h2>Description</h2>
            <p>Additional event information.</p>
        </div>
    </div>

    <p class="mb-0">
        @(string.IsNullOrWhiteSpace(Model.Description) ? "No description added." : Model.Description)
    </p>
</section>