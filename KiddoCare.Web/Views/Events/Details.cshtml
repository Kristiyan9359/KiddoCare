@model KiddoCare.ViewModels.Events.EventDetailsViewModel

@{
    ViewData["Title"] = T["Event Details"];
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Calendar"]</div>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-subtitle">
            @T["Event details, schedule and audience."]
        </p>
    </div>

    <div class="page-actions">
        <a href="@backUrl" class="btn btn-secondary">@T["Back"]</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Event Summary"]</h2>
                <p>@T["{0} event for {1}.", T[Model.Type.ToString()], Model.GroupName]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Title"]</dt>
                <dd>@Model.Title</dd>
            </div>
            <div>
                <dt>@T["Type"]</dt>
                <dd>@T[Model.Type.ToString()]</dd>
            </div>
            <div>
                <dt>@T["Group"]</dt>
                <dd>@Model.GroupName</dd>
            </div>
            <div>
                <dt>@T["Visibility"]</dt>
                <dd>@(Model.IsPublic ? T["Visible to parents"].Value : T["Staff only"].Value)</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Schedule"]</h2>
                <p>@T["When and where the event takes place."]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Starts On"]</dt>
                <dd>@Model.StartDateTime.ToString("dd MMM yyyy HH:mm")</dd>
            </div>
            <div>
                <dt>@T["Ends On"]</dt>
                <dd>@(Model.EndDateTime.HasValue ? Model.EndDateTime.Value.ToString("dd MMM yyyy HH:mm") : T["Not specified"].Value)</dd>
            </div>
            <div>
                <dt>@T["Location"]</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.Location) ? T["Not specified"].Value : Model.Location)</dd>
            </div>
        </dl>
    </section>
</div>

<section class="info-panel mt-3">
    <div class="section-heading-row">
        <div>
            <h2>@T["Description"]</h2>
            <p>@T["Additional event information."]</p>
        </div>
    </div>

    <p class="mb-0">
        @(string.IsNullOrWhiteSpace(Model.Description) ? T["No description added."].Value : Model.Description)
    </p>
</section>
