@using static KiddoCare.Common.RoleConstants
@model IEnumerable<KiddoCare.ViewModels.Events.EventIndexViewModel>

@{
    ViewData["Title"] = "Events";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    bool canCreate = User.IsInRole(Admin) || User.IsInRole(Teacher);
}

<div class="list-page-header">
    <div>
        <div class="page-kicker">Calendar</div>
        <h1 class="page-title">Events</h1>
        <p class="page-subtitle">
            Upcoming kindergarten activities, trips, holidays and group events.
        </p>
    </div>

    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-primary">Create Event</a>
    }
</div>

@if (!Model.Any())
{
    <section class="empty-state">
        <div class="empty-state-icon">+</div>
        <h2>No events yet</h2>
        <p>Create the first event to keep families and teachers aligned.</p>

        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">Create Event</a>
        }
    </section>
}
else
{
    <div class="content-list">
        @foreach (var eventItem in Model)
        {
            <article class="content-list-item">
                <div>
                    <div class="item-meta mb-2">
                        <span>@eventItem.Type</span>
                        <span>@eventItem.GroupName</span>
                    </div>

                    <h2 class="item-title">@eventItem.Title</h2>

                    <div class="item-meta">
                        <span>@eventItem.StartDateTime.ToString("dd MMM yyyy HH:mm")</span>

                        @if (!string.IsNullOrWhiteSpace(eventItem.Location))
                        {
                            <span>@eventItem.Location</span>
                        }
                    </div>
                </div>

                <div class="item-actions">
                    <a asp-action="Details"
                       asp-route-id="@eventItem.Id"
                       asp-route-returnUrl="@currentUrl"
                       class="btn btn-sm btn-outline-secondary">
                        Details
                    </a>

                    @if (eventItem.CanManage)
                    {
                        <a asp-action="Edit"
                           asp-route-id="@eventItem.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@eventItem.Id"
                              method="post">
                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    data-confirm-message="Are you sure you want to delete this event?">
                                Delete
                            </button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}