@using static KiddoCare.Common.RoleConstants
@model KiddoCare.ViewModels.Events.EventListViewModel

@{
    ViewData["Title"] = T["Events"];
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    bool canCreate = User.IsInRole(Admin) || User.IsInRole(Teacher);
}

<div class="list-page-header">
    <div>
        <div class="page-kicker">@T["Calendar"]</div>
        <h1 class="page-title">@T["Events"]</h1>
        <p class="page-subtitle">
            @T["Upcoming kindergarten activities, trips, holidays and group events."]
        </p>
    </div>

    <div class="page-actions">
        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
        {
            <a href="@Model.ReturnUrl" class="btn btn-secondary">@T["Back"]</a>
        }

        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">@T["Create Event"]</a>
        }
    </div>
</div>

<section id="events-list" class="section-panel">
    <div class="section-panel-header">
        <div>
            <h2 class="section-panel-title">@T["Event Records"]</h2>
            <p class="section-panel-subtitle">
                @T["{0} event records found.", Model.TotalEvents]
            </p>
        </div>

        <div class="records-toolbar">
            <div class="records-page-size">
                <label for="eventsPageSizeSelect" class="form-label mb-0">@T["Show"]</label>
                <select id="eventsPageSizeSelect" class="form-select form-select-sm">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="15" selected="@(Model.PageSize == 15)">15</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                </select>
            </div>

            @if (Model.TotalPages > 0)
            {
                <div class="text-muted">
                    @T["Page {0} of {1}", Model.Page, Model.TotalPages]
                </div>
            }
        </div>
    </div>

    <form id="eventsFilterForm" asp-action="Index" method="get" class="filter-form mb-3">
        <input type="hidden" name="page" value="1" />
        <input asp-for="PageSize" type="hidden" id="eventsPageSizeHidden" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

        <div class="form-grid align-items-end">
            <div class="mb-3 search-suggest-wrapper">
                <label asp-for="SearchTerm" class="form-label">@T["Search"]</label>
                <input asp-for="SearchTerm"
                       id="eventsSearchInput"
                       class="form-control"
                       autocomplete="off"
                       placeholder="@T["Search by title, location, group or type..."]" />

                <div id="eventsSearchSuggestions"
                     class="search-suggestions"
                     hidden>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">@T["Search"]</button>
                <a asp-action="Index"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="btn btn-secondary">
                    @T["Clear"]
                </a>
            </div>
        </div>
    </form>

    @if (!Model.Events.Any())
    {
        <section class="empty-state compact-empty-state">
            <h2>@T["No events found"]</h2>
            <p>@T["Try changing the search term."]</p>

            @if (canCreate)
            {
                <a asp-action="Create" class="btn btn-primary">@T["Create Event"]</a>
            }
        </section>
    }
    else
    {
        <div class="content-list">
            @foreach (var eventItem in Model.Events)
            {
                <article class="content-list-item">
                    <div>
                        <div class="item-meta mb-2">
                            <span>@eventItem.Type</span>
                            <span>@eventItem.GroupName</span>
                        </div>

                        <h2 class="item-title">@eventItem.Title</h2>

                        <div class="item-meta">
                            <span>@eventItem.StartDateTime.ToString("dd MMM yyyy HH:mm")</span>

                            @if (!string.IsNullOrWhiteSpace(eventItem.Location))
                            {
                                <span>@eventItem.Location</span>
                            }
                        </div>
                    </div>

                    <div class="item-actions">
                        <a asp-action="Details"
                           asp-route-id="@eventItem.Id"
                           asp-route-returnUrl="@currentUrl"
                           class="btn btn-sm btn-outline-secondary">
                            @T["Details"]
                        </a>

                        @if (eventItem.CanManage)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@eventItem.Id"
                               class="btn btn-sm btn-outline-primary">
                                @T["Edit"]
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@eventItem.Id"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        data-confirm-message="@T["Are you sure you want to delete this event?"]">
                                    @T["Delete"]
                                </button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="attendance-pager" aria-label="@T["Events pages"]">
                <a class="attendance-page-link @(Model.HasPreviousPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="events-list">
                    @T["Previous"]
                </a>

                <div class="attendance-page-numbers">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <a class="attendance-page-number @(pageNumber == Model.Page ? "active" : string.Empty)"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           asp-route-page="@pageNumber"
                           asp-route-pageSize="@Model.PageSize"
                           asp-fragment="events-list">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="attendance-page-link @(Model.HasNextPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="events-list">
                    @T["Next"]
                </a>
            </nav>
        }
    }
</section>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('eventsFilterForm');
            const searchInput = document.getElementById('eventsSearchInput');
            const pageSizeSelect = document.getElementById('eventsPageSizeSelect');
            const pageSizeHidden = document.getElementById('eventsPageSizeHidden');
            const suggestionsBox = document.getElementById('eventsSearchSuggestions');

            if (!form || !searchInput || !pageSizeSelect || !pageSizeHidden || !suggestionsBox) {
                return;
            }

            let suggestionsTimeout;
            let activeSuggestionIndex = -1;

            const hideSuggestions = () => {
                suggestionsBox.hidden = true;
                suggestionsBox.innerHTML = '';
                activeSuggestionIndex = -1;
            };

            const getSuggestionButtons = () => {
                return Array.from(suggestionsBox.querySelectorAll('button'));
            };

            const setActiveSuggestion = (index) => {
                const buttons = getSuggestionButtons();

                buttons.forEach(button => button.classList.remove('active'));

                if (index >= 0 && index < buttons.length) {
                    buttons[index].classList.add('active');
                    buttons[index].scrollIntoView({ block: 'nearest' });
                }

                activeSuggestionIndex = index;
            };

            const renderSuggestions = (items) => {
                suggestionsBox.innerHTML = '';

                if (!items.length) {
                    hideSuggestions();
                    return;
                }

                items.forEach(item => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'search-suggestion-item';
                    button.textContent = item;

                    button.addEventListener('click', () => {
                        searchInput.value = item;
                        hideSuggestions();
                        form.submit();
                    });

                    suggestionsBox.appendChild(button);
                });

                suggestionsBox.hidden = false;
                activeSuggestionIndex = -1;
            };

            searchInput.addEventListener('input', () => {
                clearTimeout(suggestionsTimeout);

                const term = searchInput.value.trim();

                if (term.length < 2) {
                    hideSuggestions();
                    return;
                }

                suggestionsTimeout = setTimeout(async () => {
                    const response = await fetch(`/Events/Suggestions?term=${encodeURIComponent(term)}`);

                    if (!response.ok) {
                        hideSuggestions();
                        return;
                    }

                    const items = await response.json();
                    renderSuggestions(items);
                }, 250);
            });

            searchInput.addEventListener('keydown', (event) => {
                const buttons = getSuggestionButtons();

                if (event.key === 'Escape') {
                    hideSuggestions();
                    return;
                }

                if (suggestionsBox.hidden || !buttons.length) {
                    return;
                }

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    setActiveSuggestion((activeSuggestionIndex + 1) % buttons.length);
                }

                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    setActiveSuggestion(activeSuggestionIndex <= 0 ? buttons.length - 1 : activeSuggestionIndex - 1);
                }

                if (event.key === 'Enter' && activeSuggestionIndex >= 0) {
                    event.preventDefault();
                    buttons[activeSuggestionIndex].click();
                }
            });

            pageSizeSelect.addEventListener('change', () => {
                pageSizeHidden.value = pageSizeSelect.value;
                form.submit();
            });

            document.addEventListener('click', (event) => {
                if (!suggestionsBox.contains(event.target) && event.target !== searchInput) {
                    hideSuggestions();
                }
            });
        })();
    </script>
}
