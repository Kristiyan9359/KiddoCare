@model KiddoCare.ViewModels.Children.ChildEditViewModel

@{
    ViewData["Title"] = T["Edit Child"];
    var fullName = $"{Model.FirstName} {Model.LastName}";
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Child records"]</div>
        <h1 class="page-title">@T["Edit Child"]</h1>
        <p class="page-subtitle">
            @T["Update profile details, group assignment, parent link and profile photo."]
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Edit" method="post" enctype="multipart/form-data">
        <input asp-for="Id" type="hidden" />
        <input asp-for="PhotoUrl" type="hidden" />
        <input asp-for="RemovePhoto" type="hidden" value="false" data-remove-photo-input />

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="FirstName" class="form-label">@T["First Name"]</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="LastName" class="form-label">@T["Last Name"]</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Gender" class="form-label">@T["Gender"]</label>
                <select asp-for="Gender"
                        asp-items="Html.GetLocalizedEnumSelectList<KiddoCare.Data.Models.Enums.Gender>(T)"
                        class="form-select">
                    <option value="">@T["Select gender..."]</option>
                </select>
                <span asp-validation-for="Gender" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="DateOfBirth" class="form-label">@T["Date of Birth"]</label>
                <input asp-for="DateOfBirth"
                       type="date"
                       class="form-control"
                       min="@DateTime.Today.AddYears(-7).ToString("yyyy-MM-dd")"
                       max="@DateTime.Today.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="DateOfBirth" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GroupId" class="form-label">@T["Group"]</label>
                <select asp-for="GroupId" asp-items="Model.Groups" class="form-select">
                    <option value="">@T["Select group..."]</option>
                </select>
                <span asp-validation-for="GroupId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParentId" class="form-label">@T["Parent"]</label>
                <select asp-for="ParentId" asp-items="Model.Parents" class="form-select">
                    <option value="">@T["No parent linked"]</option>
                </select>
                <span asp-validation-for="ParentId" class="text-danger"></span>
            </div>
        </div>

        <div class="file-upload-panel">
            @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
            {
                <div class="current-photo-preview" data-current-photo-preview>
                    <button type="button"
                            class="remove-photo-button"
                            aria-label='@T["Remove current photo"]'
                            title='@T["Remove current photo"]'
                            data-remove-photo-button>
                        &times;
                    </button>
                    <img src="@Url.Action("Photo", "Children", new { id = Model.Id })"
                         alt="@fullName" />
                    <span>@T["Current photo"]</span>
                </div>
            }

            <div class="flex-grow-1">
                <label asp-for="Photo" class="form-label">@T["Photo"]</label>
                <p class="form-help">@T["Upload a new photo only if you want to replace the current one."]</p>
                <p class="form-help photo-removed-note" hidden data-photo-removed-note>
                    @T["The current photo will be removed after you save."]
                </p>
                <input asp-for="Photo" type="file" class="form-control" />
                <span asp-validation-for="Photo" class="text-danger"></span>
            </div>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">@T["Save"]</button>
            <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
