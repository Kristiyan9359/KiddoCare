@model KiddoCare.ViewModels.Children.ChildEditViewModel

@{
    ViewData["Title"] = "Edit Child";
}

<h1>Edit Child</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="FirstName" class="form-label"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="LastName" class="form-label"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Gender" class="form-label"></label>
        <select asp-for="Gender" asp-items="Html.GetEnumSelectList<KiddoCare.Data.Models.Enums.Gender>()" class="form-select">
            <option value="">Select gender...</option>
        </select>
        <span asp-validation-for="Gender" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DateOfBirth" class="form-label"></label>
        <input asp-for="DateOfBirth"
               type="date"
               class="form-control"
               min="@DateTime.Today.AddYears(-7).ToString("yyyy-MM-dd")"
               max="@DateTime.Today.ToString("yyyy-MM-dd")" />
        <span asp-validation-for="DateOfBirth" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="GroupId" class="form-label">Group</label>
        <select asp-for="GroupId" asp-items="Model.Groups" class="form-select">
            <option value="">Select group...</option>
        </select>
        <span asp-validation-for="GroupId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ParentId" class="form-label">Parent</label>
        <select asp-for="ParentId" asp-items="Model.Parents" class="form-select">
            <option value="">No parent linked</option>
        </select>
        <span asp-validation-for="ParentId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Allergies" class="form-label"></label>
        <textarea asp-for="Allergies" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Allergies" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AdditionalNotes" class="form-label"></label>
        <textarea asp-for="AdditionalNotes" class="form-control" rows="4"></textarea>
        <span asp-validation-for="AdditionalNotes" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="PhotoUrl" class="form-label"></label>
        <input asp-for="PhotoUrl" class="form-control" />
        <span asp-validation-for="PhotoUrl" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}