@using static KiddoCare.Common.RoleConstants
@model IEnumerable<KiddoCare.ViewModels.Children.ChildIndexViewModel>

@{
    ViewData["Title"] = "Children";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<h1>Children</h1>

@if (User.IsInRole(Admin))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Add Child</a>
    </p>
}
@if (!Model.Any())
{
    <div class="alert alert-info">
        No children found.
    </div>
}
else
{ 
<div class="mb-3">
    <a asp-action="Index"
       class="btn btn-sm @(ViewBag.MedicalFilter == null ? "btn-primary" : "btn-outline-primary")">
        All children
    </a>

    <a asp-action="Index"
       asp-route-medicalFilter="with-records"
       class="btn btn-sm @(ViewBag.MedicalFilter == "with-records" ? "btn-primary" : "btn-outline-primary")">
        With medical records
    </a>

    <a asp-action="Index"
       asp-route-medicalFilter="with-allergies"
       class="btn btn-sm @(ViewBag.MedicalFilter == "with-allergies" ? "btn-primary" : "btn-outline-primary")">
        With allergies
    </a>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Date of Birth</th>
            <th>Gender</th>
            <th>Group</th>
            <th>Medical</th>
            <th>Allergies</th>
            <th>Photo</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var child in Model)
        {
            <tr>
                <td>@child.FullName</td>
                <td>@child.DateOfBirth.ToString("dd MMM yyyy")</td>
                <td>@child.Gender</td>
                <td>@child.GroupName</td>
                <td>
                    @if (child.HasMedicalRecord)
                    {
                        <span class="badge bg-info text-dark">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
                <td>
                    @if (child.HasAllergies)
                    {
                        <span class="badge bg-warning text-dark">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(child.PhotoUrl))
                    {
                        <img src="@Url.Action("Photo", "Children", new { id = child.Id })" alt="@child.FullName" style="width: 48px; height: 48px; object-fit: cover; border-radius: 50%;" />
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Details"
                       asp-route-id="@child.Id"
                       asp-route-returnUrl="@currentUrl"
                       class="btn btn-sm btn-outline-secondary">
                        Details
                    </a>

                    @if (User.IsInRole(Admin))
                    {
                        <a asp-action="Edit" asp-route-id="@child.Id" class="btn btn-sm btn-outline-primary">Edit</a>

                        <a asp-action="Delete" asp-route-id="@child.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
}