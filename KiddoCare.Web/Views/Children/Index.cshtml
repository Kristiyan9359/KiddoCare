@using static KiddoCare.Common.RoleConstants
@model IEnumerable<KiddoCare.ViewModels.Children.ChildIndexViewModel>

@{
    ViewData["Title"] = "Children";
}

<h1>Children</h1>

@* @if (ViewBag.MedicalFilter == "with-records")
{
    <div class="alert alert-info d-flex justify-content-between align-items-center">
        <span>Children with medical records.</span>

        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
