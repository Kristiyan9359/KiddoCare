@model IEnumerable<KiddoCare.ViewModels.Children.ChildIndexViewModel>

@{
    ViewData["Title"] = "Children";
}

<h1>Children</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Child</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Full Name</th>
            <th>Date of Birth</th>
            <th>Gender</th>
            <th>Group</th>
            <th class="text-end">Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var child in Model)
        {
            <tr>
                <td>@child.FullName</td>
                <td>@child.DateOfBirth.ToString("dd MMM yyyy")</td>
                <td>@child.Gender</td>
                <td>@child.GroupName</td>
                <td>
                    @if (!string.IsNullOrEmpty(child.PhotoUrl))
                    {
                        <img src="@child.PhotoUrl" alt="Child Photo" class="img-thumbnail" style="max-width: 100px; max-height: 100px;" />
                    }
                </td>
                <td class="text-end">
                    <a asp-action="Edit" asp-route-id="@child.Id" class="btn btn-sm btn-outline-primary">Edit</a>

                    <form asp-action="Delete" asp-route-id="@child.Id" method="post" class="d-inline">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            Delete
                        </button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>