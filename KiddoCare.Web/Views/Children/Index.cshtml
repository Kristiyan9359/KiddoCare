@using static KiddoCare.Common.RoleConstants
@model KiddoCare.ViewModels.Children.ChildListViewModel

@{
    ViewData["Title"] = "Children";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    bool isAdmin = User.IsInRole(Admin);
}

<div class="list-page-header">
    <div>
        <div class="page-kicker">Child records</div>
        <h1>Children</h1>
        <p class="list-page-subtitle">
            Browse children, groups, photos and important medical indicators.
        </p>
    </div>

    <div class="page-actions">
        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
        {
            <a href="@Model.ReturnUrl" class="btn btn-secondary">Back</a>
        }

        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-primary">Add Child</a>
        }
    </div>
</div>

<section class="section-panel mb-4">
    <form id="childrenFilterForm" asp-action="Index" method="get" class="filter-form">
        <input type="hidden" name="page" value="1" />
        <input asp-for="PageSize" type="hidden" id="childrenPageSizeHidden" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

        <div class="filter-bar mb-3">
            <a asp-action="Index"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-returnUrl="@Model.ReturnUrl"
               asp-route-pageSize="@Model.PageSize"
               class="btn btn-sm @(Model.MedicalRecordsFilter == null ? "btn-primary" : "btn-outline-primary")">
                All children
            </a>

            <a asp-action="Index"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-medicalFilter="with-records"
               asp-route-returnUrl="@Model.ReturnUrl"
               asp-route-pageSize="@Model.PageSize"
               class="btn btn-sm @(Model.MedicalRecordsFilter == "with-records" ? "btn-primary" : "btn-outline-primary")">
                With medical records
            </a>

            <a asp-action="Index"
               asp-route-searchTerm="@Model.SearchTerm"
               asp-route-medicalFilter="with-allergies"
               asp-route-returnUrl="@Model.ReturnUrl"
               asp-route-pageSize="@Model.PageSize"
               class="btn btn-sm @(Model.MedicalRecordsFilter == "with-allergies" ? "btn-primary" : "btn-outline-primary")">
                With allergies
            </a>
        </div>

        <input type="hidden" name="medicalFilter" value="@Model.MedicalRecordsFilter" />

        <div class="form-grid align-items-end">
            <div class="mb-3 search-suggest-wrapper">
                <label asp-for="SearchTerm" class="form-label">Search</label>
                <input asp-for="SearchTerm"
                       id="childrenSearchInput"
                       class="form-control"
                       autocomplete="off"
                       placeholder="Search by child, group, parent or email..." />

                <div id="childrenSearchSuggestions"
                     class="search-suggestions"
                     hidden>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="btn btn-secondary">
                    Clear
                </a>
            </div>
        </div>
    </form>
</section>

<section id="children-list" class="section-panel">
    <div class="section-panel-header">
        <div>
            <h2 class="section-panel-title">Children</h2>
            <p class="section-panel-subtitle">
                @Model.TotalChildren child records found.
            </p>
        </div>

        <div class="records-toolbar">
            <div class="records-page-size">
                <label for="childrenPageSizeSelect" class="form-label mb-0">Show</label>
                <select id="childrenPageSizeSelect" class="form-select form-select-sm">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="15" selected="@(Model.PageSize == 15)">15</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                </select>
            </div>

            @if (Model.TotalPages > 0)
            {
                <div class="text-muted">
                    Page @Model.Page of @Model.TotalPages
                </div>
            }
        </div>
    </div>

    @if (!Model.Children.Any())
    {
        <section class="empty-state compact-empty-state">
            <h2>No children found</h2>
            <p>Try changing the search, medical filter or add a new child profile.</p>
        </section>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0 mobile-card-table">
                <thead>
                    <tr>
                        <th>Photo</th>
                        <th>Full Name</th>
                        <th>Date of Birth</th>
                        <th>Gender</th>
                        <th>Group</th>
                        <th>Medical</th>
                        <th>Allergies</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var child in Model.Children)
                    {
                        <tr>
                            <td data-label="Photo">
                                @if (!string.IsNullOrWhiteSpace(child.PhotoUrl))
                                {
                                    <img src="@Url.Action("Photo", "Children", new { id = child.Id })"
                                         alt="@child.FullName"
                                         class="child-avatar" />
                                }
                                else
                                {
                                    <div class="child-avatar-placeholder">
                                        @child.FullName.Substring(0, 1)
                                    </div>
                                }
                            </td>
                            <td data-label="Full Name">
                                <strong>@child.FullName</strong>
                            </td>
                            <td data-label="Date of Birth">@child.DateOfBirth.ToString("dd MMM yyyy")</td>
                            <td data-label="Gender">@child.Gender</td>
                            <td data-label="Group">@child.GroupName</td>
                            <td data-label="Medical">
                                @if (child.HasMedicalRecord)
                                {
                                    <span class="badge bg-info text-dark">Yes</span>
                                }
                                else
                                {
                                    <span class="badge status-badge-muted">No</span>
                                }
                            </td>
                            <td data-label="Allergies">
                                @if (child.HasAllergies)
                                {
                                    <span class="badge bg-warning text-dark">Yes</span>
                                }
                                else
                                {
                                    <span class="badge status-badge-muted">No</span>
                                }
                            </td>
                            <td class="text-end" data-label="Actions">
                                <a asp-action="Details"
                                   asp-route-id="@child.Id"
                                   asp-route-returnUrl="@currentUrl"
                                   class="btn btn-sm btn-outline-secondary">
                                    Details
                                </a>

                                @if (isAdmin)
                                {
                                    <a asp-action="Edit"
                                       asp-route-id="@child.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@child.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="attendance-pager" aria-label="Children pages">
                <a class="attendance-page-link @(Model.HasPreviousPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-medicalFilter="@Model.MedicalRecordsFilter"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="children-list">
                    Previous
                </a>

                <div class="attendance-page-numbers">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <a class="attendance-page-number @(pageNumber == Model.Page ? "active" : string.Empty)"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-medicalFilter="@Model.MedicalRecordsFilter"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           asp-route-page="@pageNumber"
                           asp-route-pageSize="@Model.PageSize"
                           asp-fragment="children-list">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="attendance-page-link @(Model.HasNextPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-medicalFilter="@Model.MedicalRecordsFilter"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="children-list">
                    Next
                </a>
            </nav>
        }
    }
</section>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('childrenFilterForm');
            const searchInput = document.getElementById('childrenSearchInput');
            const pageSizeSelect = document.getElementById('childrenPageSizeSelect');
            const pageSizeHidden = document.getElementById('childrenPageSizeHidden');
            const suggestionsBox = document.getElementById('childrenSearchSuggestions');

            if (!form || !searchInput || !pageSizeSelect || !pageSizeHidden || !suggestionsBox) {
                return;
            }

            let suggestionsTimeout;
            let activeSuggestionIndex = -1;

            const hideSuggestions = () => {
                suggestionsBox.hidden = true;
                suggestionsBox.innerHTML = '';
                activeSuggestionIndex = -1;
            };

            const getSuggestionButtons = () => {
                return Array.from(suggestionsBox.querySelectorAll('button'));
            };

            const setActiveSuggestion = (index) => {
                const buttons = getSuggestionButtons();

                buttons.forEach(button => button.classList.remove('active'));

                if (index >= 0 && index < buttons.length) {
                    buttons[index].classList.add('active');
                    buttons[index].scrollIntoView({ block: 'nearest' });
                }

                activeSuggestionIndex = index;
            };

            const renderSuggestions = (items) => {
                suggestionsBox.innerHTML = '';

                if (!items.length) {
                    hideSuggestions();
                    return;
                }

                items.forEach(item => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'search-suggestion-item';
                    button.textContent = item;

                    button.addEventListener('click', () => {
                        searchInput.value = item;
                        hideSuggestions();
                        form.submit();
                    });

                    suggestionsBox.appendChild(button);
                });

                suggestionsBox.hidden = false;
                activeSuggestionIndex = -1;
            };

            searchInput.addEventListener('input', () => {
                clearTimeout(suggestionsTimeout);

                const term = searchInput.value.trim();

                if (term.length < 2) {
                    hideSuggestions();
                    return;
                }

                suggestionsTimeout = setTimeout(async () => {
                    const response = await fetch(`/Children/Suggestions?term=${encodeURIComponent(term)}`);

                    if (!response.ok) {
                        hideSuggestions();
                        return;
                    }

                    const items = await response.json();
                    renderSuggestions(items);
                }, 250);
            });

            searchInput.addEventListener('keydown', (event) => {
                const buttons = getSuggestionButtons();

                if (event.key === 'Escape') {
                    hideSuggestions();
                    return;
                }

                if (suggestionsBox.hidden || !buttons.length) {
                    return;
                }

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    setActiveSuggestion((activeSuggestionIndex + 1) % buttons.length);
                }

                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    setActiveSuggestion(activeSuggestionIndex <= 0 ? buttons.length - 1 : activeSuggestionIndex - 1);
                }

                if (event.key === 'Enter' && activeSuggestionIndex >= 0) {
                    event.preventDefault();
                    buttons[activeSuggestionIndex].click();
                }
            });

            pageSizeSelect.addEventListener('change', () => {
                pageSizeHidden.value = pageSizeSelect.value;
                form.submit();
            });

            document.addEventListener('click', (event) => {
                if (!suggestionsBox.contains(event.target) && event.target !== searchInput) {
                    hideSuggestions();
                }
            });
        })();
    </script>
}
