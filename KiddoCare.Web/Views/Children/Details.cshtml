@model KiddoCare.ViewModels.Children.ChildDetailsViewModel

@{
    ViewData["Title"] = "Child Details";
}

<h1>@Model.FullName</h1>

<div class="row">
    <div class="col-md-3">
        @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" alt="@Model.FullName" class="img-fluid rounded" />
        }
    </div>

    <div class="col-md-9">
        <dl class="row">
            <dt class="col-sm-3">Date of Birth</dt>
            <dd class="col-sm-9">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">Gender</dt>
            <dd class="col-sm-9">@Model.Gender</dd>

            <dt class="col-sm-3">Group</dt>
            <dd class="col-sm-9">@Model.GroupName</dd>

            <dt class="col-sm-3">Parent</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.ParentName))
                {
                    <span>No parent linked.</span>
                }
                else
                {
                    <div>@Model.ParentName</div>
                    <div>@Model.ParentEmail</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.ParentPhoneNumber) ? "No phone number" : Model.ParentPhoneNumber)</div>
                }
            </dd>

            <dt class="col-sm-3">Allergies</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.Allergies) ? "None" : Model.Allergies)
            </dd>

            <dt class="col-sm-3">Additional Notes</dt>
            <dd class="col-sm-9">
                @(string.IsNullOrWhiteSpace(Model.AdditionalNotes) ? "None" : Model.AdditionalNotes)
            </dd>
        </dl>

        @if (Model.HasMedicalRecord)
        {
            <a asp-controller="MedicalRecords"
               asp-action="Details"
               asp-route-childId="@Model.Id"
               class="btn btn-outline-info">
                Medical Record
            </a>
        }
        else if (User.IsInRole("Admin"))
        {
            <a asp-controller="MedicalRecords"
               asp-action="Create"
               class="btn btn-outline-info">
                Add Medical Record
            </a>
        }

        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>