@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.Children.ChildDetailsViewModel

@{
    ViewData["Title"] = T["Child Details"];
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? (User.IsInRole("Parent")
        ? Url.Action("Index", "Dashboard")
        : Url.Action("Index"));
}

<div class="profile-page-header">
    <div class="profile-hero-card">
        <div class="profile-photo">
            @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
            {
                <img src="@Url.Action("Photo", "Children", new { id = Model.Id })"
                     alt="@Model.FullName" />
            }
            else
            {
                <div class="profile-photo-placeholder">
                    @Model.FullName.Substring(0, 1)
                </div>
            }
        </div>

        <div class="profile-summary">
            <div class="page-kicker">@T["Child profile"]</div>
            <h1 class="page-title">@Model.FullName</h1>
            <p class="page-subtitle">
                @T["Group, family contact, medical notes and recent activity for this child."]
            </p>

            <div class="profile-action-row">
                <a asp-controller="ActivityFeed"
                   asp-action="Child"
                   asp-route-childId="@Model.Id"
                   asp-route-returnUrl="@currentUrl"
                   class="btn btn-outline-primary">
                    @T["Activity Feed"]
                </a>

                @if (Model.HasMedicalRecord)
                {
                    <a asp-controller="MedicalRecords"
                       asp-action="Details"
                       asp-route-childId="@Model.Id"
                       asp-route-returnUrl="@currentUrl"
                       class="btn btn-outline-secondary">
                        @T["Medical Record"]
                    </a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <a asp-controller="MedicalRecords"
                       asp-action="Create"
                       asp-route-childId="@Model.Id"
                       asp-route-returnUrl="@currentUrl"
                       class="btn btn-outline-secondary">
                        @T["Add Medical Record"]
                    </a>
                }

                <a href="@backUrl" class="btn btn-secondary">@T["Back"]</a>
            </div>
        </div>
    </div>
</div>

<div class="profile-info-grid">
    <section class="info-panel">
        <div class="info-panel-header">
            <h2>@T["Child Information"]</h2>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Date of Birth"]</dt>
                <dd>@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>
            </div>
            <div>
                <dt>@T["Gender"]</dt>
                <dd>@T[Model.Gender.ToString()]</dd>
            </div>
            <div>
                <dt>@T["Group"]</dt>
                <dd>@Model.GroupName</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="info-panel-header">
            <h2>@T["Parent Contact"]</h2>
        </div>

        @if (string.IsNullOrWhiteSpace(Model.ParentName))
        {
            <p class="empty-state">@T["No parent linked."]</p>
        }
        else
        {
            <dl class="info-list">
                <div>
                    <dt>@T["Name"]</dt>
                    <dd>@Model.ParentName</dd>
                </div>
                <div>
                    <dt>@T["Email"]</dt>
                    <dd>@Model.ParentEmail</dd>
                </div>
                <div>
                    <dt>@T["Phone"]</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.ParentPhoneNumber) ? T["No phone number"].Value : Model.ParentPhoneNumber)</dd>
                </div>
            </dl>
        }
    </section>
</div>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">@T["Medical Summary"]</h2>

        @if (Model.HasMedicalRecord)
        {
            <a asp-controller="MedicalRecords"
               asp-action="Details"
               asp-route-childId="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-sm btn-outline-secondary">
                @T["View Full Record"]
            </a>
        }
    </div>

    @if (Model.HasMedicalRecord)
    {
        <div class="medical-summary-grid">
            <div class="medical-summary-item">
                <span>@T["Allergies"]</span>
                <strong>@(Model.MedicalAllergies ?? T["No allergies recorded."].Value)</strong>
            </div>

            <div class="medical-summary-item">
                <span>@T["Chronic Conditions"]</span>
                <strong>@(Model.MedicalChronicConditions ?? T["No chronic conditions recorded."].Value)</strong>
            </div>

            <div class="medical-summary-item">
                <span>@T["Emergency Contact"]</span>
                @if (!string.IsNullOrWhiteSpace(Model.MedicalEmergencyContactName) ||
                    !string.IsNullOrWhiteSpace(Model.MedicalEmergencyContactPhone))
                {
                    <strong>@Model.MedicalEmergencyContactName</strong>
                    <small>@Model.MedicalEmergencyContactPhone</small>
                }
                else
                {
                    <strong>@T["No emergency contact recorded."]</strong>
                }
            </div>
        </div>
    }
    else
    {
        <p class="empty-state">@T["No medical record added yet."]</p>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">@T["Recent Absence Notices"]</h2>
    </div>

    @if (!Model.RecentAbsenceRequests.Any())
    {
        <p class="empty-state">@T["No absence notices yet."]</p>
    }
    else
    {
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>@T["Period"]</th>
                    <th>@T["Reason"]</th>
                    <th>@T["Status"]</th>
                    <th class="text-end">@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.RecentAbsenceRequests)
                {
                    <tr>
                        <td>
                            @request.StartDate.ToString("dd MMM yyyy")
                            -
                            @request.EndDate.ToString("dd MMM yyyy")
                        </td>
                        <td>@T[request.Reason.ToString()]</td>
                        <td>
                            @if (request.Status == RequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">@T["Pending"]</span>
                            }
                            else if (request.Status == RequestStatus.Approved)
                            {
                                <span class="badge bg-success">@T["Confirmed"]</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-controller="AbsenceRequests"
                               asp-action="Details"
                               asp-route-id="@request.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                @T["Details"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">@T["Recent Consent Requests"]</h2>
    </div>

    @if (!Model.RecentConsentRequests.Any())
    {
        <p class="empty-state">@T["No consent requests yet."]</p>
    }
    else
    {
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>@T["Title"]</th>
                    <th>@T["Type"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["Created On"]</th>
                    <th class="text-end">@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.RecentConsentRequests)
                {
                    <tr>
                        <td>@request.Title</td>
                        <td>@T[request.Type.ToString()]</td>
                        <td>
                            @if (request.Status == RequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">@T["Pending"]</span>
                            }
                            else if (request.Status == RequestStatus.Approved)
                            {
                                <span class="badge bg-success">@T["Approved"]</span>
                            }
                            else if (request.Status == RequestStatus.Rejected)
                            {
                                <span class="badge bg-danger">@T["Rejected"]</span>
                            }
                        </td>
                        <td>@request.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td class="text-end">
                            <a asp-controller="ConsentRequests"
                               asp-action="Details"
                               asp-route-id="@request.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                @T["Details"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">@T["Recent Documents"]</h2>
    </div>

    @if (!Model.RecentDocuments.Any())
    {
        <p class="empty-state">@T["No documents uploaded yet."]</p>
    }
    else
    {
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>@T["Title"]</th>
                    <th>@T["Type"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["Uploaded On"]</th>
                    <th class="text-end">@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var document in Model.RecentDocuments)
                {
                    <tr>
                        <td>@document.Title</td>
                        <td>@T[document.Type.ToString()]</td>
                        <td>
                            @if (document.Status == RequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">@T["Pending"]</span>
                            }
                            else if (document.Status == RequestStatus.Approved)
                            {
                                <span class="badge bg-success">@T["Approved"]</span>
                            }
                            else if (document.Status == RequestStatus.Rejected)
                            {
                                <span class="badge bg-danger">@T["Rejected"]</span>
                            }
                        </td>
                        <td>@document.UploadedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td class="text-end">
                            <a asp-controller="ChildDocuments"
                               asp-action="Details"
                               asp-route-id="@document.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                @T["Details"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
