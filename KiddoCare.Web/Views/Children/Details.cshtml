@model KiddoCare.ViewModels.Children.ChildDetailsViewModel

@{
    ViewData["Title"] = "Child Details";
}

<h1>@Model.FullName</h1>

<div class="row">
    <div class="col-md-3">
        @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" alt="@Model.FullName" class="img-fluid rounded" />
        }
    </div>

    <div class="col-md-9">
        <dl class="row">
            <dt class="col-sm-3">Date of Birth</dt>
            <dd class="col-sm-9">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">Gender</dt>
            <dd class="col-sm-9">@Model.Gender</dd>

            <dt class="col-sm-3">Group</dt>
            <dd class="col-sm-9">@Model.GroupName</dd>

            <dt class="col-sm-3">Parent</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.ParentName))
                {
                    <span>No parent linked.</span>
                }
                else
                {
                    <div>@Model.ParentName</div>
                    <div>@Model.ParentEmail</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.ParentPhoneNumber) ? "No phone number" : Model.ParentPhoneNumber)</div>
                }
            </dd>
        </dl>

        <h2>Medical Summary</h2>

        @if (Model.HasMedicalRecord)
        {
            <dl class="row">
                <dt class="col-sm-3">Allergies</dt>
                <dd class="col-sm-9">@(Model.MedicalAllergies ?? "No allergies recorded.")</dd>

                <dt class="col-sm-3">Chronic Conditions</dt>
                <dd class="col-sm-9">@(Model.MedicalChronicConditions ?? "No chronic conditions recorded.")</dd>

                <dt class="col-sm-3">Emergency Contact</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.MedicalEmergencyContactName) ||
                        !string.IsNullOrWhiteSpace(Model.MedicalEmergencyContactPhone))
                    {
                        <span>@Model.MedicalEmergencyContactName</span>
                        <span>@Model.MedicalEmergencyContactPhone</span>
                    }
                    else
                    {
                        <span>No emergency contact recorded.</span>
                    }
                </dd>
            </dl>

            <a asp-controller="MedicalRecords"
               asp-action="Details"
               asp-route-childId="@Model.Id"
               class="btn btn-outline-info">
                View Full Medical Record
            </a>
        }
        else
        {
            <p class="text-muted">No medical record added yet.</p>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="MedicalRecords"
                   asp-action="Create"
                   asp-route-childId="@Model.Id"
                   class="btn btn-outline-info">
                    Add Medical Record
                </a>
            }
        }

        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>