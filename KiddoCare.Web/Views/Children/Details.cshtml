@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.Children.ChildDetailsViewModel

@{
    ViewData["Title"] = "Child Details";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? (User.IsInRole("Parent")
        ? Url.Action("Index", "Dashboard")
        : Url.Action("Index"));
}

<div class="profile-page-header">
    <div class="profile-hero-card">
        <div class="profile-photo">
            @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
            {
                <img src="@Url.Action("Photo", "Children", new { id = Model.Id })"
                     alt="@Model.FullName" />
            }
            else
            {
                <div class="profile-photo-placeholder">
                    @Model.FullName.Substring(0, 1)
                </div>
            }
        </div>

        <div class="profile-summary">
            <div class="page-kicker">Child profile</div>
            <h1 class="page-title">@Model.FullName</h1>
            <p class="page-subtitle">
                Group, family contact, medical notes and recent activity for this child.
            </p>

            <div class="profile-action-row">
                <a asp-controller="ActivityFeed"
                   asp-action="Child"
                   asp-route-childId="@Model.Id"
                   asp-route-returnUrl="@currentUrl"
                   class="btn btn-outline-primary">
                    Activity Feed
                </a>

                @if (Model.HasMedicalRecord)
                {
                    <a asp-controller="MedicalRecords"
                       asp-action="Details"
                       asp-route-childId="@Model.Id"
                       asp-route-returnUrl="@currentUrl"
                       class="btn btn-outline-secondary">
                        Medical Record
                    </a>
                }
                else if (User.IsInRole("Admin"))
                {
                    <a asp-controller="MedicalRecords"
                       asp-action="Create"
                       asp-route-childId="@Model.Id"
                       asp-route-returnUrl="@currentUrl"
                       class="btn btn-outline-secondary">
                        Add Medical Record
                    </a>
                }

                <a href="@backUrl" class="btn btn-secondary">Back</a>
            </div>
        </div>
    </div>
</div>

<div class="profile-info-grid">
    <section class="info-panel">
        <div class="info-panel-header">
            <h2>Child Information</h2>
        </div>

        <dl class="info-list">
            <div>
                <dt>Date of Birth</dt>
                <dd>@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>
            </div>
            <div>
                <dt>Gender</dt>
                <dd>@Model.Gender</dd>
            </div>
            <div>
                <dt>Group</dt>
                <dd>@Model.GroupName</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="info-panel-header">
            <h2>Parent Contact</h2>
        </div>

        @if (string.IsNullOrWhiteSpace(Model.ParentName))
        {
            <p class="empty-state">No parent linked.</p>
        }
        else
        {
            <dl class="info-list">
                <div>
                    <dt>Name</dt>
                    <dd>@Model.ParentName</dd>
                </div>
                <div>
                    <dt>Email</dt>
                    <dd>@Model.ParentEmail</dd>
                </div>
                <div>
                    <dt>Phone</dt>
                    <dd>@(string.IsNullOrWhiteSpace(Model.ParentPhoneNumber) ? "No phone number" : Model.ParentPhoneNumber)</dd>
                </div>
            </dl>
        }
    </section>
</div>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">Medical Summary</h2>

        @if (Model.HasMedicalRecord)
        {
            <a asp-controller="MedicalRecords"
               asp-action="Details"
               asp-route-childId="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-sm btn-outline-secondary">
                View Full Record
            </a>
        }
    </div>

    @if (Model.HasMedicalRecord)
    {
        <div class="medical-summary-grid">
            <div class="medical-summary-item">
                <span>Allergies</span>
                <strong>@(Model.MedicalAllergies ?? "No allergies recorded.")</strong>
            </div>

            <div class="medical-summary-item">
                <span>Chronic Conditions</span>
                <strong>@(Model.MedicalChronicConditions ?? "No chronic conditions recorded.")</strong>
            </div>

            <div class="medical-summary-item">
                <span>Emergency Contact</span>
                @if (!string.IsNullOrWhiteSpace(Model.MedicalEmergencyContactName) ||
                    !string.IsNullOrWhiteSpace(Model.MedicalEmergencyContactPhone))
                {
                    <strong>@Model.MedicalEmergencyContactName</strong>
                    <small>@Model.MedicalEmergencyContactPhone</small>
                }
                else
                {
                    <strong>No emergency contact recorded.</strong>
                }
            </div>
        </div>
    }
    else
    {
        <p class="empty-state">No medical record added yet.</p>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">Recent Absence Notices</h2>
    </div>

    @if (!Model.RecentAbsenceRequests.Any())
    {
        <p class="empty-state">No absence notices yet.</p>
    }
    else
    {
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Period</th>
                    <th>Reason</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.RecentAbsenceRequests)
                {
                    <tr>
                        <td>
                            @request.StartDate.ToString("dd MMM yyyy")
                            -
                            @request.EndDate.ToString("dd MMM yyyy")
                        </td>
                        <td>@request.Reason</td>
                        <td>
                            @if (request.Status == RequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (request.Status == RequestStatus.Approved)
                            {
                                <span class="badge bg-success">Confirmed</span>
                            }
                        </td>
                        <td class="text-end">
                            <a asp-controller="AbsenceRequests"
                               asp-action="Details"
                               asp-route-id="@request.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">Recent Consent Requests</h2>
    </div>

    @if (!Model.RecentConsentRequests.Any())
    {
        <p class="empty-state">No consent requests yet.</p>
    }
    else
    {
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Created On</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.RecentConsentRequests)
                {
                    <tr>
                        <td>@request.Title</td>
                        <td>@request.Type</td>
                        <td>
                            @if (request.Status == RequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (request.Status == RequestStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (request.Status == RequestStatus.Rejected)
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>
                        <td>@request.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td class="text-end">
                            <a asp-controller="ConsentRequests"
                               asp-action="Details"
                               asp-route-id="@request.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">Recent Documents</h2>
    </div>

    @if (!Model.RecentDocuments.Any())
    {
        <p class="empty-state">No documents uploaded yet.</p>
    }
    else
    {
        <table class="table table-striped mb-0">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Uploaded On</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var document in Model.RecentDocuments)
                {
                    <tr>
                        <td>@document.Title</td>
                        <td>@document.Type</td>
                        <td>
                            @if (document.Status == RequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (document.Status == RequestStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (document.Status == RequestStatus.Rejected)
                            {
                                <span class="badge bg-danger">Rejected</span>
                            }
                        </td>
                        <td>@document.UploadedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td class="text-end">
                            <a asp-controller="ChildDocuments"
                               asp-action="Details"
                               asp-route-id="@document.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
