@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.Children.ChildDetailsViewModel

@{
    ViewData["Title"] = "Child Details";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? (User.IsInRole("Parent")
        ? Url.Action("Index", "Dashboard")
        : Url.Action("Index"));
}

<h1>@Model.FullName</h1>

<div class="row">
    <div class="col-md-3">
        @if (!string.IsNullOrWhiteSpace(Model.PhotoUrl))
        {
            <img src="@Url.Action("Photo", "Children", new { id = Model.Id })" alt="@Model.FullName" class="img-fluid rounded" />
        }
    </div>

    <div class="col-md-9">
        <dl class="row">
            <dt class="col-sm-3">Date of Birth</dt>
            <dd class="col-sm-9">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>

            <dt class="col-sm-3">Gender</dt>
            <dd class="col-sm-9">@Model.Gender</dd>

            <dt class="col-sm-3">Group</dt>
            <dd class="col-sm-9">@Model.GroupName</dd>

            <dt class="col-sm-3">Parent</dt>
            <dd class="col-sm-9">
                @if (string.IsNullOrWhiteSpace(Model.ParentName))
                {
                    <span>No parent linked.</span>
                }
                else
                {
                    <div>@Model.ParentName</div>
                    <div>@Model.ParentEmail</div>
                    <div>@(string.IsNullOrWhiteSpace(Model.ParentPhoneNumber) ? "No phone number" : Model.ParentPhoneNumber)</div>
                }
            </dd>
        </dl>

        <h2>Medical Summary</h2>

        @if (Model.HasMedicalRecord)
        {
            <dl class="row">
                <dt class="col-sm-3">Allergies</dt>
                <dd class="col-sm-9">@(Model.MedicalAllergies ?? "No allergies recorded.")</dd>

                <dt class="col-sm-3">Chronic Conditions</dt>
                <dd class="col-sm-9">@(Model.MedicalChronicConditions ?? "No chronic conditions recorded.")</dd>

                <dt class="col-sm-3">Emergency Contact</dt>
                <dd class="col-sm-9">
                    @if (!string.IsNullOrWhiteSpace(Model.MedicalEmergencyContactName) ||
                        !string.IsNullOrWhiteSpace(Model.MedicalEmergencyContactPhone))
                    {
                        <span>@Model.MedicalEmergencyContactName</span>
                        <span>@Model.MedicalEmergencyContactPhone</span>
                    }
                    else
                    {
                        <span>No emergency contact recorded.</span>
                    }
                </dd>
            </dl>

            <h2>Recent Absence Notices</h2>

            @if (!Model.RecentAbsenceRequests.Any())
            {
                <p class="text-muted">No absence notices yet.</p>
            }
            else
            {
                <table class="table table-striped mb-3">
                    <thead>
                        <tr>
                            <th>Period</th>
                            <th>Reason</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.RecentAbsenceRequests)
                        {
                            <tr>
                                <td>
                                    @request.StartDate.ToString("dd MMM yyyy")
                                    -
                                    @request.EndDate.ToString("dd MMM yyyy")
                                </td>
                                <td>@request.Reason</td>
                                <td>
                                    @if (request.Status == RequestStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (request.Status == RequestStatus.Approved)
                                    {
                                        <span class="badge bg-success">Confirmed</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a asp-controller="AbsenceRequests"
                                       asp-action="Details"
                                       asp-route-id="@request.Id"
                                       asp-route-returnUrl="@currentUrl"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <h2 class="mt-4">Recent Consent Requests</h2>

            @if (!Model.RecentConsentRequests.Any())
            {
                <p class="text-muted">No consent requests yet.</p>
            }
            else
            {
                <table class="table table-striped mb-3">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Created On</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var request in Model.RecentConsentRequests)
                        {
                            <tr>
                                <td>@request.Title</td>
                                <td>@request.Type</td>
                                <td>
                                    @if (request.Status == RequestStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (request.Status == RequestStatus.Approved)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (request.Status == RequestStatus.Rejected)
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                </td>
                                <td>@request.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="text-end">
                                    <a asp-controller="ConsentRequests"
                                       asp-action="Details"
                                       asp-route-id="@request.Id"
                                       asp-route-returnUrl="@currentUrl"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <h2 class="mt-4">Recent Documents</h2>

            @if (!Model.RecentDocuments.Any())
            {
                <p class="text-muted">No documents uploaded yet.</p>
            }
            else
            {
                <table class="table table-striped mb-3">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Type</th>
                            <th>Status</th>
                            <th>Uploaded On</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var document in Model.RecentDocuments)
                        {
                            <tr>
                                <td>@document.Title</td>
                                <td>@document.Type</td>
                                <td>
                                    @if (document.Status == RequestStatus.Pending)
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else if (document.Status == RequestStatus.Approved)
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (document.Status == RequestStatus.Rejected)
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                </td>
                                <td>@document.UploadedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                                <td class="text-end">
                                    <a asp-controller="ChildDocuments"
                                       asp-action="Details"
                                       asp-route-id="@document.Id"
                                       asp-route-returnUrl="@currentUrl"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <a asp-controller="MedicalRecords"
               asp-action="Details"
               asp-route-childId="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-outline-info">
                View Full Medical Record
            </a>
        }
        else
        {
            <p class="text-muted">No medical record added yet.</p>

            @if (User.IsInRole("Admin"))
            {
                <a asp-controller="MedicalRecords"
                   asp-action="Create"
                   asp-route-childId="@Model.Id"
                   asp-route-returnUrl="@currentUrl"
                   class="btn btn-outline-info">
                    Add Medical Record
                </a>
            }
        }

        <a asp-controller="ActivityFeed"
           asp-action="Child"
           asp-route-childId="@Model.Id"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-outline-primary">
            Activity Feed
        </a>

        <a href="@backUrl" class="btn btn-secondary">Back</a>
    </div>
</div>
