@model KiddoCare.ViewModels.Children.ChildDeleteViewModel

@{
    ViewData["Title"] = "Delete Child";
}

<section class="delete-page">
    <div class="delete-card">
        <div class="delete-kicker">Permanent action</div>
        <h1>Delete Child</h1>
        <p>
            Are you sure you want to delete this child profile? This action cannot be undone.
        </p>

        <dl class="info-list delete-info-list">
            <div>
                <dt>Full Name</dt>
                <dd>@Model.FullName</dd>
            </div>
            <div>
                <dt>Group</dt>
                <dd>@Model.GroupName</dd>
            </div>
            <div>
                <dt>Date of Birth</dt>
                <dd>@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-action-row justify-content-center">
            <input asp-for="Id" type="hidden" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</section>
