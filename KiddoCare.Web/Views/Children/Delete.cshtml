@model KiddoCare.ViewModels.Children.ChildDeleteViewModel

@{
    ViewData["Title"] = T["Delete Child"];
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<section class="delete-page">
    <div class="delete-card">
        <div class="delete-kicker">@T["Permanent action"]</div>
        <h1>@T["Delete Child"]</h1>
        <p>
            @T["Are you sure you want to delete this child profile? This action cannot be undone."]
        </p>

        <dl class="info-list delete-info-list">
            <div>
                <dt>@T["Full Name"]</dt>
                <dd>@Model.FullName</dd>
            </div>
            <div>
                <dt>@T["Group"]</dt>
                <dd>@Model.GroupName</dd>
            </div>
            <div>
                <dt>@T["Date of Birth"]</dt>
                <dd>@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-action-row justify-content-center">
            <input asp-for="Id" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />

            <button type="submit" class="btn btn-danger">@T["Delete"]</button>
            <a href="@backUrl" class="btn btn-secondary">@T["Cancel"]</a>
        </form>
    </div>
</section>
