@model KiddoCare.ViewModels.Children.ChildDeleteViewModel

@{
    ViewData["Title"] = "Delete Child";
}

<h1>Delete Child</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this child profile?
</div>

<dl class="row">
    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Group</dt>
    <dd class="col-sm-9">@Model.GroupName</dd>

    <dt class="col-sm-3">Date of Birth</dt>
    <dd class="col-sm-9">@Model.DateOfBirth.ToString("dd MMM yyyy")</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>