@model KiddoCare.ViewModels.Parents.ParentDetailsViewModel

@{
    ViewData["Title"] = "Parent Details";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Family contacts</div>
        <h1 class="page-title">@Model.FullName</h1>
        <p class="page-subtitle">
            Review contact details and linked children.
        </p>
    </div>

    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Contact Summary</h2>
                <p>Primary parent contact information.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Full Name</dt>
                <dd>@Model.FullName</dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd>@Model.Email</dd>
            </div>
            <div>
                <dt>Phone</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not specified" : Model.PhoneNumber)</dd>
            </div>
            <div>
                <dt>Linked Children</dt>
                <dd>@Model.Children.Count()</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Linked Children</h2>
                <p>Children connected to this parent profile.</p>
            </div>
        </div>

        @if (!Model.Children.Any())
        {
            <div class="empty-state compact-empty-state">
                <h3>No linked children</h3>
                <p>Link a child to this parent from the child edit page.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Child</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var child in Model.Children)
                        {
                            <tr>
                                <td><div class="fw-bold">@child.FullName</div></td>
                                <td class="text-end">
                                    <a asp-controller="Children"
                                       asp-action="Details"
                                       asp-route-id="@child.Id"
                                       asp-route-returnUrl="@Context.Request.Path"
                                       class="btn btn-sm btn-outline-secondary">
                                        View Child
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>