@model KiddoCare.ViewModels.Parents.ParentDetailsViewModel

@{
    ViewData["Title"] = "Parent Details";
}

<h1>@Model.FullName</h1>

<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not specified" : Model.PhoneNumber)</dd>

    <dt class="col-sm-3">Children</dt>
    <dd class="col-sm-9">
        @if (!Model.Children.Any())
        {
            <span>No linked children.</span>
        }
        else
        {
            <table class="table table-sm table-striped">
                <thead>
                    <tr>
                        <th>Child</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var child in Model.Children)
                    {
                        <tr>
                            <td>@child.FullName</td>
                            <td class="text-end">
                                <a asp-controller="Children"
                                   asp-action="Details"
                                   asp-route-id="@child.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    View Child
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back</a>