@model KiddoCare.ViewModels.Parents.ParentDetailsViewModel

@{
    ViewData["Title"] = T["Parent Details"];
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Family contacts"]</div>
        <h1 class="page-title">@Model.FullName</h1>
        <p class="page-subtitle">
            @T["Review contact details and linked children."]
        </p>
    </div>

    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@T["Edit"]</a>
        <a asp-action="Index" class="btn btn-secondary">@T["Back"]</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Contact Summary"]</h2>
                <p>@T["Primary parent contact information."]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Full Name"]</dt>
                <dd>@Model.FullName</dd>
            </div>
            <div>
                <dt>@T["Email"]</dt>
                <dd>@Model.Email</dd>
            </div>
            <div>
                <dt>@T["Phone"]</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? T["Not specified"].Value : Model.PhoneNumber)</dd>
            </div>
            <div>
                <dt>@T["Linked Children"]</dt>
                <dd>@Model.Children.Count()</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Linked Children"]</h2>
                <p>@T["Children connected to this parent profile."]</p>
            </div>
        </div>

        @if (!Model.Children.Any())
        {
            <div class="empty-state compact-empty-state">
                <h3>@T["No linked children"]</h3>
                <p>@T["Link a child to this parent from the child edit page."]</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>@T["Child"]</th>
                            <th class="text-end">@T["Actions"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var child in Model.Children)
                        {
                            <tr>
                                <td><div class="fw-bold">@child.FullName</div></td>
                                <td class="text-end">
                                    <a asp-controller="Children"
                                       asp-action="Details"
                                       asp-route-id="@child.Id"
                                       asp-route-returnUrl="@Context.Request.Path"
                                       class="btn btn-sm btn-outline-secondary">
                                        @T["View Child"]
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
