@model KiddoCare.ViewModels.Parents.ParentCreateViewModel

@{
    ViewData["Title"] = T["Create Parent"];
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Family contacts"]</div>
        <h1 class="page-title">@T["Create Parent"]</h1>
        <p class="page-subtitle">
            @T["Add a parent profile that can later be linked to one or more children."]
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="FullName" class="form-label">@T["Full Name"]</label>
                <input asp-for="FullName" class="form-control" placeholder='@T["Example: Maria Ivanova"]' />
                <span asp-validation-for="FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">@T["Email"]</label>
                <input asp-for="Email" class="form-control" placeholder='@T["parent@example.com"]' />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="PhoneNumber" class="form-label">@T["Phone"]</label>
                <input asp-for="PhoneNumber" class="form-control" placeholder='@T["Optional phone number"]' />
                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
            </div>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">@T["Create"]</button>
            <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
