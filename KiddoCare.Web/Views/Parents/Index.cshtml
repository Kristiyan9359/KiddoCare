@model KiddoCare.ViewModels.Parents.ParentListViewModel

@{
    ViewData["Title"] = "Parents";
}

<div class="list-page-header">
    <div>
        <div class="page-kicker">Family contacts</div>
        <h1 class="page-title">Parents</h1>
        <p class="page-subtitle">
            Manage parent profiles and keep child contact information connected.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">Create Parent</a>
</div>

<section id="parents-list" class="section-panel">
    <div class="section-panel-header">
        <div>
            <h2 class="section-panel-title">Parent Profiles</h2>
            <p class="section-panel-subtitle">
                @Model.TotalParents parent profiles found.
            </p>
        </div>

        <div class="records-toolbar">
            <div class="records-page-size">
                <label for="parentsPageSizeSelect" class="form-label mb-0">Show</label>
                <select id="parentsPageSizeSelect" class="form-select form-select-sm">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="15" selected="@(Model.PageSize == 15)">15</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                </select>
            </div>

            @if (Model.TotalPages > 0)
            {
                <div class="text-muted">
                    Page @Model.Page of @Model.TotalPages
                </div>
            }
        </div>
    </div>

    <form id="parentsFilterForm" asp-action="Index" method="get" class="filter-form mb-3">
        <input type="hidden" name="page" value="1" />
        <input asp-for="PageSize" type="hidden" id="parentsPageSizeHidden" />

        <div class="form-grid align-items-end">
            <div class="mb-3 search-suggest-wrapper">
                <label asp-for="SearchTerm" class="form-label">Search</label>
                <input asp-for="SearchTerm"
                       id="parentsSearchInput"
                       class="form-control"
                       autocomplete="off"
                       placeholder="Search by name, email or phone..." />

                <div id="parentsSearchSuggestions"
                     class="search-suggestions"
                     hidden>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index" class="btn btn-secondary">Clear</a>
            </div>
        </div>
    </form>

    @if (!Model.Parents.Any())
    {
        <section class="empty-state compact-empty-state">
            <div class="empty-state-icon">+</div>
            <h2>No parents found</h2>
            <p>Try changing the search term or create a new parent profile.</p>
            <a asp-action="Create" class="btn btn-primary">Create Parent</a>
        </section>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Full Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Children</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var parent in Model.Parents)
                    {
                        <tr>
                            <td><div class="fw-bold">@parent.FullName</div></td>
                            <td>@parent.Email</td>
                            <td>
                                @(string.IsNullOrWhiteSpace(parent.PhoneNumber) ? "Not specified" : parent.PhoneNumber)
                            </td>
                            <td>@parent.ChildrenCount</td>
                            <td class="text-end">
                                <div class="action-buttons">
                                    <a asp-action="Details"
                                       asp-route-id="@parent.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@parent.Id"
                                       class="btn btn-sm btn-outline-primary">
                                        Edit
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@parent.Id"
                                       class="btn btn-sm btn-outline-danger">
                                        Delete
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="attendance-pager" aria-label="Parents pages">
                <a class="attendance-page-link @(Model.HasPreviousPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="parents-list">
                    Previous
                </a>

                <div class="attendance-page-numbers">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <a class="attendance-page-number @(pageNumber == Model.Page ? "active" : string.Empty)"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-page="@pageNumber"
                           asp-route-pageSize="@Model.PageSize"
                           asp-fragment="parents-list">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="attendance-page-link @(Model.HasNextPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="parents-list">
                    Next
                </a>
            </nav>
        }
    }
</section>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('parentsFilterForm');
            const searchInput = document.getElementById('parentsSearchInput');
            const pageSizeSelect = document.getElementById('parentsPageSizeSelect');
            const pageSizeHidden = document.getElementById('parentsPageSizeHidden');
            const suggestionsBox = document.getElementById('parentsSearchSuggestions');

            if (!form || !searchInput || !pageSizeSelect || !pageSizeHidden || !suggestionsBox) {
                return;
            }

            let suggestionsTimeout;
            let activeSuggestionIndex = -1;

            const hideSuggestions = () => {
                suggestionsBox.hidden = true;
                suggestionsBox.innerHTML = '';
                activeSuggestionIndex = -1;
            };

            const getSuggestionButtons = () => {
                return Array.from(suggestionsBox.querySelectorAll('button'));
            };

            const setActiveSuggestion = (index) => {
                const buttons = getSuggestionButtons();

                buttons.forEach(button => button.classList.remove('active'));

                if (index >= 0 && index < buttons.length) {
                    buttons[index].classList.add('active');
                    buttons[index].scrollIntoView({ block: 'nearest' });
                }

                activeSuggestionIndex = index;
            };

            const renderSuggestions = (items) => {
                suggestionsBox.innerHTML = '';

                if (!items.length) {
                    hideSuggestions();
                    return;
                }

                items.forEach(item => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'search-suggestion-item';
                    button.textContent = item;

                    button.addEventListener('click', () => {
                        searchInput.value = item;
                        hideSuggestions();
                        form.submit();
                    });

                    suggestionsBox.appendChild(button);
                });

                suggestionsBox.hidden = false;
                activeSuggestionIndex = -1;
            };

            searchInput.addEventListener('input', () => {
                clearTimeout(suggestionsTimeout);

                const term = searchInput.value.trim();

                if (term.length < 2) {
                    hideSuggestions();
                    return;
                }

                suggestionsTimeout = setTimeout(async () => {
                    const response = await fetch(`/Parents/Suggestions?term=${encodeURIComponent(term)}`);

                    if (!response.ok) {
                        hideSuggestions();
                        return;
                    }

                    const items = await response.json();
                    renderSuggestions(items);
                }, 250);
            });

            searchInput.addEventListener('keydown', (event) => {
                const buttons = getSuggestionButtons();

                if (event.key === 'Escape') {
                    hideSuggestions();
                    return;
                }

                if (suggestionsBox.hidden || !buttons.length) {
                    return;
                }

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    setActiveSuggestion((activeSuggestionIndex + 1) % buttons.length);
                }

                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    setActiveSuggestion(activeSuggestionIndex <= 0 ? buttons.length - 1 : activeSuggestionIndex - 1);
                }

                if (event.key === 'Enter' && activeSuggestionIndex >= 0) {
                    event.preventDefault();
                    buttons[activeSuggestionIndex].click();
                }
            });

            pageSizeSelect.addEventListener('change', () => {
                pageSizeHidden.value = pageSizeSelect.value;
                form.submit();
            });

            document.addEventListener('click', (event) => {
                if (!suggestionsBox.contains(event.target) && event.target !== searchInput) {
                    hideSuggestions();
                }
            });
        })();
    </script>
}
