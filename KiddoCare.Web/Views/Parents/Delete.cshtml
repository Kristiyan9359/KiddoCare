@model KiddoCare.ViewModels.Parents.ParentDeleteViewModel

@{
    ViewData["Title"] = "Delete Parent";
}

<h1>Delete Parent</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this parent profile?
</div>

<dl class="row">
    <dt class="col-sm-3">Full Name</dt>
    <dd class="col-sm-9">@Model.FullName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Linked Children</dt>
    <dd class="col-sm-9">@Model.ChildrenCount</dd>
</dl>

<form asp-action="Delete" method="post">
    <input asp-for="Id" type="hidden" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>