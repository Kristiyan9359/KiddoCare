@model KiddoCare.ViewModels.Parents.ParentDeleteViewModel

@{
    ViewData["Title"] = T["Delete Parent"];
}

<section class="delete-page">
    <div class="delete-card">
        <div class="delete-kicker">@T["Permanent action"]</div>
        <h1>@T["Delete Parent"]</h1>
        <p>
            @T["Are you sure you want to delete this parent profile? This action cannot be undone."]
        </p>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <dl class="info-list delete-info-list">
            <div>
                <dt>@T["Full Name"]</dt>
                <dd>@Model.FullName</dd>
            </div>
            <div>
                <dt>@T["Email"]</dt>
                <dd>@Model.Email</dd>
            </div>
            <div>
                <dt>@T["Linked Children"]</dt>
                <dd>@Model.ChildrenCount</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-action-row justify-content-center">
            <input asp-for="Id" type="hidden" />

            <button type="submit" class="btn btn-danger">@T["Delete"]</button>
            <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
        </form>
    </div>
</section>
