@using System.Text.Json
@model KiddoCare.ViewModels.Messages.MessageCreateViewModel

@{
    ViewData["Title"] = T["New conversation"];

    var labels = new
    {
        selectRecipientFirst = T["Select recipient first"].Value,
        selectChildOptional = T["Select child..."].Value,
        noChildren = T["No available children for this recipient."].Value,
        helpDefault = T["Select a recipient first to see available children."].Value,
        helpLoaded = T["Choose a child if the conversation is about a specific child."].Value
    };
}

<section class="list-page-header">
    <div>
        <div class="page-kicker">@T["Messages"]</div>
        <h1>@T["New conversation"]</h1>
        <p class="page-subtitle">@T["Start a private conversation with a parent, teacher or the administration."]</p>
    </div>
</section>

<section class="section-panel">
    <form asp-action="Create" method="post" class="form-grid">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="mb-3">
            <label asp-for="RecipientUserId" class="form-label">@T["Recipient"]</label>
            <select asp-for="RecipientUserId" asp-items="Model.Recipients" class="form-select" id="recipientSelect">
                <option value="">@T["Select recipient..."]</option>
            </select>
            <span asp-validation-for="RecipientUserId" class="text-danger"></span>
        </div>

        <div class="mb-3" id="childSelectWrapper">
            <label asp-for="ChildId" class="form-label">@T["Child"]</label>
            <select asp-for="ChildId" class="form-select" id="childSelect" disabled>
                <option value="">@T["Select recipient first"]</option>
            </select>
            <div class="form-text" id="childSelectHelp">
                @T["Select a recipient first to see available children."]
            </div>
            <span asp-validation-for="ChildId" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label">@T["Message"]</label>
            <textarea asp-for="Content" rows="5" class="form-control" placeholder='@T["Write a message..."]'></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">@T["Send"]</button>
            <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const recipientSelect = document.getElementById('recipientSelect');
        const childSelect = document.getElementById('childSelect');
        const childSelectHelp = document.getElementById('childSelectHelp');

        const labels = @Html.Raw(JsonSerializer.Serialize(labels));

        function resetChildren(message, helpText) {
            childSelect.innerHTML = '';
            childSelect.appendChild(new Option(message, ''));
            childSelect.value = '';
            childSelect.disabled = true;
            childSelectHelp.textContent = helpText;
        }

        async function loadAvailableChildren() {
            const recipientUserId = recipientSelect.value;

            if (!recipientUserId) {
                resetChildren(labels.selectRecipientFirst, labels.helpDefault);
                return;
            }

            resetChildren(labels.selectRecipientFirst, labels.helpDefault);

            const response = await fetch(`/Messages/AvailableChildren?recipientUserId=${encodeURIComponent(recipientUserId)}`);

            if (!response.ok) {
                resetChildren(labels.noChildren, labels.noChildren);
                return;
            }

            const children = await response.json();

            childSelect.innerHTML = '';

            if (!children.length) {
                resetChildren(labels.noChildren, labels.noChildren);
                return;
            }

            childSelect.appendChild(new Option(labels.selectChildOptional, ''));

            for (const child of children) {
                childSelect.appendChild(new Option(child.text, child.value));
            }

            childSelect.disabled = false;
            childSelectHelp.textContent = labels.helpLoaded;
        }

        recipientSelect.addEventListener('change', loadAvailableChildren);
    </script>
}
