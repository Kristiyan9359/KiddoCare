@using System.Security.Claims
@using System.Text.Json
@model KiddoCare.ViewModels.Messages.MessageDetailsViewModel

@{
    ViewData["Title"] = T["Messages"];

    var liveMessageConfig = new
    {
        conversationId = Model.ConversationId,
        currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier)
    };
}

<section class="message-shell">
    <aside class="message-sidebar">
        <div class="message-sidebar-header">
            <div>
                <div class="page-kicker">@T["Messages"]</div>
                <h1>@T["Messages"]</h1>
            </div>
        </div>

        <div class="message-conversation-list">
            @foreach (var conversation in Model.Conversations)
            {
                <a asp-action="Details"
                   asp-route-id="@conversation.Id"
                   class="message-conversation-item @(conversation.Id == Model.ConversationId ? "active" : string.Empty) @(conversation.UnreadMessagesCount > 0 ? "unread" : string.Empty)">
                    <div>
                        <div class="message-conversation-title">
                            @conversation.OtherParticipantName
                        </div>
                        <div class="message-conversation-preview">
                            @T[conversation.LastMessagePreview]
                        </div>
                    </div>

                    <div class="message-conversation-meta">
                        @if (conversation.LastMessageOn.HasValue)
                        {
                            <time datetime="@conversation.LastMessageOn.Value.ToString("O")">
                                @conversation.LastMessageOn.Value.ToString("HH:mm")
                            </time>
                        }

                        @if (conversation.UnreadMessagesCount > 0)
                        {
                            <span class="message-unread-badge">@conversation.UnreadMessagesCount</span>
                        }
                    </div>
                </a>
            }
        </div>
    </aside>

    <section class="message-chat-panel">
        <header class="message-chat-header">
            <div>
                <div class="message-chat-child">@T[Model.ConversationType]</div>
                <h2>@Model.OtherParticipantName</h2>
            </div>

            <div class="message-chat-actions">
                <form asp-action="DeleteConversation"
                      asp-route-id="@Model.ConversationId"
                      method="post">
                    <button type="submit"
                            class="btn btn-outline-danger"
                            data-confirm-message="@T["Delete the conversation?"]">
                        @T["Delete conversation"]
                    </button>
                </form>

                <a asp-action="Index" class="btn btn-secondary">@T["Back"]</a>
            </div>
        </header>

        <div id="messageThread" class="message-thread">
            @if (!Model.Messages.Any())
            {
                <div class="empty-state compact-empty-state">
                    <h3>@T["No messages yet"]</h3>
                    <p>@T["Start the conversation with a short message."]</p>
                </div>
            }
            else
            {
                @foreach (var message in Model.Messages)
                {
                    <article class="message-bubble @(message.IsMine ? "mine" : "theirs")">
                        <div class="message-bubble-author">@message.SenderName</div>
                        <p>@message.Content</p>
                        <time datetime="@message.SentOn.ToString("O")">
                            @message.SentOn.ToString("dd MMM yyyy HH:mm")
                        </time>
                    </article>
                }
            }
        </div>

        <form asp-action="Send" method="post" class="message-compose">
            <input type="hidden" name="ConversationId" value="@Model.ConversationId" />
            <textarea name="Content"
                      rows="2"
                      class="form-control"
                      placeholder='@T["Write a message..."]'></textarea>
            <button type="submit" class="btn btn-primary">@T["Send"]</button>
        </form>
    </section>
</section>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"
            crossorigin="anonymous"
            referrerpolicy="no-referrer"></script>

    <script>
        (() => {
            const messageThread = document.getElementById('messageThread');
            const config = @Html.Raw(JsonSerializer.Serialize(liveMessageConfig));

            if (!messageThread) {
                return;
            }

            const scrollToBottom = () => {
                messageThread.scrollTop = messageThread.scrollHeight;
            };

            const formatMessageTime = (value) => {
                const sentOn = new Date(value);

                return new Intl.DateTimeFormat(document.documentElement.lang || undefined, {
                    day: '2-digit',
                    month: 'short',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit'
                }).format(sentOn);
            };

            const appendMessage = (message) => {
                if (Number(message.conversationId) !== Number(config.conversationId)) {
                    return;
                }

                const emptyState = messageThread.querySelector('.empty-state');

                if (emptyState) {
                    emptyState.remove();
                }

                const article = document.createElement('article');
                article.className = `message-bubble ${message.senderUserId === config.currentUserId ? 'mine' : 'theirs'}`;

                const author = document.createElement('div');
                author.className = 'message-bubble-author';
                author.textContent = message.senderName;

                const content = document.createElement('p');
                content.textContent = message.content;

                const time = document.createElement('time');
                time.dateTime = new Date(message.sentOn).toISOString();
                time.textContent = formatMessageTime(message.sentOn);

                article.append(author, content, time);
                messageThread.appendChild(article);
                scrollToBottom();
            };

            scrollToBottom();

            if (!window.signalR) {
                return;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/messageHub')
                .withAutomaticReconnect()
                .build();

            connection.on('ReceiveMessage', appendMessage);

            connection.start()
                .then(() => connection.invoke('JoinConversation', config.conversationId))
                .catch(() => {});
        })();
    </script>
}
