@model KiddoCare.ViewModels.Messages.MessageDetailsViewModel

@{
    ViewData["Title"] = T["Messages"];
}

<section class="message-shell">
    <aside class="message-sidebar">
        <div class="message-sidebar-header">
            <div>
                <div class="page-kicker">@T["Messages"]</div>
                <h1>@T["Messages"]</h1>
            </div>
        </div>

        <div class="message-conversation-list">
            @foreach (var conversation in Model.Conversations)
            {
                <a asp-action="Details"
                   asp-route-id="@conversation.Id"
                   class="message-conversation-item @(conversation.Id == Model.ConversationId ? "active" : string.Empty)">
                    <div>
                        <div class="message-conversation-title">
                            @conversation.OtherParticipantName
                        </div>
                        <div class="message-conversation-child">
                            @conversation.ChildFullName
                        </div>
                        <div class="message-conversation-preview">
                            @T[conversation.LastMessagePreview]
                        </div>
                    </div>

                    <div class="message-conversation-meta">
                        @if (conversation.LastMessageOn.HasValue)
                        {
                            <time datetime="@conversation.LastMessageOn.Value.ToString("O")">
                                @conversation.LastMessageOn.Value.ToString("HH:mm")
                            </time>
                        }

                        @if (conversation.UnreadMessagesCount > 0)
                        {
                            <span class="message-unread-badge">@conversation.UnreadMessagesCount</span>
                        }
                    </div>
                </a>
            }
        </div>
    </aside>

    <section class="message-chat-panel">
        <header class="message-chat-header">
            <div>
                <div class="message-chat-child">@Model.ChildFullName</div>
                <h2>@Model.OtherParticipantName</h2>
            </div>

            <a asp-action="Index" class="btn btn-secondary">@T["Back"]</a>
        </header>

        <div class="message-thread">
            @if (!Model.Messages.Any())
            {
                <div class="empty-state compact-empty-state">
                    <h3>@T["No messages yet"]</h3>
                    <p>@T["Start the conversation with a short message."]</p>
                </div>
            }
            else
            {
                @foreach (var message in Model.Messages)
                {
                    <article class="message-bubble @(message.IsMine ? "mine" : "theirs")">
                        <div class="message-bubble-author">@message.SenderName</div>
                        <p>@message.Content</p>
                        <time datetime="@message.SentOn.ToString("O")">
                            @message.SentOn.ToString("dd MMM yyyy HH:mm")
                        </time>
                    </article>
                }
            }
        </div>

        <form asp-action="Send" method="post" class="message-compose">
            <input type="hidden" name="ConversationId" value="@Model.ConversationId" />
            <textarea name="Content"
                      rows="2"
                      class="form-control"
                      placeholder='@T["Write a message..."]'></textarea>
            <button type="submit" class="btn btn-primary">@T["Send"]</button>
        </form>
    </section>
</section>