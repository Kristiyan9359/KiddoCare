@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.AbsenceRequests.AbsenceRequestReviewViewModel

@{
    ViewData["Title"] = "Review Absence Request";

    var statusOptions = Html.GetEnumSelectList<RequestStatus>()
        .Where(s => s.Value != "0");
}

<h1>Review Absence Request</h1>

<p>
    <strong>Child:</strong> @Model.ChildFullName
</p>

<p>
    <strong>Period:</strong>
    @Model.StartDate.ToString("dd MMM yyyy")
    -
    @Model.EndDate.ToString("dd MMM yyyy")
</p>

<p>
    <strong>Reason:</strong> @Model.Reason
</p>

<p style="white-space: pre-line">
    <strong>Parent Note:</strong>
    @(Model.ParentNote ?? "No note provided.")
</p>

<form asp-action="Review" method="post">
    <input asp-for="Id" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status"
                asp-items="statusOptions"
                class="form-select">
            <option value="0">Select status</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReviewNote" class="form-label"></label>
        <textarea asp-for="ReviewNote" class="form-control" rows="4"></textarea>
        <span asp-validation-for="ReviewNote" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Review</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}