@model KiddoCare.ViewModels.AbsenceRequests.AbsenceRequestReviewViewModel

@{
    ViewData["Title"] = T["Confirm Absence Notice"];
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Attendance"]</div>
        <h1 class="page-title">@T["Confirm Absence Notice"]</h1>
        <p class="page-subtitle">
            @T["Confirm that the kindergarten has reviewed this absence notice."]
        </p>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Notice Summary"]</h2>
                <p>@T["Review the details before saving confirmation."]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Child"]</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>@T["Period"]</dt>
                <dd>
                    @Model.StartDate.ToString("dd MMM yyyy")
                    -
                    @Model.EndDate.ToString("dd MMM yyyy")
                </dd>
            </div>
            <div>
                <dt>@T["Reason"]</dt>
                <dd>@T[Model.Reason.ToString()]</dd>
            </div>
            <div>
                <dt>@T["Note"]</dt>
                <dd style="white-space: pre-line">
                    @(Model.ParentNote ?? T["No note provided."].Value)
                </dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Confirmation"]</h2>
                <p>@T["Add an optional staff note."]</p>
            </div>
        </div>

        <form asp-action="Review" method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="ReviewNote" class="form-label"></label>
                <textarea asp-for="ReviewNote"
                          class="form-control"
                          rows="5"
                          placeholder='@T["Optional confirmation note."]'></textarea>
                <span asp-validation-for="ReviewNote" class="text-danger"></span>
            </div>

            <div class="form-action-row">
                <button type="submit" class="btn btn-primary">@T["Save Confirmation"]</button>
                <a href="@backUrl" class="btn btn-secondary">@T["Cancel"]</a>
            </div>
        </form>
    </section>
</div>
