@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.AbsenceRequests.AbsenceRequestDetailsViewModel

@{
    ViewData["Title"] = "Absence Notice Details";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">Attendance</div>
        <h1 class="page-title">Absence Notice</h1>
        <p class="page-subtitle">
            Review the child, absence period and confirmation details.
        </p>
    </div>

    <div class="page-actions">
        @if (Model.CanReview)
        {
            <a asp-action="Review"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-primary">
                Confirm
            </a>
        }

        <a href="@backUrl" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Notice Summary</h2>
                <p>@Model.ChildFullName from @Model.GroupName.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Child</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>Group</dt>
                <dd>@Model.GroupName</dd>
            </div>
            <div>
                <dt>Period</dt>
                <dd>
                    @Model.StartDate.ToString("dd MMM yyyy")
                    -
                    @Model.EndDate.ToString("dd MMM yyyy")
                </dd>
            </div>
            <div>
                <dt>Reason</dt>
                <dd>@Model.Reason</dd>
            </div>
            <div>
                <dt>Status</dt>
                <dd>
                    @if (Model.Status == RequestStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (Model.Status == RequestStatus.Approved)
                    {
                        <span class="badge bg-success">Confirmed</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@Model.Status</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Submission</h2>
                <p>Who submitted the notice and when.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Submitted By</dt>
                <dd>@Model.RequestedByEmail</dd>
            </div>
            <div>
                <dt>Submitted On</dt>
                <dd>@Model.RequestedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            </div>
            <div>
                <dt>Confirmed On</dt>
                <dd>
                    @(Model.ReviewedOn.HasValue
                        ? Model.ReviewedOn.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        : "Not confirmed yet")
                </dd>
            </div>
        </dl>
    </section>
</div>

<div class="detail-grid mt-3">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Note</h2>
                <p>Additional information from the submitter.</p>
            </div>
        </div>

        <p class="mb-0" style="white-space: pre-line">
            @(Model.ParentNote ?? "No note provided.")
        </p>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Confirmation Note</h2>
                <p>Internal confirmation note from staff.</p>
            </div>
        </div>

        <p class="mb-0" style="white-space: pre-line">
            @(Model.ReviewNote ?? "No confirmation note.")
        </p>
    </section>
</div>