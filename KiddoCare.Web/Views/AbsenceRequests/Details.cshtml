@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.AbsenceRequests.AbsenceRequestDetailsViewModel

@{
    ViewData["Title"] = "Absence Request Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Absence Request</h1>

    @if (Model.CanReview)
    {
        <a asp-action="Review"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            Review
        </a>
    }
</div>

<dl class="row">
    <dt class="col-sm-3">Child</dt>
    <dd class="col-sm-9">@Model.ChildFullName</dd>

    <dt class="col-sm-3">Group</dt>
    <dd class="col-sm-9">@Model.GroupName</dd>

    <dt class="col-sm-3">Period</dt>
    <dd class="col-sm-9">
        @Model.StartDate.ToString("dd MMM yyyy")
        -
        @Model.EndDate.ToString("dd MMM yyyy")
    </dd>

    <dt class="col-sm-3">Reason</dt>
    <dd class="col-sm-9">@Model.Reason</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.Status == RequestStatus.Pending)
        {
            <span class="badge bg-warning text-dark">Pending</span>
        }
        else if (Model.Status == RequestStatus.Approved)
        {
            <span class="badge bg-success">Approved</span>
        }
        else if (Model.Status == RequestStatus.Rejected)
        {
            <span class="badge bg-danger">Rejected</span>
        }
    </dd>

    <dt class="col-sm-3">Parent Note</dt>
    <dd class="col-sm-9" style="white-space: pre-line">
        @(Model.ParentNote ?? "No note provided.")
    </dd>

    <dt class="col-sm-3">Requested By</dt>
    <dd class="col-sm-9">@Model.RequestedByEmail</dd>

    <dt class="col-sm-3">Requested On</dt>
    <dd class="col-sm-9">@Model.RequestedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>

    <dt class="col-sm-3">Review Note</dt>
    <dd class="col-sm-9" style="white-space: pre-line">
        @(Model.ReviewNote ?? "No review note.")
    </dd>

    <dt class="col-sm-3">Reviewed On</dt>
    <dd class="col-sm-9">
        @(Model.ReviewedOn.HasValue
            ? Model.ReviewedOn.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
            : "Not reviewed yet.")
    </dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back</a>