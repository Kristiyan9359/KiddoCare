@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.AbsenceRequests.AbsenceRequestDetailsViewModel

@{
    ViewData["Title"] = T["Absence Notice Details"];
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Attendance"]</div>
        <h1 class="page-title">@T["Absence Notice"]</h1>
        <p class="page-subtitle">
            @T["Review the child, absence period and confirmation details."]
        </p>
    </div>

    <div class="page-actions">
        @if (Model.CanReview)
        {
            <a asp-action="Review"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-primary">
                @T["Confirm"]
            </a>
        }

        <a href="@backUrl" class="btn btn-secondary">@T["Back"]</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Notice Summary"]</h2>
                <p>@T["{0} from {1}.", Model.ChildFullName, Model.GroupName]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Child"]</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>@T["Group"]</dt>
                <dd>@Model.GroupName</dd>
            </div>
            <div>
                <dt>@T["Period"]</dt>
                <dd>
                    @Model.StartDate.ToString("dd MMM yyyy")
                    -
                    @Model.EndDate.ToString("dd MMM yyyy")
                </dd>
            </div>
            <div>
                <dt>@T["Reason"]</dt>
                <dd>@T[Model.Reason.ToString()]</dd>
            </div>
            <div>
                <dt>@T["Status"]</dt>
                <dd>
                    @if (Model.Status == RequestStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">@T["Pending"]</span>
                    }
                    else if (Model.Status == RequestStatus.Approved)
                    {
                        <span class="badge bg-success">@T["Confirmed"]</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">@T[Model.Status.ToString()]</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Submission"]</h2>
                <p>@T["Who submitted the notice and when."]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Submitted By"]</dt>
                <dd>@Model.RequestedByEmail</dd>
            </div>
            <div>
                <dt>@T["Submitted On"]</dt>
                <dd>@Model.RequestedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            </div>
            <div>
                <dt>@T["Confirmed On"]</dt>
                <dd>
                    @(Model.ReviewedOn.HasValue
                        ? Model.ReviewedOn.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        : T["Not confirmed yet"].Value)
                </dd>
            </div>
        </dl>
    </section>
</div>

<div class="detail-grid mt-3">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Note"]</h2>
                <p>@T["Additional information from the submitter."]</p>
            </div>
        </div>

        <p class="mb-0" style="white-space: pre-line">
            @(Model.ParentNote ?? T["No note provided."].Value)
        </p>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Confirmation Note"]</h2>
                <p>@T["Internal confirmation note from staff."]</p>
            </div>
        </div>

        <p class="mb-0" style="white-space: pre-line">
            @(Model.ReviewNote ?? T["No confirmation note."].Value)
        </p>
    </section>
</div>
