@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.AbsenceRequests.AbsenceRequestCreateViewModel

@{
    ViewData["Title"] = "Create Absence Request";
}

<h1>Create Absence Request</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="ChildId" class="form-label"></label>
        <select asp-for="ChildId" asp-items="Model.Children" class="form-select">
            <option value="">Select child</option>
        </select>
        <span asp-validation-for="ChildId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="StartDate" class="form-label"></label>
        <input asp-for="StartDate"
               type="date"
               min="@DateTime.Today.ToString("yyyy-MM-dd")"
               class="form-control" />
        <span asp-validation-for="StartDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate"
               type="date"
               min="@DateTime.Today.ToString("yyyy-MM-dd")"
               class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Reason" class="form-label"></label>
        <select asp-for="Reason"
                asp-items="Html.GetEnumSelectList<AbsenceReason>()"
                class="form-select">
        </select>
        <span asp-validation-for="Reason" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ParentNote" class="form-label"></label>
        <textarea asp-for="ParentNote" class="form-control" rows="4"></textarea>
        <span asp-validation-for="ParentNote" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Create</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}