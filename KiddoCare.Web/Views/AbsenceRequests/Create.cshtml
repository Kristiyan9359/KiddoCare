@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.AbsenceRequests.AbsenceRequestCreateViewModel

@{
    ViewData["Title"] = T["Create Absence Notice"];
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Attendance"]</div>
        <h1 class="page-title">@T["Create Absence Notice"]</h1>
        <p class="page-subtitle">
            @T["Register when a child will be away and why."]
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Create" method="post">
        <input asp-for="ReturnUrl" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="ChildId" class="form-label">@T["Child"]</label>
                <select asp-for="ChildId" asp-items="Model.Children" class="form-select">
                    <option value="">@T["Select child..."]</option>
                </select>
                <span asp-validation-for="ChildId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Reason" class="form-label">@T["Reason"]</label>
                <select asp-for="Reason"
                        asp-items="Html.GetLocalizedEnumSelectList<AbsenceReason>(T)"
                        class="form-select">
                </select>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StartDate" class="form-label">@T["Start Date"]</label>
                <input asp-for="StartDate"
                       type="date"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       class="form-control" />
                <span asp-validation-for="StartDate" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="EndDate" class="form-label">@T["End Date"]</label>
                <input asp-for="EndDate"
                       type="date"
                       min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       class="form-control" />
                <span asp-validation-for="EndDate" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="ParentNote" class="form-label">@T["Parent Note"]</label>
            <textarea asp-for="ParentNote"
                      class="form-control"
                      rows="4"
                      placeholder='@T["Optional note for the kindergarten staff."]'></textarea>
            <span asp-validation-for="ParentNote" class="text-danger"></span>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">@T["Create Notice"]</button>
            <a href="@backUrl" class="btn btn-secondary">@T["Cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
