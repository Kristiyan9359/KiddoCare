@model IEnumerable<KiddoCare.ViewModels.AbsenceRequests.AbsenceRequestIndexViewModel>

@{
    ViewData["Title"] = "Absence Requests";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Absence Requests</h1>

    <a asp-action="Create" class="btn btn-primary">
        Create Absence Request
    </a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info">
        No absence requests found.
    </div>
}
else
{
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Child</th>
                <th>Group</th>
                <th>Period</th>
                <th>Reason</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model)
            {
                <tr>
                    <td>@request.ChildFullName</td>
                    <td>@request.GroupName</td>
                    <td>
                        @request.StartDate.ToString("dd MMM yyyy")
                        -
                        @request.EndDate.ToString("dd MMM yyyy")
                    </td>
                    <td>@request.Reason</td>
                    <td>@request.Status</td>
                    <td class="text-end">
                        <a asp-action="Details"
                           asp-route-id="@request.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>

                        @if (request.CanReview)
                        {
                            <a asp-action="Review"
                               asp-route-id="@request.Id"
                               class="btn btn-sm btn-outline-primary">
                                Review
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}