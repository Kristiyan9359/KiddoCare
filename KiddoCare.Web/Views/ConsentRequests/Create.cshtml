@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ConsentRequests.ConsentRequestCreateViewModel

@{
    ViewData["Title"] = T["Create Consent Request"];
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Parent permissions"]</div>
        <h1 class="page-title">@T["Create Consent Request"]</h1>
        <p class="page-subtitle">
            @T["Ask a parent to approve or decline a specific permission for their child."]
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="ChildId" class="form-label">@T["Child"]</label>
                <select asp-for="ChildId" asp-items="Model.Children" class="form-select">
                    <option value="">@T["Select child..."]</option>
                </select>
                <span asp-validation-for="ChildId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label">@T["Type"]</label>
                <select asp-for="Type"
                        asp-items="Html.GetLocalizedEnumSelectList<ConsentRequestType>(T)"
                        class="form-select">
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">@T["Title"]</label>
                <input asp-for="Title"
                       class="form-control"
                       placeholder='@T["Example: Photo permission"]' />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Description" class="form-label">@T["Description"]</label>
            <textarea asp-for="Description"
                      class="form-control"
                      rows="5"
                      placeholder='@T["Explain clearly what the parent is approving or declining."]'></textarea>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">@T["Create Request"]</button>
            <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
