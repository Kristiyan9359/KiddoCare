@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ConsentRequests.ConsentRequestRespondViewModel

@{
    ViewData["Title"] = "Respond Consent Request";
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");

    var statusOptions = Html.GetEnumSelectList<RequestStatus>()
        .Where(s => s.Value != "0");
}

<h1>Respond Consent Request</h1>

<p>
    <strong>Child:</strong> @Model.ChildFullName
</p>

<p>
    <strong>Title:</strong> @Model.Title
</p>

<p>
    <strong>Type:</strong> @Model.Type
</p>

<p style="white-space: pre-line">
    <strong>Description:</strong>
    @(Model.Description ?? "No description provided.")
</p>

<form asp-action="Respond" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="ReturnUrl" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status"
                asp-items="statusOptions"
                class="form-select">
            <option value="0">Select response</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ParentNote" class="form-label"></label>
        <textarea asp-for="ParentNote" class="form-control" rows="4"></textarea>
        <span asp-validation-for="ParentNote" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Response</button>
    <a href="@backUrl" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
