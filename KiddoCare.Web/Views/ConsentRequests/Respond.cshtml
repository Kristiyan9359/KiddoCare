@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ConsentRequests.ConsentRequestRespondViewModel

@{
    ViewData["Title"] = T["Respond Consent Request"];
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Parent permissions"]</div>
        <h1 class="page-title">@T["Respond Consent Request"]</h1>
        <p class="page-subtitle">
            @T["Choose whether you give permission for this request."]
        </p>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Request Summary"]</h2>
                <p>@T["Read the details before submitting your response."]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Child"]</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>@T["Title"]</dt>
                <dd>@Model.Title</dd>
            </div>
            <div>
                <dt>@T["Type"]</dt>
                <dd>@T[Model.Type.ToString()]</dd>
            </div>
        </dl>

        <div class="mt-3">
            <h3 class="h5">@T["Description"]</h3>
            <p class="announcement-message">
                @(Model.Description ?? T["No description provided."].Value)
            </p>
        </div>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Your Response"]</h2>
                <p>@T["Approve or decline this consent request."]</p>
            </div>
        </div>

        <form asp-action="Respond" method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label">@T["Status"]</label>
                <select asp-for="Status" class="form-select">
                    <option value="0">@T["Select response..."]</option>
                    <option value="@((int)RequestStatus.Approved)">@T["Give consent"]</option>
                    <option value="@((int)RequestStatus.Rejected)">@T["Decline"]</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParentNote" class="form-label">@T["Parent Note"]</label>
                <textarea asp-for="ParentNote"
                          class="form-control"
                          rows="5"
                          placeholder='@T["Optional note for the kindergarten staff."]'></textarea>
                <span asp-validation-for="ParentNote" class="text-danger"></span>
            </div>

            <div class="form-action-row">
                <button type="submit" class="btn btn-primary">@T["Save Response"]</button>
                <a href="@backUrl" class="btn btn-secondary">@T["Cancel"]</a>
            </div>
        </form>
    </section>
</div>
