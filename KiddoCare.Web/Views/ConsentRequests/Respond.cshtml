@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ConsentRequests.ConsentRequestRespondViewModel

@{
    ViewData["Title"] = "Respond Consent Request";
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">Parent permissions</div>
        <h1 class="page-title">Respond Consent Request</h1>
        <p class="page-subtitle">
            Choose whether you give permission for this request.
        </p>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Request Summary</h2>
                <p>Read the details before submitting your response.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Child</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>Title</dt>
                <dd>@Model.Title</dd>
            </div>
            <div>
                <dt>Type</dt>
                <dd>@Model.Type</dd>
            </div>
        </dl>

        <div class="mt-3">
            <h3 class="h5">Description</h3>
            <p class="announcement-message">
                @(Model.Description ?? "No description provided.")
            </p>
        </div>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Your Response</h2>
                <p>Approve or decline this consent request.</p>
            </div>
        </div>

        <form asp-action="Respond" method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="0">Select response...</option>
                    <option value="@((int)RequestStatus.Approved)">Give consent</option>
                    <option value="@((int)RequestStatus.Rejected)">Decline</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParentNote" class="form-label"></label>
                <textarea asp-for="ParentNote"
                          class="form-control"
                          rows="5"
                          placeholder="Optional note for the kindergarten staff."></textarea>
                <span asp-validation-for="ParentNote" class="text-danger"></span>
            </div>

            <div class="form-action-row">
                <button type="submit" class="btn btn-primary">Save Response</button>
                <a href="@backUrl" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </section>
</div>