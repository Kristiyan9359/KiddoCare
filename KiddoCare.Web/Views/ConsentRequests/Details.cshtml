@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ConsentRequests.ConsentRequestDetailsViewModel

@{
    ViewData["Title"] = "Consent Request Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Consent Request</h1>

    @if (Model.CanRespond)
    {
        <a asp-action="Respond"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            Respond
        </a>
    }
</div>

<dl class="row">
    <dt class="col-sm-3">Child</dt>
    <dd class="col-sm-9">@Model.ChildFullName</dd>

    <dt class="col-sm-3">Group</dt>
    <dd class="col-sm-9">@Model.GroupName</dd>

    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">Type</dt>
    <dd class="col-sm-9">@Model.Type</dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.Status == RequestStatus.Pending)
        {
            <span class="badge bg-warning text-dark">Pending</span>
        }
        else if (Model.Status == RequestStatus.Approved)
        {
            <span class="badge bg-success">Approved</span>
        }
        else if (Model.Status == RequestStatus.Rejected)
        {
            <span class="badge bg-danger">Rejected</span>
        }
    </dd>

    <dt class="col-sm-3">Description</dt>
    <dd class="col-sm-9" style="white-space: pre-line">
        @(Model.Description ?? "No description provided.")
    </dd>

    <dt class="col-sm-3">Created By</dt>
    <dd class="col-sm-9">@Model.CreatedByEmail</dd>

    <dt class="col-sm-3">Created On</dt>
    <dd class="col-sm-9">@Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>

    <dt class="col-sm-3">Parent Note</dt>
    <dd class="col-sm-9" style="white-space: pre-line">
        @(Model.ParentNote ?? "No parent note.")
    </dd>

    <dt class="col-sm-3">Responded On</dt>
    <dd class="col-sm-9">
        @(Model.RespondedOn.HasValue
            ? Model.RespondedOn.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
            : "Not responded yet.")
    </dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back</a>