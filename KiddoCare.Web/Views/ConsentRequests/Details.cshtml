@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ConsentRequests.ConsentRequestDetailsViewModel

@{
    ViewData["Title"] = "Consent Request Details";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">Parent permissions</div>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-subtitle">
            Review consent details and parent response.
        </p>
    </div>

    <div class="page-actions">
        @if (Model.CanRespond)
        {
            <a asp-action="Respond"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-primary">
                Respond
            </a>
        }

        <a href="@backUrl" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Request Summary</h2>
                <p>@Model.Type consent for @Model.ChildFullName.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Child</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>Group</dt>
                <dd>@Model.GroupName</dd>
            </div>
            <div>
                <dt>Type</dt>
                <dd>@Model.Type</dd>
            </div>
            <div>
                <dt>Status</dt>
                <dd>
                    @if (Model.Status == RequestStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (Model.Status == RequestStatus.Approved)
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else if (Model.Status == RequestStatus.Rejected)
                    {
                        <span class="badge bg-danger">Declined</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Audit</h2>
                <p>Creation and response information.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Created By</dt>
                <dd>@Model.CreatedByEmail</dd>
            </div>
            <div>
                <dt>Created On</dt>
                <dd>@Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            </div>
            <div>
                <dt>Responded On</dt>
                <dd>
                    @(Model.RespondedOn.HasValue
                        ? Model.RespondedOn.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        : "Not responded yet")
                </dd>
            </div>
        </dl>
    </section>
</div>

<div class="detail-grid mt-3">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Description</h2>
                <p>What the parent is being asked to approve.</p>
            </div>
        </div>

        <p class="announcement-message">
            @(Model.Description ?? "No description provided.")
        </p>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Parent Note</h2>
                <p>Optional note submitted with the response.</p>
            </div>
        </div>

        <p class="mb-0" style="white-space: pre-line">
            @(Model.ParentNote ?? "No parent note.")
        </p>
    </section>
</div>