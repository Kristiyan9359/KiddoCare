@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ConsentRequests.ConsentRequestDetailsViewModel

@{
    ViewData["Title"] = T["Consent Request Details"];
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Parent permissions"]</div>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-subtitle">
            @T["Review consent details and parent response."]
        </p>
    </div>

    <div class="page-actions">
        @if (Model.CanRespond)
        {
            <a asp-action="Respond"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-primary">
                @T["Respond"]
            </a>
        }

        <a href="@backUrl" class="btn btn-secondary">@T["Back"]</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Request Summary"]</h2>
                <p>@T["{0} consent for {1}.", T[Model.Type.ToString()], Model.ChildFullName]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Child"]</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>@T["Group"]</dt>
                <dd>@Model.GroupName</dd>
            </div>
            <div>
                <dt>@T["Type"]</dt>
                <dd>@T[Model.Type.ToString()]</dd>
            </div>
            <div>
                <dt>@T["Status"]</dt>
                <dd>
                    @if (Model.Status == RequestStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">@T["Pending"]</span>
                    }
                    else if (Model.Status == RequestStatus.Approved)
                    {
                        <span class="badge bg-success">@T["Approved"]</span>
                    }
                    else if (Model.Status == RequestStatus.Rejected)
                    {
                        <span class="badge bg-danger">@T["Declined"]</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Audit"]</h2>
                <p>@T["Creation and response information."]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Created By"]</dt>
                <dd>@Model.CreatedByEmail</dd>
            </div>
            <div>
                <dt>@T["Created On"]</dt>
                <dd>@Model.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            </div>
            <div>
                <dt>@T["Responded On"]</dt>
                <dd>
                    @(Model.RespondedOn.HasValue
                        ? Model.RespondedOn.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        : T["Not responded yet"].Value)
                </dd>
            </div>
        </dl>
    </section>
</div>

<div class="detail-grid mt-3">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Description"]</h2>
                <p>@T["What the parent is being asked to approve."]</p>
            </div>
        </div>

        <p class="announcement-message">
            @(Model.Description ?? T["No description provided."].Value)
        </p>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Parent Note"]</h2>
                <p>@T["Optional note submitted with the response."]</p>
            </div>
        </div>

        <p class="mb-0" style="white-space: pre-line">
            @(Model.ParentNote ?? T["No parent note."].Value)
        </p>
    </section>
</div>
