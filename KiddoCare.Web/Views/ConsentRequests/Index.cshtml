@using KiddoCare.Data.Models.Enums
@using static KiddoCare.Common.RoleConstants
@model KiddoCare.ViewModels.ConsentRequests.ConsentRequestListViewModel

@{
    ViewData["Title"] = T["Consent Requests"];
    bool canCreate = User.IsInRole(Admin) || User.IsInRole(Teacher);
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="list-page-header">
    <div>
        <div class="page-kicker">@T["Parent permissions"]</div>
        <h1 class="page-title">@T["Consent Requests"]</h1>
        <p class="page-subtitle">
            @T["Manage parent permissions for photos, trips, activities and special care situations."]
        </p>
    </div>

    <div class="page-actions">
        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
        {
            <a href="@Model.ReturnUrl" class="btn btn-secondary">@T["Back"]</a>
        }

        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">@T["Create Consent Request"]</a>
        }
    </div>
</div>

<section id="consent-requests-list" class="section-panel">
    <div class="section-panel-header">
        <div>
            <h2 class="section-panel-title">@T["Consent Records"]</h2>
            <p class="section-panel-subtitle">
                @T["{0} consent requests found.", Model.TotalConsentRequests]
            </p>
        </div>

        <div class="records-toolbar">
            <div class="records-page-size">
                <label for="consentPageSizeSelect" class="form-label mb-0">@T["Show"]</label>
                <select id="consentPageSizeSelect" class="form-select form-select-sm">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="15" selected="@(Model.PageSize == 15)">15</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                </select>
            </div>

            @if (Model.TotalPages > 0)
            {
                <div class="text-muted">
                    @T["Page {0} of {1}", Model.Page, Model.TotalPages]
                </div>
            }
        </div>
    </div>

    <form id="consentFilterForm" asp-action="Index" method="get" class="filter-form mb-3">
        <input type="hidden" name="page" value="1" />
        <input asp-for="PageSize" type="hidden" id="consentPageSizeHidden" />
        <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

        <div class="filter-bar mb-3">
            <div>
                <strong>@T["Filter requests"]</strong>
                <span>@T["Review pending, approved or declined parent responses."]</span>
            </div>

            <div class="action-buttons">
                <a asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-pageSize="@Model.PageSize"
                   class="btn btn-sm @(Model.StatusFilter == null ? "btn-primary" : "btn-outline-primary")">
                    @T["All"]
                </a>

                <a asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-statusFilter="pending"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-pageSize="@Model.PageSize"
                   class="btn btn-sm @(Model.StatusFilter == "pending" ? "btn-primary" : "btn-outline-primary")">
                    @T["Pending"]
                </a>

                <a asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-statusFilter="approved"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-pageSize="@Model.PageSize"
                   class="btn btn-sm @(Model.StatusFilter == "approved" ? "btn-primary" : "btn-outline-primary")">
                    @T["Approved"]
                </a>

                <a asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-statusFilter="rejected"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-pageSize="@Model.PageSize"
                   class="btn btn-sm @(Model.StatusFilter == "rejected" ? "btn-primary" : "btn-outline-primary")">
                    @T["Declined"]
                </a>
            </div>
        </div>

        <div class="form-grid align-items-end">
            <div class="mb-3 search-suggest-wrapper">
                <label asp-for="SearchTerm" class="form-label">@T["Search"]</label>
                <input asp-for="SearchTerm"
                       id="consentSearchInput"
                       class="form-control"
                       autocomplete="off"
                       placeholder='@T["Search by child, title, group or type..."]' />

                <div id="consentSearchSuggestions"
                     class="search-suggestions"
                     hidden>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">@T["Search"]</button>
                <a asp-action="Index"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="btn btn-secondary">
                    @T["Clear"]
                </a>
            </div>
        </div>
    </form>

    @if (!Model.ConsentRequests.Any())
    {
        <section class="empty-state compact-empty-state">
            <h2>@T["No consent requests found"]</h2>
            <p>@T["Try changing the search or status filter, or create a request when parent permission is needed."]</p>

            @if (canCreate)
            {
                <a asp-action="Create" class="btn btn-primary">@T["Create Consent Request"]</a>
            }
        </section>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0 mobile-card-table">
                <thead>
                    <tr>
                        <th>@T["Child"]</th>
                        <th>@T["Group"]</th>
                        <th>@T["Title"]</th>
                        <th>@T["Type"]</th>
                        <th>@T["Status"]</th>
                        <th>@T["Created On"]</th>
                        <th class="text-end">@T["Actions"]</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var request in Model.ConsentRequests)
                    {
                        <tr>
                            <td data-label='@T["Child"]'><div class="fw-bold">@request.ChildFullName</div></td>
                            <td data-label='@T["Group"]'>@request.GroupName</td>
                            <td data-label='@T["Title"]'>@request.Title</td>
                            <td data-label='@T["Type"]'>@T[request.Type.ToString()]</td>
                            <td data-label='@T["Status"]'>
                                @if (request.Status == RequestStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">@T["Pending"]</span>
                                }
                                else if (request.Status == RequestStatus.Approved)
                                {
                                    <span class="badge bg-success">@T["Approved"]</span>
                                }
                                else if (request.Status == RequestStatus.Rejected)
                                {
                                    <span class="badge bg-danger">@T["Declined"]</span>
                                }
                            </td>
                            <td data-label='@T["Created On"]'>@request.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                            <td class="text-end" data-label='@T["Actions"]'>
                                <div class="action-buttons">
                                    <a asp-action="Details"
                                       asp-route-id="@request.Id"
                                       asp-route-returnUrl="@currentUrl"
                                       class="btn btn-sm btn-outline-secondary">
                                        @T["Details"]
                                    </a>

                                    @if (request.CanRespond)
                                    {
                                        <a asp-action="Respond"
                                           asp-route-id="@request.Id"
                                           asp-route-returnUrl="@currentUrl"
                                           class="btn btn-sm btn-outline-primary">
                                            @T["Respond"]
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="attendance-pager" aria-label='@T["Consent request pages"]'>
                <a class="attendance-page-link @(Model.HasPreviousPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="consent-requests-list">
                    @T["Previous"]
                </a>

                <div class="attendance-page-numbers">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <a class="attendance-page-number @(pageNumber == Model.Page ? "active" : string.Empty)"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-statusFilter="@Model.StatusFilter"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           asp-route-page="@pageNumber"
                           asp-route-pageSize="@Model.PageSize"
                           asp-fragment="consent-requests-list">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="attendance-page-link @(Model.HasNextPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-statusFilter="@Model.StatusFilter"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="consent-requests-list">
                    @T["Next"]
                </a>
            </nav>
        }
    }
</section>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('consentFilterForm');
            const searchInput = document.getElementById('consentSearchInput');
            const pageSizeSelect = document.getElementById('consentPageSizeSelect');
            const pageSizeHidden = document.getElementById('consentPageSizeHidden');
            const suggestionsBox = document.getElementById('consentSearchSuggestions');

            if (!form || !searchInput || !pageSizeSelect || !pageSizeHidden || !suggestionsBox) {
                return;
            }

            let suggestionsTimeout;
            let activeSuggestionIndex = -1;

            const hideSuggestions = () => {
                suggestionsBox.hidden = true;
                suggestionsBox.innerHTML = '';
                activeSuggestionIndex = -1;
            };

            const getSuggestionButtons = () => {
                return Array.from(suggestionsBox.querySelectorAll('button'));
            };

            const setActiveSuggestion = (index) => {
                const buttons = getSuggestionButtons();

                buttons.forEach(button => button.classList.remove('active'));

                if (index >= 0 && index < buttons.length) {
                    buttons[index].classList.add('active');
                    buttons[index].scrollIntoView({ block: 'nearest' });
                }

                activeSuggestionIndex = index;
            };

            const renderSuggestions = (items) => {
                suggestionsBox.innerHTML = '';

                if (!items.length) {
                    hideSuggestions();
                    return;
                }

                items.forEach(item => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'search-suggestion-item';
                    button.textContent = item;

                    button.addEventListener('click', () => {
                        searchInput.value = item;
                        hideSuggestions();
                        form.submit();
                    });

                    suggestionsBox.appendChild(button);
                });

                suggestionsBox.hidden = false;
                activeSuggestionIndex = -1;
            };

            searchInput.addEventListener('input', () => {
                clearTimeout(suggestionsTimeout);

                const term = searchInput.value.trim();

                if (term.length < 2) {
                    hideSuggestions();
                    return;
                }

                suggestionsTimeout = setTimeout(async () => {
                    const response = await fetch(`/ConsentRequests/Suggestions?term=${encodeURIComponent(term)}`);

                    if (!response.ok) {
                        hideSuggestions();
                        return;
                    }

                    const items = await response.json();
                    renderSuggestions(items);
                }, 250);
            });

            searchInput.addEventListener('keydown', (event) => {
                const buttons = getSuggestionButtons();

                if (event.key === 'Escape') {
                    hideSuggestions();
                    return;
                }

                if (suggestionsBox.hidden || !buttons.length) {
                    return;
                }

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    setActiveSuggestion((activeSuggestionIndex + 1) % buttons.length);
                }

                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    setActiveSuggestion(activeSuggestionIndex <= 0 ? buttons.length - 1 : activeSuggestionIndex - 1);
                }

                if (event.key === 'Enter' && activeSuggestionIndex >= 0) {
                    event.preventDefault();
                    buttons[activeSuggestionIndex].click();
                }
            });

            pageSizeSelect.addEventListener('change', () => {
                pageSizeHidden.value = pageSizeSelect.value;
                form.submit();
            });

            document.addEventListener('click', (event) => {
                if (!suggestionsBox.contains(event.target) && event.target !== searchInput) {
                    hideSuggestions();
                }
            });
        })();
    </script>
}
