@model KiddoCare.ViewModels.Announcements.AnnouncementDetailsViewModel

@{
    ViewData["Title"] = T["Announcement Details"];
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Updates"]</div>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-subtitle">
            @T["Announcement details, audience and message content."]
        </p>
    </div>

    <div class="page-actions">
        <a href="@backUrl" class="btn btn-secondary">@T["Back"]</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Announcement Summary"]</h2>
                <p>@T["Where and when this update is visible."]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Title"]</dt>
                <dd>@Model.Title</dd>
            </div>
            <div>
                <dt>@T["Group"]</dt>
                <dd>@Model.GroupName</dd>
            </div>
            <div>
                <dt>@T["Published"]</dt>
                <dd>@Model.PublishedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            </div>
            <div>
                <dt>@T["Visibility"]</dt>
                <dd>@(Model.IsPublic ? T["Visible to parents"].Value : T["Staff only"].Value)</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Message"]</h2>
            </div>
        </div>

        <p class="announcement-message">@Model.Content</p>
    </section>
</div>
