@model KiddoCare.ViewModels.Announcements.AnnouncementEditViewModel

@{
    ViewData["Title"] = "Edit Announcement";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Updates</div>
        <h1 class="page-title">Edit Announcement</h1>
        <p class="page-subtitle">
            Update the message, audience or visibility.
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Edit" method="post">
        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="Title" class="form-label"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GroupId" class="form-label"></label>
                <select asp-for="GroupId" asp-items="Model.Groups" class="form-select">
                    <option value="">All groups</option>
                </select>
                <span asp-validation-for="GroupId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label"></label>
            <textarea asp-for="Content" class="form-control" rows="7"></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsPublic" class="form-check-input" />
            <label asp-for="IsPublic" class="form-check-label"></label>
            <div class="form-text">
                When enabled, parents can see this announcement in their dashboard.
            </div>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">Save</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}