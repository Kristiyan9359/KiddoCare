@using static KiddoCare.Common.RoleConstants
@model IEnumerable<KiddoCare.ViewModels.Announcements.AnnouncementIndexViewModel>

@{
    ViewData["Title"] = "Announcements";
    bool canCreate = User.IsInRole(Admin) || User.IsInRole(Teacher);
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="list-page-header">
    <div>
        <div class="page-kicker">Updates</div>
        <h1 class="page-title">Announcements</h1>
        <p class="page-subtitle">
            Important kindergarten updates, group messages and staff notices.
        </p>
    </div>

    @if (canCreate)
    {
        <a asp-action="Create" class="btn btn-primary">Create Announcement</a>
    }
</div>

@if (!Model.Any())
{
    <section class="empty-state">
        <div class="empty-state-icon">+</div>
        <h2>No announcements yet</h2>
        <p>Create the first update to keep families and staff informed.</p>

        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">Create Announcement</a>
        }
    </section>
}
else
{
    <div class="content-list">
        @foreach (var announcement in Model)
        {
            <article class="content-list-item">
                <div>
                    <div class="item-meta mb-2">
                        <span>@announcement.GroupName</span>
                        <span>@announcement.PublishedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                    </div>

                    <h2 class="item-title">@announcement.Title</h2>
                    <p class="item-preview">@announcement.ContentPreview</p>
                </div>

                <div class="item-actions">
                    <a asp-action="Details"
                       asp-route-id="@announcement.Id"
                       asp-route-returnUrl="@currentUrl"
                       class="btn btn-sm btn-outline-secondary">
                        Details
                    </a>

                    @if (announcement.CanManage)
                    {
                        <a asp-action="Edit"
                           asp-route-id="@announcement.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@announcement.Id"
                              method="post">
                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    data-confirm-message="Are you sure you want to delete this announcement?">
                                Delete
                            </button>
                        </form>
                    }
                </div>
            </article>
        }
    </div>
}