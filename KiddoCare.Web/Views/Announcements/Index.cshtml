@using static KiddoCare.Common.RoleConstants
@model KiddoCare.ViewModels.Announcements.AnnouncementListViewModel

@{
    ViewData["Title"] = "Announcements";
    bool canCreate = User.IsInRole(Admin) || User.IsInRole(Teacher);
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="list-page-header">
    <div>
        <div class="page-kicker">Updates</div>
        <h1 class="page-title">Announcements</h1>
        <p class="page-subtitle">
            Important kindergarten updates, group messages and staff notices.
        </p>
    </div>

    <div class="page-actions">
        @if (!string.IsNullOrWhiteSpace(Model.ReturnUrl))
        {
            <a href="@Model.ReturnUrl" class="btn btn-secondary">Back</a>
        }

        @if (canCreate)
        {
            <a asp-action="Create" class="btn btn-primary">Create Announcement</a>
        }
    </div>
</div>

<section id="announcements-list" class="section-panel">
    <div class="section-panel-header">
        <div>
            <h2 class="section-panel-title">Announcement Records</h2>
            <p class="section-panel-subtitle">
                @Model.TotalAnnouncements announcement records found.
            </p>
        </div>

        <div class="records-toolbar">
            <div class="records-page-size">
                <label for="announcementsPageSizeSelect" class="form-label mb-0">Show</label>
                <select id="announcementsPageSizeSelect" class="form-select form-select-sm">
                    <option value="10" selected="@(Model.PageSize == 10)">10</option>
                    <option value="15" selected="@(Model.PageSize == 15)">15</option>
                    <option value="20" selected="@(Model.PageSize == 20)">20</option>
                </select>
            </div>

            @if (Model.TotalPages > 0)
            {
                <div class="text-muted">
                    Page @Model.Page of @Model.TotalPages
                </div>
            }
        </div>
    </div>

    <form id="announcementsFilterForm" asp-action="Index" method="get" class="filter-form mb-3">
        <input type="hidden" name="page" value="1" />
        <input asp-for="PageSize" type="hidden" id="announcementsPageSizeHidden" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />

        <div class="form-grid align-items-end">
            <div class="mb-3 search-suggest-wrapper">
                <label asp-for="SearchTerm" class="form-label">Search</label>
                <input asp-for="SearchTerm"
                       id="announcementsSearchInput"
                       class="form-control"
                       autocomplete="off"
                       placeholder="Search by title, message or group..." />

                <div id="announcementsSearchSuggestions"
                     class="search-suggestions"
                     hidden>
                </div>
            </div>

            <div class="mb-3">
                <button type="submit" class="btn btn-primary">Search</button>
                <a asp-action="Index"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   class="btn btn-secondary">
                    Clear
                </a>
            </div>
        </div>
    </form>

    @if (!Model.Announcements.Any())
    {
        <section class="empty-state compact-empty-state">
            <h2>No announcements found</h2>
            <p>Try changing the search term or create an update.</p>

            @if (canCreate)
            {
                <a asp-action="Create" class="btn btn-primary">Create Announcement</a>
            }
        </section>
    }
    else
    {
        <div class="content-list">
            @foreach (var announcement in Model.Announcements)
            {
                <article class="content-list-item">
                    <div>
                        <div class="item-meta mb-2">
                            <span>@announcement.GroupName</span>
                            <span>@announcement.PublishedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                        </div>

                        <h2 class="item-title">@announcement.Title</h2>
                        <p class="item-preview">@announcement.ContentPreview</p>
                    </div>

                    <div class="item-actions">
                        <a asp-action="Details"
                           asp-route-id="@announcement.Id"
                           asp-route-returnUrl="@currentUrl"
                           class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>

                        @if (announcement.CanManage)
                        {
                            <a asp-action="Edit"
                               asp-route-id="@announcement.Id"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            <form asp-action="Delete"
                                  asp-route-id="@announcement.Id"
                                  method="post">
                                <button type="submit"
                                        class="btn btn-sm btn-outline-danger"
                                        data-confirm-message="Are you sure you want to delete this announcement?">
                                    Delete
                                </button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>

        @if (Model.TotalPages > 1)
        {
            <nav class="attendance-pager" aria-label="Announcements pages">
                <a class="attendance-page-link @(Model.HasPreviousPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-page="@(Model.Page - 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="announcements-list">
                    Previous
                </a>

                <div class="attendance-page-numbers">
                    @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <a class="attendance-page-number @(pageNumber == Model.Page ? "active" : string.Empty)"
                           asp-action="Index"
                           asp-route-searchTerm="@Model.SearchTerm"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           asp-route-page="@pageNumber"
                           asp-route-pageSize="@Model.PageSize"
                           asp-fragment="announcements-list">
                            @pageNumber
                        </a>
                    }
                </div>

                <a class="attendance-page-link @(Model.HasNextPage ? string.Empty : "disabled")"
                   asp-action="Index"
                   asp-route-searchTerm="@Model.SearchTerm"
                   asp-route-returnUrl="@Model.ReturnUrl"
                   asp-route-page="@(Model.Page + 1)"
                   asp-route-pageSize="@Model.PageSize"
                   asp-fragment="announcements-list">
                    Next
                </a>
            </nav>
        }
    }
</section>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('announcementsFilterForm');
            const searchInput = document.getElementById('announcementsSearchInput');
            const pageSizeSelect = document.getElementById('announcementsPageSizeSelect');
            const pageSizeHidden = document.getElementById('announcementsPageSizeHidden');
            const suggestionsBox = document.getElementById('announcementsSearchSuggestions');

            if (!form || !searchInput || !pageSizeSelect || !pageSizeHidden || !suggestionsBox) {
                return;
            }

            let suggestionsTimeout;
            let activeSuggestionIndex = -1;

            const hideSuggestions = () => {
                suggestionsBox.hidden = true;
                suggestionsBox.innerHTML = '';
                activeSuggestionIndex = -1;
            };

            const getSuggestionButtons = () => {
                return Array.from(suggestionsBox.querySelectorAll('button'));
            };

            const setActiveSuggestion = (index) => {
                const buttons = getSuggestionButtons();

                buttons.forEach(button => button.classList.remove('active'));

                if (index >= 0 && index < buttons.length) {
                    buttons[index].classList.add('active');
                    buttons[index].scrollIntoView({ block: 'nearest' });
                }

                activeSuggestionIndex = index;
            };

            const renderSuggestions = (items) => {
                suggestionsBox.innerHTML = '';

                if (!items.length) {
                    hideSuggestions();
                    return;
                }

                items.forEach(item => {
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'search-suggestion-item';
                    button.textContent = item;

                    button.addEventListener('click', () => {
                        searchInput.value = item;
                        hideSuggestions();
                        form.submit();
                    });

                    suggestionsBox.appendChild(button);
                });

                suggestionsBox.hidden = false;
                activeSuggestionIndex = -1;
            };

            searchInput.addEventListener('input', () => {
                clearTimeout(suggestionsTimeout);

                const term = searchInput.value.trim();

                if (term.length < 2) {
                    hideSuggestions();
                    return;
                }

                suggestionsTimeout = setTimeout(async () => {
                    const response = await fetch(`/Announcements/Suggestions?term=${encodeURIComponent(term)}`);

                    if (!response.ok) {
                        hideSuggestions();
                        return;
                    }

                    const items = await response.json();
                    renderSuggestions(items);
                }, 250);
            });

            searchInput.addEventListener('keydown', (event) => {
                const buttons = getSuggestionButtons();

                if (event.key === 'Escape') {
                    hideSuggestions();
                    return;
                }

                if (suggestionsBox.hidden || !buttons.length) {
                    return;
                }

                if (event.key === 'ArrowDown') {
                    event.preventDefault();
                    setActiveSuggestion((activeSuggestionIndex + 1) % buttons.length);
                }

                if (event.key === 'ArrowUp') {
                    event.preventDefault();
                    setActiveSuggestion(activeSuggestionIndex <= 0 ? buttons.length - 1 : activeSuggestionIndex - 1);
                }

                if (event.key === 'Enter' && activeSuggestionIndex >= 0) {
                    event.preventDefault();
                    buttons[activeSuggestionIndex].click();
                }
            });

            pageSizeSelect.addEventListener('change', () => {
                pageSizeHidden.value = pageSizeSelect.value;
                form.submit();
            });

            document.addEventListener('click', (event) => {
                if (!suggestionsBox.contains(event.target) && event.target !== searchInput) {
                    hideSuggestions();
                }
            });
        })();
    </script>
}
