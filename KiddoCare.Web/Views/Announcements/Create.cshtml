@model KiddoCare.ViewModels.Announcements.AnnouncementCreateViewModel

@{
    ViewData["Title"] = T["Create Announcement"];
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Updates"]</div>
        <h1 class="page-title">@T["Create Announcement"]</h1>
        <p class="page-subtitle">
            @T["Share an update with parents, teachers or a specific group."]
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="Title" class="form-label">@T["Title"]</label>
                <input asp-for="Title" class="form-control" placeholder='@T["Example: Tomorrow is a working day"]' />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="GroupId" class="form-label">@T["Group"]</label>
                <select asp-for="GroupId" asp-items="Model.Groups" class="form-select">
                    <option value="">@T["All groups"]</option>
                </select>
                <span asp-validation-for="GroupId" class="text-danger"></span>
            </div>
        </div>

        <div class="mb-3">
            <label asp-for="Content" class="form-label">@T["Message"]</label>
            <textarea asp-for="Content"
                      class="form-control"
                      rows="7"
                      placeholder='@T["Write the announcement message here."]'></textarea>
            <span asp-validation-for="Content" class="text-danger"></span>
        </div>

        <div class="form-check mb-3">
            <input asp-for="IsPublic" class="form-check-input" />
            <label asp-for="IsPublic" class="form-check-label">@T["Visible to parents"]</label>
            <div class="form-text">
                @T["When enabled, parents can see this announcement in their dashboard."]
            </div>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">@T["Create"]</button>
            <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
