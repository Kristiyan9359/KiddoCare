@model KiddoCare.ViewModels.Groups.GroupCreateViewModel

@{
    ViewData["Title"] = T["Create Group"];
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Kindergarten groups"]</div>
        <h1 class="page-title">@T["Create Group"]</h1>
        <p class="page-subtitle">
            @T["Add a new classroom group and use it later for children, teachers, events and announcements."]
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="Name" class="form-label">@T["Group Name"]</label>
                <input asp-for="Name" class="form-control" placeholder='@T["Example: Sunshine"]' />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label">@T["Description"]</label>
                <textarea asp-for="Description"
                          class="form-control"
                          rows="4"
                          placeholder='@T["Optional short note about this group."]'></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">@T["Create"]</button>
            <a asp-action="Index" class="btn btn-secondary">@T["Cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
