@model KiddoCare.ViewModels.Groups.GroupDeleteViewModel

@{
    ViewData["Title"] = "Delete Group";
}

<section class="delete-page">
    <div class="delete-card">
        <div class="delete-kicker">Permanent action</div>
        <h1>Delete Group</h1>
        <p>
            Are you sure you want to delete this group? This action cannot be undone.
        </p>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <dl class="info-list delete-info-list">
            <div>
                <dt>Group Name</dt>
                <dd>@Model.Name</dd>
            </div>
            <div>
                <dt>Active Children</dt>
                <dd>@Model.ChildrenCount</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-action-row justify-content-center">
            <input asp-for="Id" type="hidden" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</section>