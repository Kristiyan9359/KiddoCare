@model KiddoCare.ViewModels.Groups.GroupDetailsViewModel

@{
    ViewData["Title"] = "Group Details";
}

<div class="page-header">
    <div>
        <div class="page-kicker">Kindergarten groups</div>
        <h1 class="page-title">@Model.Name</h1>
        <p class="page-subtitle">
            Review group information and the children currently assigned to this classroom.
        </p>
    </div>

    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a>
        <a asp-action="Index" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Group Summary</h2>
                <p>Basic classroom information.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Group Name</dt>
                <dd>@Model.Name</dd>
            </div>
            <div>
                <dt>Description</dt>
                <dd>
                    @(string.IsNullOrWhiteSpace(Model.Description) ? "No description" : Model.Description)
                </dd>
            </div>
            <div>
                <dt>Children</dt>
                <dd>@Model.Children.Count()</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Children</h2>
                <p>Children currently assigned to this group.</p>
            </div>
        </div>

        @if (!Model.Children.Any())
        {
            <div class="empty-state compact-empty-state">
                <h3>No children in this group</h3>
                <p>Assign children to this group from the child edit page.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Date of Birth</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var child in Model.Children)
                        {
                            <tr>
                                <td><div class="fw-bold">@child.FullName</div></td>
                                <td>@child.DateOfBirth.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-controller="Children"
                                       asp-action="Details"
                                       asp-route-id="@child.Id"
                                       asp-route-returnUrl="@Context.Request.Path"
                                       class="btn btn-sm btn-outline-secondary">
                                        View Child
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>