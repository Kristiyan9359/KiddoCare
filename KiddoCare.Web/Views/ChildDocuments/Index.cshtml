@using KiddoCare.Data.Models.Enums
@using static KiddoCare.Common.RoleConstants
@model IEnumerable<KiddoCare.ViewModels.ChildDocuments.ChildDocumentIndexViewModel>

@{
    ViewData["Title"] = "Child Documents";
    bool canUpload = User.IsInRole(Admin) || User.IsInRole(Parent);
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    string? statusFilter = ViewBag.StatusFilter as string;
}

<div class="list-page-header">
    <div>
        <div class="page-kicker">Documents</div>
        <h1 class="page-title">Child Documents</h1>
        <p class="page-subtitle">
            Upload, review and manage documents connected to children.
        </p>
    </div>

    @if (canUpload)
    {
        <a asp-action="Create"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-primary">
            Upload Document
        </a>
    }
</div>

<div class="filter-bar">
    <div>
        <strong>Filter documents</strong>
        <span>Review pending, approved or declined uploads.</span>
    </div>

    <div class="action-buttons">
        <a asp-action="Index" class="btn btn-sm @(statusFilter == null ? "btn-primary" : "btn-outline-primary")">All</a>
        <a asp-action="Index" asp-route-statusFilter="pending" class="btn btn-sm @(statusFilter == "pending" ? "btn-primary" : "btn-outline-primary")">Pending</a>
        <a asp-action="Index" asp-route-statusFilter="approved" class="btn btn-sm @(statusFilter == "approved" ? "btn-primary" : "btn-outline-primary")">Approved</a>
        <a asp-action="Index" asp-route-statusFilter="rejected" class="btn btn-sm @(statusFilter == "rejected" ? "btn-primary" : "btn-outline-primary")">Declined</a>
    </div>
</div>

@if (!Model.Any())
{
    <section class="empty-state">
        <div class="empty-state-icon">+</div>
        <h2>No documents found</h2>
        <p>Upload a child document such as a declaration, medical file or parent-provided form.</p>

        @if (canUpload)
        {
            <a asp-action="Create"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-primary">
                Upload Document
            </a>
        }
    </section>
}
else
{
    <section class="section-panel">
        <div class="table-responsive">
            <table class="table table-striped align-middle mb-0">
                <thead>
                    <tr>
                        <th>Child</th>
                        <th>Group</th>
                        <th>Type</th>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Uploaded On</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var document in Model)
                    {
                        <tr>
                            <td><div class="fw-bold">@document.ChildFullName</div></td>
                            <td>@document.GroupName</td>
                            <td>@document.Type</td>
                            <td>@document.Title</td>
                            <td>
                                @if (document.Status == RequestStatus.Pending)
                                {
                                    <span class="badge bg-warning text-dark">Pending</span>
                                }
                                else if (document.Status == RequestStatus.Approved)
                                {
                                    <span class="badge bg-success">Approved</span>
                                }
                                else if (document.Status == RequestStatus.Rejected)
                                {
                                    <span class="badge bg-danger">Declined</span>
                                }
                            </td>
                            <td>@document.UploadedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                            <td class="text-end">
                                <div class="action-buttons">
                                    <a asp-action="Details"
                                       asp-route-id="@document.Id"
                                       asp-route-returnUrl="@currentUrl"
                                       class="btn btn-sm btn-outline-secondary">
                                        Details
                                    </a>

                                    @if (document.CanReview)
                                    {
                                        <a asp-action="Review"
                                           asp-route-id="@document.Id"
                                           asp-route-returnUrl="@currentUrl"
                                           class="btn btn-sm btn-outline-primary">
                                            Review
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}