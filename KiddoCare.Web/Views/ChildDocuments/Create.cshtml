@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ChildDocuments.ChildDocumentCreateViewModel

@{
    ViewData["Title"] = T["Upload Child Document"];
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Documents"]</div>
        <h1 class="page-title">@T["Upload Child Document"]</h1>
        <p class="page-subtitle">
            @T["Add a PDF, JPG or PNG document to a child profile."]
        </p>
    </div>
</div>

<section class="section-panel">
    <form asp-action="Create" method="post" enctype="multipart/form-data">
        <input asp-for="ReturnUrl" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-grid">
            <div class="mb-3">
                <label asp-for="ChildId" class="form-label">@T["Child"]</label>
                <select asp-for="ChildId" asp-items="Model.Children" class="form-select">
                    <option value="">@T["Select child..."]</option>
                </select>
                <span asp-validation-for="ChildId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Type" class="form-label">@T["Type"]</label>
                <select asp-for="Type"
                        asp-items="Html.GetLocalizedEnumSelectList<ChildDocumentType>(T)"
                        class="form-select">
                </select>
                <span asp-validation-for="Type" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Title" class="form-label">@T["Title"]</label>
                <input asp-for="Title"
                       class="form-control"
                       placeholder='@T["Example: Medical declaration"]' />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
        </div>

        <div class="file-upload-panel">
            <div>
                <label asp-for="File" class="form-label">@T["File"]</label>
                <p class="form-help">@T["Allowed formats: PDF, JPG and PNG. Maximum size: 5 MB."]</p>
            </div>

            <div class="flex-grow-1">
                <input asp-for="File" type="file" class="form-control" />
                <span asp-validation-for="File" class="text-danger"></span>
            </div>
        </div>

        <div class="form-action-row">
            <button type="submit" class="btn btn-primary">@T["Upload"]</button>
            <a href="@backUrl" class="btn btn-secondary">@T["Cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
