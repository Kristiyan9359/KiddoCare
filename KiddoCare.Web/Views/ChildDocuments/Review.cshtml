@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ChildDocuments.ChildDocumentReviewViewModel

@{
    ViewData["Title"] = "Review Child Document";
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">Documents</div>
        <h1 class="page-title">Review Child Document</h1>
        <p class="page-subtitle">
            Approve or decline a document uploaded for a child.
        </p>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Document Summary</h2>
                <p>Open the file before saving your decision.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Child</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>Title</dt>
                <dd>@Model.Title</dd>
            </div>
            <div>
                <dt>Type</dt>
                <dd>@Model.Type</dd>
            </div>
            <div>
                <dt>File</dt>
                <dd>
                    <a asp-action="Download"
                       asp-route-id="@Model.Id"
                       class="btn btn-sm btn-outline-secondary">
                        Open document
                    </a>
                </dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Review Decision</h2>
                <p>Select the final status for this document.</p>
            </div>
        </div>

        <form asp-action="Review" method="post">
            <input asp-for="Id" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="mb-3">
                <label asp-for="Status" class="form-label"></label>
                <select asp-for="Status" class="form-select">
                    <option value="0">Select decision...</option>
                    <option value="@((int)RequestStatus.Approved)">Approve document</option>
                    <option value="@((int)RequestStatus.Rejected)">Decline document</option>
                </select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ReviewNote" class="form-label"></label>
                <textarea asp-for="ReviewNote"
                          class="form-control"
                          rows="5"
                          placeholder="Optional note about the review decision."></textarea>
                <span asp-validation-for="ReviewNote" class="text-danger"></span>
            </div>

            <div class="form-action-row">
                <button type="submit" class="btn btn-primary">Save Review</button>
                <a href="@backUrl" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </section>
</div>