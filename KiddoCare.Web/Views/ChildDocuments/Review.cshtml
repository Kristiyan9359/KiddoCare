@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ChildDocuments.ChildDocumentReviewViewModel

@{
    ViewData["Title"] = "Review Child Document";
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");

    var statusOptions = Html.GetEnumSelectList<RequestStatus>()
        .Where(s => s.Value != "0");
}

<h1>Review Child Document</h1>

<p>
    <strong>Child:</strong> @Model.ChildFullName
</p>

<p>
    <strong>Title:</strong> @Model.Title
</p>

<p>
    <strong>Type:</strong> @Model.Type
</p>

<p>
    <strong>File:</strong>
    <a asp-action="Download"
       asp-route-id="@Model.Id">
        Open document
    </a>
</p>

<form asp-action="Review" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="ReturnUrl" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status"
                asp-items="statusOptions"
                class="form-select">
            <option value="0">Select status</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ReviewNote" class="form-label"></label>
        <textarea asp-for="ReviewNote" class="form-control" rows="4"></textarea>
        <span asp-validation-for="ReviewNote" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save Review</button>
    <a href="@backUrl" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
