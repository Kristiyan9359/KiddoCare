@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ChildDocuments.ChildDocumentDetailsViewModel

@{
    ViewData["Title"] = "Child Document Details";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Child Document</h1>

    @if (Model.CanReview)
    {
        <a asp-action="Review"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            Review
        </a>
    }
</div>

<dl class="row">
    <dt class="col-sm-3">Child</dt>
    <dd class="col-sm-9">@Model.ChildFullName</dd>

    <dt class="col-sm-3">Group</dt>
    <dd class="col-sm-9">@Model.GroupName</dd>

    <dt class="col-sm-3">Type</dt>
    <dd class="col-sm-9">@Model.Type</dd>

    <dt class="col-sm-3">Title</dt>
    <dd class="col-sm-9">@Model.Title</dd>

    <dt class="col-sm-3">File</dt>
    <dd class="col-sm-9">
        <a href="@Model.FileUrl" target="_blank" rel="noopener noreferrer">
            Open document
        </a>
    </dd>

    <dt class="col-sm-3">Status</dt>
    <dd class="col-sm-9">
        @if (Model.Status == RequestStatus.Pending)
        {
            <span class="badge bg-warning text-dark">Pending</span>
        }
        else if (Model.Status == RequestStatus.Approved)
        {
            <span class="badge bg-success">Approved</span>
        }
        else if (Model.Status == RequestStatus.Rejected)
        {
            <span class="badge bg-danger">Rejected</span>
        }
    </dd>

    <dt class="col-sm-3">Uploaded By</dt>
    <dd class="col-sm-9">@Model.UploadedByEmail</dd>

    <dt class="col-sm-3">Uploaded On</dt>
    <dd class="col-sm-9">@Model.UploadedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>

    <dt class="col-sm-3">Review Note</dt>
    <dd class="col-sm-9" style="white-space: pre-line">
        @(Model.ReviewNote ?? "No review note.")
    </dd>

    <dt class="col-sm-3">Reviewed On</dt>
    <dd class="col-sm-9">
        @(Model.ReviewedOn.HasValue
            ? Model.ReviewedOn.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
            : "Not reviewed yet.")
    </dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back</a>