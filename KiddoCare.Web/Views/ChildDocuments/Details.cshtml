@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ChildDocuments.ChildDocumentDetailsViewModel

@{
    ViewData["Title"] = T["Child Document Details"];
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Documents"]</div>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-subtitle">
            @T["Review document details, upload information and review status."]
        </p>
    </div>

    <div class="page-actions">
        <a asp-action="Download"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            @T["Download"]
        </a>

        @if (Model.CanReview)
        {
            <a asp-action="Review"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-outline-primary">
                @T["Review"]
            </a>
        }

        <a href="@backUrl" class="btn btn-secondary">@T["Back"]</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Document Summary"]</h2>
                <p>@T["{0} document for {1}.", T[Model.Type.ToString()], Model.ChildFullName]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Child"]</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>@T["Group"]</dt>
                <dd>@Model.GroupName</dd>
            </div>
            <div>
                <dt>@T["Type"]</dt>
                <dd>@T[Model.Type.ToString()]</dd>
            </div>
            <div>
                <dt>@T["Status"]</dt>
                <dd>
                    @if (Model.Status == RequestStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">@T["Pending"]</span>
                    }
                    else if (Model.Status == RequestStatus.Approved)
                    {
                        <span class="badge bg-success">@T["Approved"]</span>
                    }
                    else if (Model.Status == RequestStatus.Rejected)
                    {
                        <span class="badge bg-danger">@T["Declined"]</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Upload And Review"]</h2>
                <p>@T["Audit information for this document."]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Uploaded By"]</dt>
                <dd>@Model.UploadedByEmail</dd>
            </div>
            <div>
                <dt>@T["Uploaded On"]</dt>
                <dd>@Model.UploadedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            </div>
            <div>
                <dt>@T["Reviewed On"]</dt>
                <dd>
                    @(Model.ReviewedOn.HasValue
                        ? Model.ReviewedOn.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        : T["Not reviewed yet"].Value)
                </dd>
            </div>
        </dl>
    </section>
</div>

<section class="info-panel mt-3">
    <div class="section-heading-row">
        <div>
            <h2>@T["Review Note"]</h2>
            <p>@T["Optional note from the reviewer."]</p>
        </div>
    </div>

    <p class="mb-0" style="white-space: pre-line">
        @(Model.ReviewNote ?? T["No review note."].Value)
    </p>
</section>
