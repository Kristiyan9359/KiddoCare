@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.ChildDocuments.ChildDocumentDetailsViewModel

@{
    ViewData["Title"] = "Child Document Details";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
    var backUrl = Model.ReturnUrl ?? Url.Action("Index");
}

<div class="page-header">
    <div>
        <div class="page-kicker">Documents</div>
        <h1 class="page-title">@Model.Title</h1>
        <p class="page-subtitle">
            Review document details, upload information and review status.
        </p>
    </div>

    <div class="page-actions">
        <a asp-action="Download"
           asp-route-id="@Model.Id"
           class="btn btn-primary">
            Download
        </a>

        @if (Model.CanReview)
        {
            <a asp-action="Review"
               asp-route-id="@Model.Id"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-outline-primary">
                Review
            </a>
        }

        <a href="@backUrl" class="btn btn-secondary">Back</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Document Summary</h2>
                <p>@Model.Type document for @Model.ChildFullName.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Child</dt>
                <dd>@Model.ChildFullName</dd>
            </div>
            <div>
                <dt>Group</dt>
                <dd>@Model.GroupName</dd>
            </div>
            <div>
                <dt>Type</dt>
                <dd>@Model.Type</dd>
            </div>
            <div>
                <dt>Status</dt>
                <dd>
                    @if (Model.Status == RequestStatus.Pending)
                    {
                        <span class="badge bg-warning text-dark">Pending</span>
                    }
                    else if (Model.Status == RequestStatus.Approved)
                    {
                        <span class="badge bg-success">Approved</span>
                    }
                    else if (Model.Status == RequestStatus.Rejected)
                    {
                        <span class="badge bg-danger">Declined</span>
                    }
                </dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>Upload And Review</h2>
                <p>Audit information for this document.</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>Uploaded By</dt>
                <dd>@Model.UploadedByEmail</dd>
            </div>
            <div>
                <dt>Uploaded On</dt>
                <dd>@Model.UploadedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</dd>
            </div>
            <div>
                <dt>Reviewed On</dt>
                <dd>
                    @(Model.ReviewedOn.HasValue
                        ? Model.ReviewedOn.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")
                        : "Not reviewed yet")
                </dd>
            </div>
        </dl>
    </section>
</div>

<section class="info-panel mt-3">
    <div class="section-heading-row">
        <div>
            <h2>Review Note</h2>
            <p>Optional note from the reviewer.</p>
        </div>
    </div>

    <p class="mb-0" style="white-space: pre-line">
        @(Model.ReviewNote ?? "No review note.")
    </p>
</section>