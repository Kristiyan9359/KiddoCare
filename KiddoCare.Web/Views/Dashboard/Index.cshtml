@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<h1>Dashboard</h1>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <a asp-controller="Groups"
           asp-action="Index"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Groups</div>
                <div class="fs-4">@Model.GroupsCount</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Children"
           asp-action="Index"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Children</div>
                <div class="fs-4">@Model.ChildrenCount</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Attendance"
           asp-action="History"
           asp-route-fromDate="@today"
           asp-route-toDate="@today"
           asp-route-status="Present"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Present Today</div>
                <div class="fs-4">@Model.PresentTodayCount</div>
            </div>
        </a>
    </div>

    <div class="col-md-3">
        <a asp-controller="Attendance"
           asp-action="History"
           asp-route-fromDate="@today"
           asp-route-toDate="@today"
           asp-route-status="Absent"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Absent Today</div>
                <div class="fs-4">@Model.AbsentTodayCount</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-controller="Attendance"
           asp-action="History"
           asp-route-fromDate="@today"
           asp-route-toDate="@today"
           asp-route-status="Sick"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Sick Today</div>
                <div class="fs-4">@Model.SickTodayCount</div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Attendance"
           asp-action="History"
           asp-route-fromDate="@today"
           asp-route-toDate="@today"
           asp-route-status="Late"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Late Today</div>
                <div class="fs-4">@Model.LateTodayCount</div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="Attendance"
           asp-action="History"
           asp-route-fromDate="@today"
           asp-route-toDate="@today"
           asp-route-status="Vacation"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Vacation Today</div>
                <div class="fs-4">@Model.VacationTodayCount</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-controller="AbsenceRequests"
           asp-action="Index"
           asp-route-statusFilter="pending"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Pending Absence Notices</div>
                <div class="fs-4">@Model.PendingAbsenceRequestsCount</div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="ConsentRequests"
           asp-action="Index"
           asp-route-statusFilter="pending"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Pending Consent Requests</div>
                <div class="fs-4">@Model.PendingConsentRequestsCount</div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="ChildDocuments"
           asp-action="Index"
           asp-route-statusFilter="pending"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Pending Documents</div>
                <div class="fs-4">@Model.PendingChildDocumentsCount</div>
            </div>
        </a>
    </div>
</div>

<h2>Recent Announcements</h2>

@if (!Model.RecentAnnouncements.Any())
{
    <p>No announcements yet.</p>
}
else
{
    <table class="table table-striped mb-4">
        <thead>
            <tr>
                <th>Title</th>
                <th>Published On</th>
                <th>Group</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var announcement in Model.RecentAnnouncements)
            {
                <tr>
                    <td>
                        <a asp-controller="Announcements"
                           asp-action="Details"
                           asp-route-id="@announcement.Id"
                           asp-route-returnUrl="@currentUrl">
                            @announcement.Title
                        </a>
                    </td>
                    <td>@announcement.PublishedOn.ToString("dd MMM yyyy")</td>
                    <td>@announcement.GroupName</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Recent Documents</h2>

@if (!Model.RecentDocuments.Any())
{
    <p>No documents uploaded yet.</p>
}
else
{
    <table class="table table-striped mb-4">
        <thead>
            <tr>
                <th>Child</th>
                <th>Group</th>
                <th>Title</th>
                <th>Type</th>
                <th>Status</th>
                <th>Uploaded On</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var document in Model.RecentDocuments)
            {
                <tr>
                    <td>@document.ChildFullName</td>
                    <td>@document.GroupName</td>
                    <td>@document.Title</td>
                    <td>@document.Type</td>
                    <td>
                        @if (document.Status == RequestStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else if (document.Status == RequestStatus.Approved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (document.Status == RequestStatus.Rejected)
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                    </td>
                    <td>@document.UploadedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                    <td class="text-end">
                        <a asp-controller="ChildDocuments"
                           asp-action="Details"
                           asp-route-id="@document.Id"
                           asp-route-returnUrl="@currentUrl"
                           class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Upcoming Events</h2>

@if (!Model.UpcomingEvents.Any())
{
    <p>No upcoming events.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Type</th>
                <th>Location</th>
                <th>Group</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var eventItem in Model.UpcomingEvents)
            {
                <tr>
                    <td>
                        <a asp-controller="Events"
                           asp-action="Details"
                           asp-route-id="@eventItem.Id"
                           asp-route-returnUrl="@currentUrl">
                            @eventItem.Title
                        </a>
                    </td>
                    <td>@eventItem.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@eventItem.Type</td>
                    <td>@eventItem.Location</td>
                    <td>@eventItem.GroupName</td>
                </tr>
            }
        </tbody>
    </table>
}
