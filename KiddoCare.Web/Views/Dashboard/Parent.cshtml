@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.Dashboard.ParentDashboardViewModel

@{
    ViewData["Title"] = "Parent Dashboard";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

@functions {
    private string Stars(int? rating)
    {
        if (!rating.HasValue)
        {
            return T["No rating"].Value;
        }

        return new string('★', rating.Value) + new string('☆', 5 - rating.Value);
    }
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Family overview"]</div>
        <h1 class="page-title">@T["Parent Dashboard"]</h1>
        <p class="page-subtitle">
            @T["Follow your child's day, review requests, documents, notices and upcoming kindergarten events."]
        </p>
    </div>

    <div class="page-actions">
        <a asp-controller="AbsenceRequests"
           asp-action="Create"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-primary">
            @T["Create Absence Notice"]
        </a>

        <a asp-controller="ChildDocuments"
           asp-action="Create"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-outline-primary">
            @T["Upload Document"]
        </a>
    </div>
</div>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">@T["My Children"]</h2>
    </div>

    @if (!Model.Children.Any())
    {
        <p class="empty-state">@T["No children linked to your profile yet."]</p>
    }
    else
    {
        <div class="child-card-grid">
            @foreach (var child in Model.Children)
            {
                <article class="child-card">
                    <div class="child-card-photo">
                        @if (!string.IsNullOrWhiteSpace(child.PhotoUrl))
                        {
                            <img src="@Url.Action("Photo", "Children", new { id = child.Id })"
                                 alt="@child.FullName" />
                        }
                        else
                        {
                            <div class="child-card-placeholder">
                                @child.FullName.Substring(0, 1)
                            </div>
                        }
                    </div>

                    <div class="child-card-body">
                        <div class="child-card-title-row">
                            <h3>@child.FullName</h3>
                            <span class="child-card-group">@child.GroupName</span>
                        </div>

                        <div class="child-card-meta">
                            <span>@T["Date of Birth"]: @child.DateOfBirth.ToString("dd MMM yyyy")</span>
                            <span>@T["Gender"]: @child.Gender</span>
                        </div>

                        @if (child.LastDailyReportDate.HasValue)
                        {
                            <div class="child-card-report">
                                <div class="child-card-report-header">
                                    <div>
                                        <span>@T["Last report"]</span>
                                        <strong>@child.LastDailyReportDate.Value.ToString("dd MMM yyyy")</strong>
                                    </div>
                                    <span class="child-card-mood">@child.LastDailyReportMood</span>
                                </div>

                                <div class="child-card-rating-list">
                                    <div>
                                        <span>@T["Meals"]</span>
                                        <strong class="rating-stars">@Stars(child.LastMealRating)</strong>
                                    </div>
                                    <div>
                                        <span>@T["Sleep"]</span>
                                        <strong class="rating-stars">@Stars(child.LastSleepRating)</strong>
                                    </div>
                                    <div>
                                        <span>@T["Activities"]</span>
                                        <strong class="rating-stars">@Stars(child.LastActivityRating)</strong>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="child-card-report muted">
                                @T["No daily report yet."]
                            </div>
                        }

                        <div class="child-card-actions">
                            <a asp-controller="Children"
                               asp-action="Details"
                               asp-route-id="@child.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                @T["View Child"]
                            </a>

                            <a asp-controller="ActivityFeed"
                               asp-action="Child"
                               asp-route-childId="@child.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-primary">
                                @T["Activity Feed"]
                            </a>

                            @if (child.LastDailyReportId.HasValue)
                            {
                                <a asp-controller="DailyReports"
                                   asp-action="Details"
                                   asp-route-id="@child.LastDailyReportId.Value"
                                   asp-route-returnUrl="@currentUrl"
                                   class="btn btn-sm btn-primary">
                                    @T["View Report"]
                                </a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</section>

<div class="metric-grid metric-grid-three">
    <a asp-controller="ConsentRequests"
       asp-action="Index"
       asp-route-statusFilter="pending"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">@T["Pending Consent Requests"]</div>
        <div class="metric-value">@Model.PendingConsentRequestsCount</div>
        <div class="metric-note">@T["Waiting for your response"]</div>
    </a>

    <a asp-controller="ChildDocuments"
       asp-action="Index"
       asp-route-statusFilter="pending"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">@T["Pending Documents"]</div>
        <div class="metric-value">@Model.PendingChildDocumentsCount</div>
        <div class="metric-note">@T["Uploaded documents under review"]</div>
    </a>

    <a asp-controller="AbsenceRequests"
       asp-action="Index"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">@T["Absence Notices"]</div>
        <div class="metric-value">@Model.RecentAbsenceRequests.Count()</div>
        <div class="metric-note">@T["Recent absence updates"]</div>
    </a>
</div>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">@T["Recent Consent Requests"]</h2>
        <a asp-controller="ConsentRequests"
           asp-action="Index"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-sm btn-outline-secondary">
            @T["View All"]
        </a>
    </div>

    @if (!Model.RecentConsentRequests.Any())
    {
        <p class="empty-state">@T["No consent requests yet."]</p>
    }
    else
    {
        <table class="table table-striped mb-0 mobile-card-table">
            <thead>
                <tr>
                    <th>@T["Child"]</th>
                    <th>@T["Title"]</th>
                    <th>@T["Type"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["Created On"]</th>
                    <th class="text-end">@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.RecentConsentRequests)
                {
                    <tr>
                        <td data-label='@T["Child"]'>@request.ChildFullName</td>
                        <td data-label='@T["Title"]'>@request.Title</td>
                        <td data-label='@T["Type"]'>@request.Type</td>
                        <td data-label='@T["Status"]'>
                            @if (request.Status == RequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">@T["Pending"]</span>
                            }
                            else if (request.Status == RequestStatus.Approved)
                            {
                                <span class="badge bg-success">@T["Approved"]</span>
                            }
                            else if (request.Status == RequestStatus.Rejected)
                            {
                                <span class="badge bg-danger">@T["Declined"]</span>
                            }
                        </td>
                        <td data-label='@T["Created On"]'>@request.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td class="text-end" data-label='@T["Actions"]'>
                            <a asp-controller="ConsentRequests"
                               asp-action="Details"
                               asp-route-id="@request.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                @T["Details"]
                            </a>

                            @if (request.CanRespond)
                            {
                                <a asp-controller="ConsentRequests"
                                   asp-action="Respond"
                                   asp-route-id="@request.Id"
                                   asp-route-returnUrl="@currentUrl"
                                   class="btn btn-sm btn-outline-primary">
                                    @T["Respond"]
                                </a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

