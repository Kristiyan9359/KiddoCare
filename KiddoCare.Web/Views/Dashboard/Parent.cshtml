@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.Dashboard.ParentDashboardViewModel

@{
    ViewData["Title"] = "Parent Dashboard";
}

<h1>Parent Dashboard</h1>

<h2>My Children</h2>

@if (!Model.Children.Any())
{
    <p>No children linked to your profile yet.</p>
}
else
{
    <div class="row g-3 mb-4">
        @foreach (var child in Model.Children)
        {
            <div class="col-md-4">
                <div class="border rounded p-3 h-100">
                    @if (!string.IsNullOrWhiteSpace(child.PhotoUrl))
                    {
                        <img src="@Url.Action("Photo", "Children", new { id = child.Id })"
                             alt="@child.FullName"
                             class="img-fluid rounded mb-3"
                             style="height: 180px; width: 100%; object-fit: cover;" />
                    }

                    <h5>@child.FullName</h5>
                    <p class="mb-1"><strong>Group:</strong> @child.GroupName</p>
                    <p class="mb-1"><strong>Date of Birth:</strong> @child.DateOfBirth.ToString("dd MMM yyyy")</p>
                    <p class="mb-1"><strong>Gender:</strong> @child.Gender</p>

                    @if (child.LastDailyReportDate.HasValue)
                    {
                        <p class="mb-1">
                            <strong>Last report:</strong>
                            @child.LastDailyReportDate.Value.ToString("dd MMM yyyy")
                        </p>

                        <p class="mb-3">
                            <strong>Mood:</strong>
                            @child.LastDailyReportMood
                        </p>
                    }
                    else
                    {
                        <p class="mb-3 text-muted">No daily report yet.</p>
                    }

                    <a asp-controller="Children"
                       asp-action="Details"
                       asp-route-id="@child.Id"
                       class="btn btn-sm btn-outline-secondary">
                        View Child
                    </a>

                    <a asp-controller="ActivityFeed"
                       asp-action="Child"
                       asp-route-childId="@child.Id"
                       class="btn btn-sm btn-outline-primary">
                        Activity Feed
                    </a>
                </div>
            </div>
        }
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <a asp-controller="ConsentRequests"
           asp-action="Index"
           asp-route-statusFilter="pending"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Pending Consent Requests</div>
                <div class="fs-4">@Model.PendingConsentRequestsCount</div>
            </div>
        </a>
    </div>

    <div class="col-md-4">
        <a asp-controller="ChildDocuments"
           asp-action="Index"
           asp-route-statusFilter="pending"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Pending Documents</div>
                <div class="fs-4">@Model.PendingChildDocumentsCount</div>
            </div>
        </a>
    </div>
</div>



<h2>Recent Consent Requests</h2>

@if (!Model.RecentConsentRequests.Any())
{
    <p>No consent requests yet.</p>
}
else
{
    <table class="table table-striped mb-4">
        <thead>
            <tr>
                <th>Child</th>
                <th>Title</th>
                <th>Type</th>
                <th>Status</th>
                <th>Created On</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model.RecentConsentRequests)
            {
                <tr>
                    <td>@request.ChildFullName</td>
                    <td>@request.Title</td>
                    <td>@request.Type</td>
                    <td>
                        @if (request.Status == RequestStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else if (request.Status == RequestStatus.Approved)
                        {
                            <span class="badge bg-success">Approved</span>
                        }
                        else if (request.Status == RequestStatus.Rejected)
                        {
                            <span class="badge bg-danger">Rejected</span>
                        }
                    </td>
                    <td>@request.CreatedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                    <td class="text-end">
                        <a asp-controller="ConsentRequests"
                           asp-action="Details"
                           asp-route-id="@request.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>

                        @if (request.CanRespond)
                        {
                            <a asp-controller="ConsentRequests"
                               asp-action="Respond"
                               asp-route-id="@request.Id"
                               class="btn btn-sm btn-outline-primary">
                                Respond
                            </a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Recent Announcements</h2>

@if (!Model.RecentAnnouncements.Any())
{
    <p>No announcements yet.</p>
}
else
{
    <table class="table table-striped mb-4">
        <thead>
            <tr>
                <th>Title</th>
                <th>Published On</th>
                <th>Group</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var announcement in Model.RecentAnnouncements)
            {
                <tr>
                    <td>
                        <a asp-controller="Announcements"
                           asp-action="Details"
                           asp-route-id="@announcement.Id">
                            @announcement.Title
                        </a>
                    </td>
                    <td>@announcement.PublishedOn.ToString("dd MMM yyyy")</td>
                    <td>@announcement.GroupName</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Recent Absence Notices</h2>

<p>
    <a asp-controller="AbsenceRequests"
       asp-action="Create"
       class="btn btn-sm btn-outline-primary">
        Create Absence Notice
    </a>
</p>

@if (!Model.RecentAbsenceRequests.Any())
{
    <p>No absence notices yet.</p>
}
else
{
    <table class="table table-striped mb-4">
        <thead>
            <tr>
                <th>Child</th>
                <th>Period</th>
                <th>Reason</th>
                <th>Status</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var request in Model.RecentAbsenceRequests)
            {
                <tr>
                    <td>@request.ChildFullName</td>
                    <td>
                        @request.StartDate.ToString("dd MMM yyyy")
                        -
                        @request.EndDate.ToString("dd MMM yyyy")
                    </td>
                    <td>@request.Reason</td>
                    <td>
                        @if (request.Status == RequestStatus.Pending)
                        {
                            <span class="badge bg-warning text-dark">Pending</span>
                        }
                        else if (request.Status == RequestStatus.Approved)
                        {
                            <span class="badge bg-success">Confirmed</span>
                        }
                    </td>
                    <td class="text-end">
                        <a asp-controller="AbsenceRequests"
                           asp-action="Details"
                           asp-route-id="@request.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Upcoming Events</h2>

@if (!Model.UpcomingEvents.Any())
{
    <p>No upcoming events.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Type</th>
                <th>Location</th>
                <th>Group</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var eventItem in Model.UpcomingEvents)
            {
                <tr>
                    <td>
                        <a asp-controller="Events"
                           asp-action="Details"
                           asp-route-id="@eventItem.Id">
                            @eventItem.Title
                        </a>
                    </td>
                    <td>@eventItem.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@eventItem.Type</td>
                    <td>@eventItem.Location</td>
                    <td>@eventItem.GroupName</td>
                </tr>
            }
        </tbody>
    </table>
}
