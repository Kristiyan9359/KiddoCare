        <p class="empty-state">@T["No absence notices yet."]</p>
    }
    else
    {
        <table class="table table-striped mb-0 mobile-card-table">
            <thead>
                <tr>
                    <th>@T["Child"]</th>
                    <th>@T["Period"]</th>
                    <th>@T["Reason"]</th>
                    <th>@T["Status"]</th>
                    <th class="text-end">@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var request in Model.RecentAbsenceRequests)
