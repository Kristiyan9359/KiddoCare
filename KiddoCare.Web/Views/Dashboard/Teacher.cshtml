@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.Dashboard.TeacherDashboardViewModel

@{
    ViewData["Title"] = "Teacher Dashboard";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="page-header">
    <div>
        <div class="page-kicker">Teacher workspace</div>
        <h1 class="page-title">@Model.GroupName</h1>
        <p class="page-subtitle">
            Manage today's attendance, daily reports, child health notes and group updates from one focused workspace.
        </p>
    </div>

    <div class="page-actions">
        <a asp-controller="Attendance"
           asp-action="Daily"
           class="btn btn-primary">
            Manage Attendance
        </a>

        <a asp-controller="DailyReports"
           asp-action="Create"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-outline-primary">
            Create Daily Report
        </a>

        <a asp-controller="Children"
           asp-action="Index"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-outline-secondary">
            View Children
        </a>
    </div>
</div>

<div class="metric-grid">
    <a asp-controller="Children"
       asp-action="Index"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">Children</div>
        <div class="metric-value">@Model.ChildrenCount</div>
        <div class="metric-note">Children in your group</div>
    </a>

    <div class="metric-card">
        <div class="metric-label">Present Today</div>
        <div class="metric-value">@Model.PresentTodayCount</div>
        <div class="metric-note">Checked in for today</div>
    </div>

    <div class="metric-card">
        <div class="metric-label">Absent Today</div>
        <div class="metric-value">@Model.AbsentTodayCount</div>
        <div class="metric-note">Marked absent today</div>
    </div>

    <div class="metric-card">
        <div class="metric-label">Sick Today</div>
        <div class="metric-value">@Model.SickTodayCount</div>
        <div class="metric-note">Health-related absences</div>
    </div>
</div>

<div class="metric-grid metric-grid-three">
    <div class="metric-card">
        <div class="metric-label">Late Today</div>
        <div class="metric-value">@Model.LateTodayCount</div>
        <div class="metric-note">Late arrivals</div>
    </div>

    <div class="metric-card">
        <div class="metric-label">Vacation Today</div>
        <div class="metric-value">@Model.VacationTodayCount</div>
        <div class="metric-note">Vacation notices</div>
    </div>

    <a asp-controller="Children"
       asp-action="Index"
       asp-route-medicalFilter="with-allergies"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">Allergies</div>
        <div class="metric-value">@Model.ChildrenWithAllergiesCount</div>
        <div class="metric-note">Children needing allergy awareness</div>
    </a>
</div>

<div class="metric-grid metric-grid-three">
    <a asp-controller="Children"
       asp-action="Index"
       asp-route-medicalFilter="with-records"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">Medical Records</div>
        <div class="metric-value">@Model.ChildrenWithMedicalRecordsCount</div>
        <div class="metric-note">Children with medical notes</div>
    </a>

    <a asp-controller="AbsenceRequests"
       asp-action="Index"
       asp-route-statusFilter="pending"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">Pending Absence Notices</div>
        <div class="metric-value">@Model.PendingAbsenceRequestsCount</div>
        <div class="metric-note">Waiting for confirmation</div>
    </a>

    <a asp-controller="ConsentRequests"
       asp-action="Index"
       asp-route-statusFilter="pending"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">Pending Consent Requests</div>
        <div class="metric-value">@Model.PendingConsentRequestsCount</div>
        <div class="metric-note">Parent responses needed</div>
    </a>
</div>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">Recent Daily Reports</h2>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="DailyReports"
               asp-action="Create"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-sm btn-primary">
                Create Report
            </a>

            <a asp-controller="DailyReports"
               asp-action="Index"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-sm btn-outline-secondary">
                View All
            </a>
        </div>
    </div>

    @if (!Model.RecentDailyReports.Any())
    {
        <p class="empty-state">No daily reports created yet.</p>
    }
    else
    {
        <table class="table table-striped mb-0 mobile-card-table">
            <thead>
                <tr>
                    <th>Child</th>
                    <th>Date</th>
                    <th>Mood</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model.RecentDailyReports)
                {
                    <tr>
                        <td data-label="Child">@report.ChildFullName</td>
                        <td data-label="Date">@report.ReportDate.ToString("dd MMM yyyy")</td>
                        <td data-label="Mood">@report.Mood</td>
                        <td class="text-end" data-label="Actions">
                            <a asp-controller="DailyReports"
                               asp-action="Details"
                               asp-route-id="@report.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>

                            <a asp-controller="DailyReports"
                               asp-action="Edit"
                               asp-route-id="@report.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">Recent Announcements</h2>
        <a asp-controller="Announcements"
           asp-action="Index"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-sm btn-outline-secondary">
            View All
        </a>
    </div>

    @if (!Model.RecentAnnouncements.Any())
    {
        <p class="empty-state">No announcements yet.</p>
    }
    else
    {
        <table class="table table-striped mb-0 mobile-card-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Published On</th>
                    <th>Group</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var announcement in Model.RecentAnnouncements)
                {
                    <tr>
                        <td data-label="Title">
                            <a asp-controller="Announcements"
                               asp-action="Details"
                               asp-route-id="@announcement.Id"
                               asp-route-returnUrl="@currentUrl">
                                @announcement.Title
                            </a>
                        </td>
                        <td data-label="Published On">@announcement.PublishedOn.ToString("dd MMM yyyy")</td>
                        <td data-label="Group">@announcement.GroupName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">Recent Documents</h2>
        <a asp-controller="ChildDocuments"
           asp-action="Index"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-sm btn-outline-secondary">
            View All
        </a>
    </div>

    @if (!Model.RecentDocuments.Any())
    {
        <p class="empty-state">No documents uploaded yet.</p>
    }
    else
    {
        <table class="table table-striped mb-0 mobile-card-table">
            <thead>
                <tr>
                    <th>Child</th>
                    <th>Title</th>
                    <th>Type</th>
                    <th>Status</th>
                    <th>Uploaded On</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var document in Model.RecentDocuments)
                {
                    <tr>
                        <td data-label="Child">@document.ChildFullName</td>
                        <td data-label="Title">@document.Title</td>
                        <td data-label="Type">@document.Type</td>
                        <td data-label="Status">
                            @if (document.Status == RequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">Pending</span>
                            }
                            else if (document.Status == RequestStatus.Approved)
                            {
                                <span class="badge bg-success">Approved</span>
                            }
                            else if (document.Status == RequestStatus.Rejected)
                            {
                                <span class="badge bg-danger">Declined</span>
                            }
                        </td>
                        <td data-label="Uploaded On">@document.UploadedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td class="text-end" data-label="Actions">
                            <a asp-controller="ChildDocuments"
                               asp-action="Details"
                               asp-route-id="@document.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">Upcoming Events</h2>
        <a asp-controller="Events"
           asp-action="Index"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-sm btn-outline-secondary">
            View All
        </a>
    </div>

    @if (!Model.UpcomingEvents.Any())
    {
        <p class="empty-state">No upcoming events.</p>
    }
    else
    {
        <table class="table table-striped mb-0 mobile-card-table">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Type</th>
                    <th>Location</th>
                    <th>Group</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var eventItem in Model.UpcomingEvents)
                {
                    <tr>
                        <td data-label="Title">
                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@eventItem.Id"
                               asp-route-returnUrl="@currentUrl">
                                @eventItem.Title
                            </a>
                        </td>
                        <td data-label="Date">@eventItem.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td data-label="Type">@eventItem.Type</td>
                        <td data-label="Location">@eventItem.Location</td>
                        <td data-label="Group">@eventItem.GroupName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
