@model KiddoCare.ViewModels.Dashboard.TeacherDashboardViewModel

@{
    ViewData["Title"] = "Teacher Dashboard";
}

<h1>Teacher Dashboard</h1>

<h2>@Model.GroupName</h2>

<div class="mb-4">
    <a asp-controller="Attendance"
       asp-action="Daily"
       class="btn btn-primary me-2">
        Manage Attendance
    </a>

    <a asp-controller="DailyReports"
       asp-action="Create"
       class="btn btn-outline-primary me-2">
        Create Daily Report
    </a>

    <a asp-controller="Children"
       asp-action="Index"
       class="btn btn-outline-secondary">
        View Children
    </a>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="fw-bold">Children</div>
            <div class="fs-4">@Model.ChildrenCount</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="fw-bold">Present Today</div>
            <div class="fs-4">@Model.PresentTodayCount</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="fw-bold">Absent Today</div>
            <div class="fs-4">@Model.AbsentTodayCount</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="border rounded p-3">
            <div class="fw-bold">Sick Today</div>
            <div class="fs-4">@Model.SickTodayCount</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="border rounded p-3">
            <div class="fw-bold">Late Today</div>
            <div class="fs-4">@Model.LateTodayCount</div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="border rounded p-3">
            <div class="fw-bold">Vacation Today</div>
            <div class="fs-4">@Model.VacationTodayCount</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <a asp-controller="Children"
           asp-action="Index"
           asp-route-medicalFilter="with-records"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Children With Medical Records</div>
                <div class="fs-4">@Model.ChildrenWithMedicalRecordsCount</div>
            </div>
        </a>
    </div>

    <div class="col-md-6">
        <a asp-controller="Children"
           asp-action="Index"
           asp-route-medicalFilter="with-allergies"
           class="text-decoration-none text-dark">
            <div class="border rounded p-3 h-100">
                <div class="fw-bold">Children With Allergies</div>
                <div class="fs-4">@Model.ChildrenWithAllergiesCount</div>
            </div>
        </a>
    </div>
</div>

<h2>Recent Announcements</h2>

@if (!Model.RecentAnnouncements.Any())
{
    <p>No announcements yet.</p>
}
else
{
    <table class="table table-striped mb-4">
        <thead>
            <tr>
                <th>Title</th>
                <th>Published On</th>
                <th>Group</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var announcement in Model.RecentAnnouncements)
            {
                <tr>
                    <td>
                        <a asp-controller="Announcements"
                           asp-action="Details"
                           asp-route-id="@announcement.Id">
                            @announcement.Title
                        </a>
                    </td>
                    <td>@announcement.PublishedOn.ToString("dd MMM yyyy")</td>
                    <td>@announcement.GroupName</td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Recent Daily Reports</h2>

@if (!Model.RecentDailyReports.Any())
{
    <p>No daily reports created yet.</p>
}
else
{
    <table class="table table-striped mb-4">
        <thead>
            <tr>
                <th>Child</th>
                <th>Date</th>
                <th>Mood</th>
                <th class="text-end">Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var report in Model.RecentDailyReports)
            {
                <tr>
                    <td>@report.ChildFullName</td>
                    <td>@report.ReportDate.ToString("dd MMM yyyy")</td>
                    <td>@report.Mood</td>
                    <td class="text-end">
                        <a asp-controller="DailyReports"
                           asp-action="Details"
                           asp-route-id="@report.Id"
                           class="btn btn-sm btn-outline-secondary">
                            Details
                        </a>

                        <a asp-controller="DailyReports"
                           asp-action="Edit"
                           asp-route-id="@report.Id"
                           class="btn btn-sm btn-outline-primary">
                            Edit
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<h2>Upcoming Events</h2>

@if (!Model.UpcomingEvents.Any())
{
    <p>No upcoming events.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Title</th>
                <th>Date</th>
                <th>Type</th>
                <th>Location</th>
                <th>Group</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var eventItem in Model.UpcomingEvents)
            {
                <tr>
                    <td>
                        <a asp-controller="Events" asp-action="Details" asp-route-id="@eventItem.Id">
                            @eventItem.Title
                        </a>
                    </td>
                    <td>@eventItem.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                    <td>@eventItem.Type</td>
                    <td>@eventItem.Location</td>
                    <td>@eventItem.GroupName</td>
                </tr>
            }
        </tbody>
    </table>
}