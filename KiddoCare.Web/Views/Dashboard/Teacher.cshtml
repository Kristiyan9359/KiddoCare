@using KiddoCare.Data.Models.Enums
@model KiddoCare.ViewModels.Dashboard.TeacherDashboardViewModel

@{
    ViewData["Title"] = "Teacher Dashboard";
    var currentUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Teacher workspace"]</div>
        <h1 class="page-title">@Model.GroupName</h1>
        <p class="page-subtitle">
            @T["Manage today's attendance, daily reports, child health notes and group updates from one focused workspace."]
        </p>
    </div>

    <div class="page-actions">
        <a asp-controller="Attendance"
           asp-action="Daily"
           class="btn btn-primary">
            @T["Manage Attendance"]
        </a>

        <a asp-controller="DailyReports"
           asp-action="Create"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-outline-primary">
            @T["Create Daily Report"]
        </a>

        <a asp-controller="Children"
           asp-action="Index"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-outline-secondary">
            @T["View Children"]
        </a>
    </div>
</div>

<div class="metric-grid">
    <a asp-controller="Children"
       asp-action="Index"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">@T["Children"]</div>
        <div class="metric-value">@Model.ChildrenCount</div>
        <div class="metric-note">@T["Children in your group"]</div>
    </a>

    <div class="metric-card">
        <div class="metric-label">@T["Present Today"]</div>
        <div class="metric-value">@Model.PresentTodayCount</div>
        <div class="metric-note">@T["Checked in for today"]</div>
    </div>

    <div class="metric-card">
        <div class="metric-label">@T["Absent Today"]</div>
        <div class="metric-value">@Model.AbsentTodayCount</div>
        <div class="metric-note">@T["Marked absent today"]</div>
    </div>

    <div class="metric-card">
        <div class="metric-label">@T["Sick Today"]</div>
        <div class="metric-value">@Model.SickTodayCount</div>
        <div class="metric-note">@T["Health-related absences"]</div>
    </div>
</div>

<div class="metric-grid metric-grid-three">
    <div class="metric-card">
        <div class="metric-label">@T["Late Today"]</div>
        <div class="metric-value">@Model.LateTodayCount</div>
        <div class="metric-note">@T["Late arrivals"]</div>
    </div>

    <div class="metric-card">
        <div class="metric-label">@T["Vacation Today"]</div>
        <div class="metric-value">@Model.VacationTodayCount</div>
        <div class="metric-note">@T["Vacation notices"]</div>
    </div>

    <a asp-controller="Children"
       asp-action="Index"
       asp-route-medicalFilter="with-allergies"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">@T["Allergies"]</div>
        <div class="metric-value">@Model.ChildrenWithAllergiesCount</div>
        <div class="metric-note">@T["Children needing allergy awareness"]</div>
    </a>
</div>

<div class="metric-grid metric-grid-three">
    <a asp-controller="Children"
       asp-action="Index"
       asp-route-medicalFilter="with-records"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">@T["Medical Records"]</div>
        <div class="metric-value">@Model.ChildrenWithMedicalRecordsCount</div>
        <div class="metric-note">@T["Children with medical notes"]</div>
    </a>

    <a asp-controller="AbsenceRequests"
       asp-action="Index"
       asp-route-statusFilter="pending"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">@T["Pending Absence Notices"]</div>
        <div class="metric-value">@Model.PendingAbsenceRequestsCount</div>
        <div class="metric-note">@T["Waiting for confirmation"]</div>
    </a>

    <a asp-controller="ConsentRequests"
       asp-action="Index"
       asp-route-statusFilter="pending"
       asp-route-returnUrl="@currentUrl"
       class="metric-card">
        <div class="metric-label">@T["Pending Consent Requests"]</div>
        <div class="metric-value">@Model.PendingConsentRequestsCount</div>
        <div class="metric-note">@T["Parent responses needed"]</div>
    </a>
</div>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">@T["Recent Daily Reports"]</h2>
        <div class="d-flex gap-2 flex-wrap">
            <a asp-controller="DailyReports"
               asp-action="Create"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-sm btn-primary">
                @T["Create Report"]
            </a>

            <a asp-controller="DailyReports"
               asp-action="Index"
               asp-route-returnUrl="@currentUrl"
               class="btn btn-sm btn-outline-secondary">
                @T["View All"]
            </a>
        </div>
    </div>

    @if (!Model.RecentDailyReports.Any())
    {
        <p class="empty-state">@T["No daily reports created yet."]</p>
    }
    else
    {
        <table class="table table-striped mb-0 mobile-card-table">
            <thead>
                <tr>
                    <th>@T["Child"]</th>
                    <th>@T["Date"]</th>
                    <th>@T["Mood"]</th>
                    <th class="text-end">@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model.RecentDailyReports)
                {
                    <tr>
                        <td data-label='@T["Child"]'>@report.ChildFullName</td>
                        <td data-label='@T["Date"]'>@report.ReportDate.ToString("dd MMM yyyy")</td>
                        <td data-label='@T["Mood"]'>@report.Mood</td>
                        <td class="text-end" data-label='@T["Actions"]'>
                            <a asp-controller="DailyReports"
                               asp-action="Details"
                               asp-route-id="@report.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                @T["Details"]
                            </a>

                            <a asp-controller="DailyReports"
                               asp-action="Edit"
                               asp-route-id="@report.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-primary">
                                @T["Edit"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">@T["Recent Announcements"]</h2>
        <a asp-controller="Announcements"
           asp-action="Index"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-sm btn-outline-secondary">
            @T["View All"]
        </a>
    </div>

    @if (!Model.RecentAnnouncements.Any())
    {
        <p class="empty-state">@T["No announcements yet."]</p>
    }
    else
    {
        <table class="table table-striped mb-0 mobile-card-table">
            <thead>
                <tr>
                    <th>@T["Title"]</th>
                    <th>@T["Published On"]</th>
                    <th>@T["Group"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var announcement in Model.RecentAnnouncements)
                {
                    <tr>
                        <td data-label='@T["Title"]'>
                            <a asp-controller="Announcements"
                               asp-action="Details"
                               asp-route-id="@announcement.Id"
                               asp-route-returnUrl="@currentUrl">
                                @announcement.Title
                            </a>
                        </td>
                        <td data-label='@T["Published On"]'>@announcement.PublishedOn.ToString("dd MMM yyyy")</td>
                        <td data-label='@T["Group"]'>@announcement.GroupName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">@T["Recent Documents"]</h2>
        <a asp-controller="ChildDocuments"
           asp-action="Index"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-sm btn-outline-secondary">
            @T["View All"]
        </a>
    </div>

    @if (!Model.RecentDocuments.Any())
    {
        <p class="empty-state">@T["No documents uploaded yet."]</p>
    }
    else
    {
        <table class="table table-striped mb-0 mobile-card-table">
            <thead>
                <tr>
                    <th>@T["Child"]</th>
                    <th>@T["Title"]</th>
                    <th>@T["Type"]</th>
                    <th>@T["Status"]</th>
                    <th>@T["Uploaded On"]</th>
                    <th class="text-end">@T["Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var document in Model.RecentDocuments)
                {
                    <tr>
                        <td data-label='@T["Child"]'>@document.ChildFullName</td>
                        <td data-label='@T["Title"]'>@document.Title</td>
                        <td data-label='@T["Type"]'>@document.Type</td>
                        <td data-label='@T["Status"]'>
                            @if (document.Status == RequestStatus.Pending)
                            {
                                <span class="badge bg-warning text-dark">@T["Pending"]</span>
                            }
                            else if (document.Status == RequestStatus.Approved)
                            {
                                <span class="badge bg-success">@T["Approved"]</span>
                            }
                            else if (document.Status == RequestStatus.Rejected)
                            {
                                <span class="badge bg-danger">@T["Declined"]</span>
                            }
                        </td>
                        <td data-label='@T["Uploaded On"]'>@document.UploadedOn.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td>
                        <td class="text-end" data-label='@T["Actions"]'>
                            <a asp-controller="ChildDocuments"
                               asp-action="Details"
                               asp-route-id="@document.Id"
                               asp-route-returnUrl="@currentUrl"
                               class="btn btn-sm btn-outline-secondary">
                                @T["Details"]
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<section class="section-panel">
    <div class="section-panel-header">
        <h2 class="section-panel-title">@T["Upcoming Events"]</h2>
        <a asp-controller="Events"
           asp-action="Index"
           asp-route-returnUrl="@currentUrl"
           class="btn btn-sm btn-outline-secondary">
            @T["View All"]
        </a>
    </div>

    @if (!Model.UpcomingEvents.Any())
    {
        <p class="empty-state">@T["No upcoming events."]</p>
    }
    else
    {
        <table class="table table-striped mb-0 mobile-card-table">
            <thead>
                <tr>
                    <th>@T["Title"]</th>
                    <th>@T["Date"]</th>
                    <th>@T["Type"]</th>
                    <th>@T["Location"]</th>
                    <th>@T["Group"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var eventItem in Model.UpcomingEvents)
                {
                    <tr>
                        <td data-label='@T["Title"]'>
                            <a asp-controller="Events"
                               asp-action="Details"
                               asp-route-id="@eventItem.Id"
                               asp-route-returnUrl="@currentUrl">
                                @eventItem.Title
                            </a>
                        </td>
                        <td data-label='@T["Date"]'>@eventItem.StartDateTime.ToString("dd MMM yyyy HH:mm")</td>
                        <td data-label='@T["Type"]'>@eventItem.Type</td>
                        <td data-label='@T["Location"]'>@eventItem.Location</td>
                        <td data-label='@T["Group"]'>@eventItem.GroupName</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
