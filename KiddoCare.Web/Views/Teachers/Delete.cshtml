@model KiddoCare.ViewModels.Teachers.TeacherDeleteViewModel

@{
    ViewData["Title"] = "Delete Teacher";
}

<section class="delete-page">
    <div class="delete-card">
        <div class="delete-kicker">Permanent action</div>
        <h1>Delete Teacher</h1>
        <p>
            Are you sure you want to delete this teacher profile? This action cannot be undone.
        </p>

        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <dl class="info-list delete-info-list">
            <div>
                <dt>Full Name</dt>
                <dd>@Model.FullName</dd>
            </div>
            <div>
                <dt>Email</dt>
                <dd>@Model.Email</dd>
            </div>
            <div>
                <dt>Assigned Group</dt>
                <dd>@Model.GroupName</dd>
            </div>
        </dl>

        <form asp-action="Delete" method="post" class="form-action-row justify-content-center">
            <input asp-for="Id" type="hidden" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</section>