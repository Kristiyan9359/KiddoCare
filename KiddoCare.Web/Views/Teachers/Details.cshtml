@model KiddoCare.ViewModels.Teachers.TeacherDetailsViewModel

@{
    ViewData["Title"] = T["Teacher Details"];
}

<div class="page-header">
    <div>
        <div class="page-kicker">@T["Staff management"]</div>
        <h1 class="page-title">@Model.FullName</h1>
        <p class="page-subtitle">
            @T["Review teacher contact details and classroom assignment."]
        </p>
    </div>

    <div class="page-actions">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">@T["Edit"]</a>
        <a asp-action="Index" class="btn btn-secondary">@T["Back"]</a>
    </div>
</div>

<div class="detail-grid">
    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Contact Summary"]</h2>
                <p>@T["Primary teacher contact information."]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Full Name"]</dt>
                <dd>@Model.FullName</dd>
            </div>
            <div>
                <dt>@T["Email"]</dt>
                <dd>@Model.Email</dd>
            </div>
            <div>
                <dt>@T["Phone"]</dt>
                <dd>@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? T["Not specified"].Value : Model.PhoneNumber)</dd>
            </div>
        </dl>
    </section>

    <section class="info-panel">
        <div class="section-heading-row">
            <div>
                <h2>@T["Classroom Assignment"]</h2>
                <p>@T["The group this teacher can manage."]</p>
            </div>
        </div>

        <dl class="info-list">
            <div>
                <dt>@T["Assigned Group"]</dt>
                <dd>@Model.GroupName</dd>
            </div>
        </dl>
    </section>
</div>
