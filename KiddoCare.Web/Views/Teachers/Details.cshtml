@model KiddoCare.ViewModels.Teachers.TeacherDetailsViewModel

@{
    ViewData["Title"] = "Teacher Details";
}

<h1>@Model.FullName</h1>

<dl class="row">
    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>

    <dt class="col-sm-3">Phone</dt>
    <dd class="col-sm-9">@(string.IsNullOrWhiteSpace(Model.PhoneNumber) ? "Not specified" : Model.PhoneNumber)</dd>

    <dt class="col-sm-3">Group</dt>
    <dd class="col-sm-9">@Model.GroupName</dd>
</dl>

<a asp-action="Index" class="btn btn-secondary">Back</a>