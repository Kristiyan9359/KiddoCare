@page
@model KiddoCare.Web.Areas.Identity.Pages.Account.LoginModel

@{
    ViewData["Title"] = T["Login"];
}

<section class="auth-page">
    <div class="auth-visual" aria-hidden="true">
        <div class="auth-orbit auth-orbit-one"></div>
        <div class="auth-orbit auth-orbit-two"></div>
        <div class="auth-badge">
            <span>KC</span>
        </div>
    </div>

    <div class="auth-card">
        <div class="auth-card-ring"></div>

        <form id="account" method="post" class="auth-form">
            <div class="auth-kicker">@T["Welcome back"]</div>
            <h1>@T["Login"]</h1>
            <p class="auth-subtitle">@T["Sign in to continue to KiddoCare."]</p>

            <div asp-validation-summary="ModelOnly" class="text-danger auth-validation-summary" role="alert"></div>

            <div class="auth-input-group">
                <label asp-for="Input.Email">@T["Email"]</label>
                <span class="auth-input-icon" aria-hidden="true">@@</span>
                <input asp-for="Input.Email"
                       class="auth-input"
                       autocomplete="username"
                       aria-required="true"
                       placeholder='@T["Email"]' />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="auth-input-group">
                <label asp-for="Input.Password">@T["Password"]</label>
                <span class="auth-input-icon" aria-hidden="true">*</span>
                <input asp-for="Input.Password"
                       class="auth-input"
                       id="login-password"
                       autocomplete="current-password"
                       aria-required="true"
                       placeholder='@T["Password"]' />
                <button type="button"
                        class="auth-password-toggle"
                        aria-controls="login-password"
                        aria-label="@T["Show password"]"
                        data-show-label="@T["Show password"]"
                        data-hide-label="@T["Hide password"]">
                    <svg class="auth-password-eye"
                         aria-hidden="true"
                         viewBox="0 0 24 24"
                         fill="none"
                         xmlns="http://www.w3.org/2000/svg">
                        <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                        <path d="M12 15a3 3 0 1 0 0-6 3 3 0 0 0 0 6Z"
                              stroke="currentColor"
                              stroke-width="2"
                              stroke-linecap="round"
                              stroke-linejoin="round" />
                        <path class="auth-password-eye-slash"
                              d="M4 4l16 16"
                              stroke="currentColor"
                              stroke-width="2.2"
                              stroke-linecap="round" />
                    </svg>
                </button>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="auth-options">
                <label class="auth-remember">
                    <input asp-for="Input.RememberMe" />
                    <span class="auth-switch" aria-hidden="true"></span>
                    <span>@T["Remember me"]</span>
                </label>
            </div>

            <button id="login-submit" type="submit" class="auth-submit">
                @T["Sign In"]
            </button>

            <div class="auth-help">
                <a asp-page="./ForgotPassword">@T["Forgot your password?"]</a>
            </div>

            <p class="auth-access-note">
                @T["Accounts are created by the kindergarten administrator."]
            </p>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const passwordInput = document.getElementById("login-password");
            const toggleButton = document.querySelector(".auth-password-toggle");

            if (!passwordInput || !toggleButton) {
                return;
            }

            toggleButton.addEventListener("click", () => {
                const shouldShowPassword = passwordInput.type === "password";

                passwordInput.type = shouldShowPassword ? "text" : "password";
                toggleButton.classList.toggle("is-visible", shouldShowPassword);
                toggleButton.setAttribute(
                    "aria-label",
                    shouldShowPassword ? toggleButton.dataset.hideLabel : toggleButton.dataset.showLabel);
            });
        })();
    </script>
}
